@model WebMobileAssignment.Models.Student

@{
    ViewBag.Title = "My Class Schedule";
    ViewBag.ActiveMenu = "Classes";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var daysOfWeek = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

    // Build schedule groups by Day (preserve classes without Day as "TBA" - but we will not render TBA)
    var enrollments = Model?.Enrollments ?? Enumerable.Empty<WebMobileAssignment.Models.Enrollment>();
    var classes = enrollments
        .Where(e => e.Class != null)
        .Select(e => e.Class!)
        .ToList();

    var byDay = classes
        .Where(c => !string.IsNullOrWhiteSpace(c.Day))
        .GroupBy(c => c.Day!.Trim(), StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.OrderBy(c => c.StartTime ?? TimeSpan.Zero).ToList(), StringComparer.OrdinalIgnoreCase);

    Func<TimeSpan?, string> fmt = ts =>
    {
        if (!ts.HasValue) return "—";
        return DateTime.Today.Add(ts.Value).ToString("hh:mm tt");
    };
}

<div class="row">
    <div class="col-12 mb-4">
        <h3>Class Schedule</h3>
        <p class="text-muted">Weekly view of your enrolled classes.</p>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                @* Combined container for all weekdays *@
                @foreach (var day in daysOfWeek)
                {
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <h6 class="mb-0 me-2">@day</h6>
                            <small class="text-muted">@(byDay.TryGetValue(day, out var _list) && _list.Any() ? $"{_list.Count} class(es)" : "No classes")</small>
                        </div>

                        <div>
                            @{
                                if (byDay.TryGetValue(day, out var list) && list.Any())
                                {
                                    <div class="row g-2">
                                        @foreach (var cls in list)
                                        {
                                            <div class="col-12">
                                                <div class="p-2 border rounded">
                                                    <div class="fw-bold">@cls.ClassName</div>
                                                    <div class="small text-muted">
                                                        @if (cls.Subject != null) { @cls.Subject.SubjectName } else { <text>Subject: —</text> }
                                                    </div>
                                                    <div class="small text-muted">
                                                        <i class="bi bi-clock-history"></i>
                                                        @fmt(cls.StartTime) - @fmt(cls.EndTime)
                                                        @if (!string.IsNullOrWhiteSpace(cls.RoomNumber))
                                                        {
                                                            <span class="ms-2"><i class="bi bi-geo-alt"></i> @cls.RoomNumber</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small">No classes for @day.</div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
