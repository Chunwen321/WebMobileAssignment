@model WebMobileAssignment.Models.Student
@{
    ViewBag.Title = "Take Attendance";
    ViewBag.ActiveMenu = "Attendance";
    ViewBag.ActiveSubmenu = "Take";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<style>
    .attendance-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 40px;
        color: white;
        text-align: center;
        box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
        margin-bottom: 30px;
    }

    .attendance-icon {
        font-size: 5rem;
        margin-bottom: 20px;
        opacity: 0.9;
    }

    .pin-input-section {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .pin-input-container {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin: 30px 0;
    }

    .pin-digit {
        width: 60px;
        height: 70px;
        font-size: 2rem;
        text-align: center;
        border: 3px solid #e0e0e0;
        border-radius: 12px;
        font-weight: 700;
        color: #333;
        transition: all 0.3s;
        background: #f8f9fa;
    }

    .pin-digit:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
        background: white;
    }

    .submit-btn {
        padding: 15px 50px;
        font-size: 1.2rem;
        font-weight: 600;
        border-radius: 12px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        transition: all 0.3s;
    }

    .submit-btn:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
    }

    .submit-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .enrolled-classes-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
    }

    .class-item {
        padding: 15px;
        border-left: 4px solid #667eea;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .success-animation {
        display: none;
        text-align: center;
        padding: 50px;
    }

    .success-icon {
        font-size: 6rem;
        color: #28a745;
        animation: successPop 0.6s ease-out;
    }

    @@keyframes successPop {
        0% { transform: scale(0); opacity: 0; }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); opacity: 1; }
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-10px); }
        75% { transform: translateX(10px); }
    }

    .shake {
        animation: shake 0.5s;
    }

    .student-info-badge {
        display: inline-block;
        background: rgba(255,255,255,0.2);
        padding: 10px 20px;
        border-radius: 50px;
        margin: 10px 5px;
        font-size: 0.95rem;
    }

    .today-schedule {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .schedule-item {
        background: rgba(255,255,255,0.2);
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 10px;
    }
</style>

<div class="row">
    <div class="col-lg-8">
        <!-- Welcome Card -->
        <div class="attendance-card">
            <div class="attendance-icon">
                <i class="bi bi-clipboard2-check-fill"></i>
            </div>
            <h1 class="mb-3">Take Attendance</h1>
            <p class="mb-3" style="font-size: 1.1rem; opacity: 0.95;">
                Welcome, <strong>@ViewBag.StudentName</strong>!
            </p>
            <div class="student-info-badge">
                <i class="bi bi-person-badge me-2"></i>@ViewBag.StudentId
            </div>
            <div class="student-info-badge">
                <i class="bi bi-calendar-check me-2"></i>@DateTime.Now.ToString("MMMM dd, yyyy")
            </div>
        </div>

        <!-- PIN Entry Section -->
        <div class="pin-input-section" id="pinSection">
            <div class="text-center mb-4">
                <h3 class="mb-2">
                    <i class="bi bi-key-fill text-primary me-2"></i>Enter Class PIN
                </h3>
                <p class="text-muted">Ask your teacher for the 6-digit PIN code</p>
            </div>

            <form id="attendanceForm">
                <div class="pin-input-container">
                    <input type="text" class="pin-digit" maxlength="1" id="pin1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                    <input type="text" class="pin-digit" maxlength="1" id="pin2" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                    <input type="text" class="pin-digit" maxlength="1" id="pin3" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                    <input type="text" class="pin-digit" maxlength="1" id="pin4" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                    <input type="text" class="pin-digit" maxlength="1" id="pin5" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                    <input type="text" class="pin-digit" maxlength="1" id="pin6" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                </div>

                <p class="text-center text-muted mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Attendance can only be taken during class hours
                </p>

                <div class="text-center">
                    <button type="submit" class="submit-btn" id="submitBtn">
                        <i class="bi bi-check-circle-fill me-2"></i>Submit Attendance
                    </button>
                </div>

                <div id="errorAlert" class="alert alert-danger mt-4 d-none">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span id="errorMessage"></span>
                </div>
            </form>
        </div>

        <!-- Success Section (Hidden initially) -->
        <div class="success-animation pin-input-section" id="successSection">
            <div class="success-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h2 class="text-success mb-3">Attendance Marked Successfully!</h2>
            <div class="alert alert-success">
                <strong id="successClassName"></strong><br>
                Marked at <strong id="successTime"></strong> on <strong id="successDate"></strong>
            </div>
            <button class="btn btn-primary mt-4" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise me-2"></i>Mark Another Class
            </button>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Today's Schedule -->
        @if (Model.Enrollments != null && Model.Enrollments.Any())
        {
            <div class="today-schedule">
                <h5 class="mb-3">
                    <i class="bi bi-calendar-week me-2"></i>Your Classes
                </h5>
                @foreach (var enrollment in Model.Enrollments)
                {
                    <div class="schedule-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@enrollment.Class.ClassName</strong>
                                @if (enrollment.Class.StartTime.HasValue && enrollment.Class.EndTime.HasValue)
                                {
                                    <div class="small">
                                        <i class="bi bi-clock me-1"></i>
                                        @enrollment.Class.StartTime.Value.ToString(@"hh\:mm") - @enrollment.Class.EndTime.Value.ToString(@"hh\:mm")
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(enrollment.Class.Day))
                                {
                                    <div class="small">
                                        <i class="bi bi-calendar3 me-1"></i>@enrollment.Class.Day
                                    </div>
                                }
                            </div>
                            @if (enrollment.Class.Day == DateTime.Now.DayOfWeek.ToString())
                            {
                                <span class="badge bg-light text-dark">
                                    <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.5rem;"></i>Today
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Quick Stats -->
        <div class="enrolled-classes-card mt-4">
            <h5 class="mb-3">
                <i class="bi bi-graph-up text-primary me-2"></i>Quick Stats
            </h5>
            <div class="row g-3">
                <div class="col-6">
                    <div class="text-center p-3" style="background: rgba(25,135,84,0.1); border-radius: 10px;">
                        <h4 class="text-success mb-0">@(Model.Enrollments?.Count ?? 0)</h4>
                        <small class="text-muted">Classes Enrolled</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="text-center p-3" style="background: rgba(13,110,253,0.1); border-radius: 10px;">
                        <h4 class="text-primary mb-0">0</h4>
                        <small class="text-muted">Today's Attendance</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Instructions -->
        <div class="enrolled-classes-card mt-4">
            <h5 class="mb-3">
                <i class="bi bi-lightbulb text-warning me-2"></i>How to Mark Attendance
            </h5>
            <ol class="ps-3 mb-0">
                <li class="mb-2">Get the 6-digit PIN from your teacher</li>
                <li class="mb-2">Enter the PIN in the boxes above</li>
                <li class="mb-2">Make sure you're in the class period</li>
                <li class="mb-0">Click "Submit Attendance"</li>
            </ol>
            <div class="alert alert-info mt-3 mb-0">
                <small>
                    <i class="bi bi-info-circle me-1"></i>
                    Attendance can only be marked during scheduled class hours
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        console.log('StudTakeAttendance script loaded');

        $(document).ready(function() {
            console.log('Document ready');
            
            // Check if PIN is provided in URL (from QR code scan)
            const urlParams = new URLSearchParams(window.location.search);
            const prefilledPin = urlParams.get('pin');
            
            if (prefilledPin && prefilledPin.length === 6) {
                // Auto-fill PIN from QR code
                console.log('Auto-filling PIN from QR code:', prefilledPin);
                for (let i = 0; i < 6; i++) {
                    $(`#pin${i + 1}`).val(prefilledPin[i]);
                }
                
                // Show success message
                const qrScannedBadge = $('<div class="alert alert-success text-center mb-3">' +
                    '<i class="bi bi-qr-code-scan me-2"></i>' +
                    '<strong>QR Code Scanned!</strong> PIN auto-filled. Click Submit to mark attendance.' +
                    '</div>');
                qrScannedBadge.insertBefore('#attendanceForm');
                
                // Focus on submit button
                $('#submitBtn').focus();
            } else {
                // Focus on first PIN digit if no QR code
                $('#pin1').focus();
            }

            // PIN digit navigation
            $('.pin-digit').on('input', function() {
                const value = $(this).val();
                
                // Only allow numbers
                if (!/^[0-9]$/.test(value)) {
                    $(this).val('');
                    return;
                }

                // Move to next input
                const currentIndex = $('.pin-digit').index(this);
                if (value && currentIndex < 5) {
                    $('.pin-digit').eq(currentIndex + 1).focus();
                }
            });

            // Backspace navigation
            $('.pin-digit').on('keydown', function(e) {
                if (e.key === 'Backspace' && !$(this).val()) {
                    const currentIndex = $('.pin-digit').index(this);
                    if (currentIndex > 0) {
                        $('.pin-digit').eq(currentIndex - 1).focus();
                    }
                }
            });

            // Paste support
            $('.pin-digit').first().on('paste', function(e) {
                e.preventDefault();
                const pastedText = (e.originalEvent.clipboardData || window.clipboardData).getData('text');
                const digits = pastedText.replace(/\D/g, '').substring(0, 6);
                
                for (let i = 0; i < digits.length; i++) {
                    $(`#pin${i + 1}`).val(digits[i]);
                }
                
                if (digits.length === 6) {
                    $('#pin6').focus();
                }
            });

            // Form submission
            $('#attendanceForm').on('submit', function(e) {
                e.preventDefault();
                console.log('Form submitted');

                // Get PIN
                let pinCode = '';
                for (let i = 1; i <= 6; i++) {
                    pinCode += $(`#pin${i}`).val();
                }

                console.log('PIN Code:', pinCode);

                // Validate
                if (pinCode.length !== 6) {
                    showError('Please enter all 6 digits of the PIN code');
                    return;
                }

                // Get anti-forgery token
                const token = $('input[name="__RequestVerificationToken"]').val();

                // Disable button and show loading
                $('#submitBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Submitting...');
                $('#errorAlert').addClass('d-none');

                console.log('Sending AJAX request...');

                // Submit with proper headers
                $.ajax({
                    url: '/Student/SubmitStudentAttendance',
                    type: 'POST',
                    data: {
                        pinCode: pinCode,
                        __RequestVerificationToken: token
                    },
                    success: function(response) {
                        console.log('Success response:', response);
                        if (response.success) {
                            showSuccess(response);
                        } else {
                            showError(response.message);
                            resetForm();
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('AJAX error:', status, error);
                        console.error('Response:', xhr.responseText);
                        
                        let errorMsg = 'Network error. Please try again.';
                        
                        try {
                            const response = JSON.parse(xhr.responseText);
                            if (response && response.message) {
                                errorMsg = response.message;
                            }
                        } catch (e) {
                            // If not JSON, use status text
                            if (xhr.status === 404) {
                                errorMsg = 'Endpoint not found. Please contact administrator.';
                            } else if (xhr.status === 401) {
                                errorMsg = 'Please login again.';
                            }
                        }
                        
                        showError(errorMsg);
                        resetForm();
                    }
                });
            });

            function resetForm() {
                $('#submitBtn').prop('disabled', false).html('<i class="bi bi-check-circle-fill me-2"></i>Submit Attendance');
                // Clear PIN on error
                $('.pin-digit').val('');
                $('#pin1').focus();
            }
        });

        function showError(message) {
            console.log('Showing error:', message);
            $('#errorMessage').text(message);
            $('#errorAlert').removeClass('d-none');
            
            // Shake animation
            $('#errorAlert').addClass('shake');
            setTimeout(() => $('#errorAlert').removeClass('shake'), 500);
        }

        function showSuccess(data) {
            console.log('Showing success:', data);
            $('#successClassName').text(data.className);
            $('#successTime').text(data.time);
            $('#successDate').text(data.date);
            
            $('#pinSection').fadeOut(300, function() {
                $('#successSection').fadeIn(300).css('display', 'block');
            });
        }
    </script>
}
