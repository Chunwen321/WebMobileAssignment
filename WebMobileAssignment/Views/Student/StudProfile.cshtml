@model WebMobileAssignment.Models.Student

@{
    // Use Model when available, otherwise use demo data
    var student = Model;

    // view helpers
    ViewBag.Title = "Student Profile";
    ViewBag.ActiveMenu = "StudProfile";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var user = student?.User;
    var enroll = student?.Enrollments?.FirstOrDefault();
    var attendances = student?.Attendances ?? Enumerable.Empty<WebMobileAssignment.Models.Attendance>();
    var presentCount = attendances.Count(a => string.Equals(a.Status, "Present", StringComparison.OrdinalIgnoreCase));
    var absentCount = attendances.Count(a => string.Equals(a.Status, "Absent", StringComparison.OrdinalIgnoreCase));
    var leaveCount = attendances.Count(a => string.Equals(a.Status, "Leave", StringComparison.OrdinalIgnoreCase) || string.Equals(a.Status, "Medical", StringComparison.OrdinalIgnoreCase));
    var totalAttendance = presentCount + absentCount + leaveCount;
    var attendanceRate = totalAttendance > 0 ? Math.Round((presentCount / (double)totalAttendance) * 100) : 0;
    var recent = attendances.OrderByDescending(a => a.Date).Take(5).ToList();

    // Build a safe subject entry list from enrollments including a CSS class derived from class start time
    var subjectEntries = new List<(string SubjectName, string ClassName, string TeacherName, string CssClass)>();
    if (student?.Enrollments != null)
    {
        foreach (var e in student.Enrollments)
        {
            var cls = e.Class;
            if (cls?.Subject == null) continue;

            // determine time-of-day class for color (morning/afternoon/evening)
            string css = "morning"; // default
            if (cls.StartTime.HasValue)
            {
                var h = cls.StartTime.Value.Hours;
                css = h < 12 ? "morning" : (h < 17 ? "afternoon" : "evening");
            }

            subjectEntries.Add((
                SubjectName: cls.Subject?.SubjectName ?? "",
                ClassName: cls.ClassName ?? "",
                TeacherName: cls.Teacher?.User?.FullName ?? "",
                CssClass: css
            ));
        }

        // remove duplicates by Subject+Class+Teacher
        subjectEntries = subjectEntries
            .GroupBy(x => (x.SubjectName, x.ClassName, x.TeacherName))
            .Select(g => g.First())
            .ToList();
    }
}

<div class="row g-3">
    <!-- Left column: Profile Card (original size) -->
    <div class="col-lg-4">
        <div class="dashboard-card">
            <div class="text-center mb-3">
                <div>
                    <label for="profilePhotoInput" class="mx-auto d-block mb-3" style="width:120px; height:120px; cursor:pointer;">
                        @if (!string.IsNullOrEmpty(user?.ProfilePicture) && !user.ProfilePicture.StartsWith("/images/"))
                        {
                            <img id="profilePhoto" src="@user.ProfilePicture" alt="avatar" class="profile-img mx-auto d-block" style="width:120px; height:120px; object-fit:cover; border-radius: 50%;" />
                        }
                        else
                        {
                            <img id="profilePhoto" src="/images/default-avatar.png" alt="avatar" class="profile-img mx-auto d-block" style="width:120px; height:120px; object-fit:cover;" />
                        }
                    </label>
                </div>

                <h4 class="mb-1">@((user?.FullName) ?? "N/A")</h4>
                <p class="text-muted mb-1">Student ID: <strong>@(student?.StudentId ?? "N/A")</strong></p>
                <span class="badge bg-success">@((user != null && user.IsActive == true) ? "Active" : "Inactive")</span>
            </div>

            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-calendar3 me-2"></i>Date of Birth</span>
                    <strong>@(user?.DateOfBirth?.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</strong>
                </div>

                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-gender-ambiguous me-2"></i>Gender</span>
                    <strong>@(student?.Gender ?? "—")</strong>
                </div>

                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-phone me-2"></i>Phone</span>
                    <strong>@(user?.PhoneNumber ?? "—")</strong>
                </div>

                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-envelope me-2"></i>Email</span>
                    <strong>@(user?.Email ?? "—")</strong>
                </div>

                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-calendar-check me-2"></i>Enrolled</span>
                    <strong>@(student?.EnrollmentDate?.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</strong>
                </div>
            </div>

            <div class="d-grid gap-2 mt-3">
                <a asp-controller="Student" asp-action="StudSettings" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-fill me-2"></i>Edit Profile
                </a>
                <a asp-controller="Student" asp-action="StudApplyMedicalLeave" class="btn btn-outline-primary">
                    <i class="bi bi-journal-medical me-2"></i>Apply Medical Leave
                </a>
            </div>
        </div>
    </div>

    <!-- Right column: Subjects the student is taking -->
    <div class="col-lg-8">
        <div class="dashboard-card">
            <div class="card-header-custom d-flex justify-content-between align-items-center">
                <h5 class="card-title"><i class="bi bi-book"></i> Subjects</h5>
                <small class="text-muted">Enrolled subjects</small>
            </div>

            <div class="p-3">
                @if (subjectEntries.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 subjects-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="col-subject">Subject</th>
                                    <th class="col-class">Class</th>
                                    <th class="col-teacher">Teacher</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in subjectEntries)
                                {
                                    <tr class="@s.CssClass">
                                        <td class="subject-cell">@(string.IsNullOrEmpty(s.SubjectName) ? "—" : s.SubjectName)</td>
                                        <td class="class-cell">@(string.IsNullOrEmpty(s.ClassName) ? "—" : s.ClassName)</td>
                                        <td class="teacher-cell">@(string.IsNullOrEmpty(s.TeacherName) ? "—" : s.TeacherName)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted">No subjects found</div>
                }
            </div>
        </div>
    </div>
</div>
</div>
</div>
</div>

<style>
    /* Column background colors mapped to timetable legend colors */
    .table thead th.col-subject,
    .table tbody td.subject-cell {
        background: linear-gradient(135deg,#667eea 0%,#764ba2 100%);
        color: white;
    }

    /* Class column -> Afternoon (pink gradient) */
    .table thead th.col-class,
    .table tbody td.class-cell {
        background: linear-gradient(135deg,#f093fb 0%,#f5576c 100%);
        color: white;
    }

    /* Teacher column -> Evening (cyan gradient) */
    .table thead th.col-teacher,
    .table tbody td.teacher-cell {
        background: linear-gradient(135deg,#4facfe 0%,#00f2fe 100%);
        color: white;
    }

    /* Slight padding for cells to look nicer */
    .table td.subject-cell,
    .table td.class-cell,
    .table td.teacher-cell {
        padding: 12px 16px;
        overflow: hidden;
    }
    
    /* Make header text slightly bolder for contrast */
    .table thead th.col-subject,
    .table thead th.col-class,
    .table thead th.col-teacher {
        font-weight: 600;
    }
</style>
</div>