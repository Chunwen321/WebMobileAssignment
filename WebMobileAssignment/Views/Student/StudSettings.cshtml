}

html[data-theme="dark"] .alert-info strong {
    color: #ffffff !important;
}

body[data-theme="dark"] .alert-info strong {
    color: #ffffff !important;
}

/* Profile Picture Tips Box Styling */
.profile-tips-box {
    background: linear-gradient(to bottom, #2c3e50 0%, #34495e 50%, #2c5282 100%);
    border-radius: 8px;
    padding: 1.5rem;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.profile-tips-box .tips-heading {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #ffffff;
    display: flex;
    align-items: center;
}

.profile-tips-box .tips-list {
    font-size: 0.875rem;
    padding-left: 1.25rem;
    margin-bottom: 0;
    list-style-type: disc;
}

.profile-tips-box .tips-list li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
    color: #e8f0f7;
}

.profile-tips-box .tips-list li:last-child {
    margin-bottom: 0;
}

/* Light mode strong tags in profile tips */
body:not([data-theme="dark"]) .profile-tips-box strong,
.profile-tips-box strong {
    font-weight: 700;
    color: #ffd700 !important;
}

/* Dark mode strong tags in profile tips */
[data-theme="dark"] .profile-tips-box strong {
    font-weight: 700;
    color: #ffd700 !important;
}

