<style>
    .theme-option {
        cursor: pointer;
        text-align: center;
        padding: 10px;
        border-radius: 12px;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }
    
    .theme-option:hover {
        background: rgba(13, 110, 253, 0.05);
    }
    
    .theme-option.active {
        border-color: #0d6efd;
        background: rgba(13, 110, 253, 0.1);
    }
    
    .theme-preview {
        width: 100px;
        height: 70px;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        margin-bottom: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .light-preview {
        background: #f8f9fa;
    }
    
    .light-preview .preview-sidebar {
        width: 25%;
        background: linear-gradient(180deg, #02a145 0%, #028a3a 100%);
    }
    
    .light-preview .preview-content {
        flex: 1;
        padding: 5px;
    }
    
    .light-preview .preview-header {
        height: 12px;
        background: #ffffff;
        border-radius: 2px;
        margin-bottom: 5px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    
    .light-preview .preview-body {
        height: calc(100% - 17px);
        background: #ffffff;
        border-radius: 2px;
    }
    
    .dark-preview {
        background: #1a1a1a;
    }
    
    .dark-preview .preview-sidebar {
        width: 25%;
        background: linear-gradient(180deg, #02a145 0%, #028a3a 100%);
    }
    
    .dark-preview .preview-content {
        flex: 1;
        padding: 5px;
    }
    
    .dark-preview .preview-header {
        height: 12px;
        background: #2d2d2d;
        border-radius: 2px;
        margin-bottom: 5px;
    }
    
    .dark-preview .preview-body {
        height: calc(100% - 17px);
        background: #2d2d2d;
        border-radius: 2px;
    }
    
    .theme-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-primary);
    }
    
    [data-theme="dark"] .theme-option:hover {
        background: rgba(13, 110, 253, 0.15);
    }
    
    [data-theme="dark"] .theme-option.active {
        background: rgba(13, 110, 253, 0.2);
    }
</style>

@section Scripts {
    <script>
        // Initialize theme selection on page load
        document.addEventListener('DOMContentLoaded', function() {
            const currentTheme = localStorage.getItem('theme') || 'light';
            updateThemeSelection(currentTheme);
        });
        
        function selectTheme(theme) {
            // Update the theme using the global function from student.js
            setTheme(theme);
            
            // Update the UI selection
            updateThemeSelection(theme);
        }
        
        function updateThemeSelection(theme) {
            const lightOption = document.getElementById('lightThemeOption');
            const darkOption = document.getElementById('darkThemeOption');
            
            if (lightOption && darkOption) {
                lightOption.classList.remove('active');
                darkOption.classList.remove('active');
                
                if (theme === 'dark') {
                    darkOption.classList.add('active');
                } else {
                    lightOption.classList.add('active');
                }
            }
        }
        
        // Profile Picture Preview
        (function() {
            const fileInput = document.getElementById('profilePictureFile');
            const preview = document.getElementById('profilePicturePreview');

            if (fileInput) {
                fileInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (!file) return;

                    // Validate file type
                    const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                    if (!validTypes.includes(file.type)) {
                        alert('Invalid file type. Please upload JPG, PNG, GIF, or WEBP image.');
                        fileInput.value = '';
                        return;
                    }

                    // Validate file size (5 MB)
                    if (file.size > 5 * 1024 * 1024) {
                        alert('File size must not exceed 5 MB.');
                        fileInput.value = '';
                        return;
                    }

                    // Show preview
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        // Replace icon/image with new preview
                        preview.outerHTML = `<img id="profilePicturePreview" 
                                                  src="${e.target.result}" 
                                                  alt="Profile Picture" 
                                                  class="img-thumbnail rounded-circle mb-3" 
                                                  style="width: 150px; height: 150px; object-fit: cover;">`;
                    };
                    reader.readAsDataURL(file);
                });
            }
        })();
    </script>
}
