@model WebMobileAssignment.Models.Student

@{
    ViewBag.Title = "Change Profile Settings";
    ViewBag.ActiveSubmenu = "Settings";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="row g-3">
    <!-- Theme Settings -->
    <div class="col-lg-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h5 class="card-title">
                    <i class="bi bi-palette-fill"></i>
                    Theme Settings
                </h5>
            </div>
            <div class="row align-items-center">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Appearance</label>
                    <p class="text-muted small mb-0">Choose your preferred theme for the portal</p>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3 justify-content-md-end">
                        <div class="theme-option" id="lightThemeOption" onclick="selectTheme('light')">
                            <div class="theme-preview light-preview">
                                <div class="preview-sidebar"></div>
                                <div class="preview-content">
                                    <div class="preview-header"></div>
                                    <div class="preview-body"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <i class="bi bi-sun-fill me-1"></i>Light
                            </div>
                        </div>
                        <div class="theme-option" id="darkThemeOption" onclick="selectTheme('dark')">
                            <div class="theme-preview dark-preview">
                                <div class="preview-sidebar"></div>
                                <div class="preview-content">
                                    <div class="preview-header"></div>
                                    <div class="preview-body"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <i class="bi bi-moon-fill me-1"></i>Dark
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Account Settings -->
<div class="col-lg-12">
  <div class="dashboard-card settings-account-card">
        <div class="card-header-custom">
            <h5 class="card-title">
               <i class="bi bi-person-circle"></i>
               Account Settings
            </h5>
        </div>

        @* Use form POST to save changes with multipart for file upload *@
        <form asp-action="StudSettings" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            
            @* Success/Error Messages *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            
            <!-- Profile Picture Section -->
            <div class="row mb-4">
                <div class="col-12">
                    <h6 class="text-primary mb-3 border-bottom pb-2">
                        <i class="bi bi-image me-2"></i>Profile Picture
                    </h6>
                </div>
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrEmpty(Model?.User?.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                    {
                        <img id="profilePicturePreview" 
                             src="@Model.User.ProfilePicture" 
                             alt="Profile Picture" 
                             class="img-thumbnail rounded-circle mb-3" 
                             style="width: 150px; height: 150px; object-fit: cover;">
                    }
                    else
                    {
                        <div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light border" style="width: 150px; height: 150px;">
                            <i class="bi bi-person-circle text-secondary" style="font-size: 7rem;"></i>
                        </div>
                    }
                    
                    <div class="d-grid gap-2">
                        <label for="profilePictureFile" class="btn btn-primary">
                            <i class="bi bi-upload"></i> Choose Photo
                        </label>
                        <input type="file" 
                               id="profilePictureFile" 
                               name="profilePicture"
                               accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" 
                               style="display: none;">
                    </div>
                    
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-info-circle"></i> Max size: 5 MB<br>
                        Formats: JPG, PNG, GIF, WEBP
                    </small>
                </div>
                
                <div class="col-md-8">
                    <div class="alert alert-info border-0">
                        <h6 class="alert-heading">
                            <i class="bi bi-lightbulb-fill me-2"></i>Profile Picture Tips
                        </h6>
                        <ul class="mb-0 small">
                            <li>Upload a clear photo of yourself</li>
                            <li>Square images work best (displayed as circle)</li>
                            <li>Your image will be automatically uploaded to secure cloud storage</li>
                            <li>Supported formats: JPG, PNG, GIF, WEBP</li>
                            <li>Maximum file size: 5 MB</li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <hr class="my-4">
            
            <!-- Personal Information Section -->
            <div class="row g-3">
                <div class="col-12">
                    <h6 class="text-primary mb-3 border-bottom pb-2">
                        <i class="bi bi-person-fill me-2"></i>Personal Information
                    </h6>
                </div>
                
                <div class="col-12">
                    <label class="form-label">Full Name</label>
                    <input name="FullName" type="text" class="form-control" value="@(Model?.User?.FullName ?? "")" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input name="Email" type="email" class="form-control" value="@(Model?.User?.Email ?? "")" required>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-phone"></i></span>
                        <input name="PhoneNumber" type="tel" class="form-control" value="@(Model?.User?.PhoneNumber ?? "")">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Date of Birth</label>
                    <input name="DateOfBirth" type="date" class="form-control" value="@(Model?.User?.DateOfBirth.HasValue == true ? Model.User.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")">
                </div>
                
                <div class="col-md-6">
                    <label class="form-label">Gender</label>
                    <select name="Gender" class="form-select">
                        <option value="">-- Select Gender --</option>
                        <option value="Male" selected="@(Model?.Gender == "Male")">Male</option>
                        <option value="Female" selected="@(Model?.Gender == "Female")">Female</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Address</label>
                    <textarea name="Address" class="form-control" rows="2" placeholder="Enter your address">@("")</textarea>
                </div>

                <div class="col-12 mb-0">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>Save Changes
                    </button>
                </div>
            </div>
        </form>
      </div>
    </div>
</div>

<style>
    .theme-option {
        cursor: pointer;
        text-align: center;
        padding: 10px;
        border-radius: 12px;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }
    
    .theme-option:hover {
        background: rgba(13, 110, 253, 0.05);
    }
    
    .theme-option.active {
        border-color: #0d6efd;
        background: rgba(13, 110, 253, 0.1);
    }
    
    .theme-preview {
        width: 100px;
        height: 70px;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        margin-bottom: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .light-preview {
        background: #f8f9fa;
    }
    
    .light-preview .preview-sidebar {
        width: 25%;
        background: linear-gradient(180deg, #02a145 0%, #028a3a 100%);
    }
    
    .light-preview .preview-content {
        flex: 1;
        padding: 5px;
    }
    
    .light-preview .preview-header {
        height: 12px;
        background: #ffffff;
        border-radius: 2px;
        margin-bottom: 5px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    
    .light-preview .preview-body {
        height: calc(100% - 17px);
        background: #ffffff;
        border-radius: 2px;
    }
    
    .dark-preview {
        background: #1a1a1a;
    }
    
    .dark-preview .preview-sidebar {
        width: 25%;
        background: linear-gradient(180deg, #02a145 0%, #028a3a 100%);
    }
    
    .dark-preview .preview-content {
        flex: 1;
        padding: 5px;
    }
    
    .dark-preview .preview-header {
        height: 12px;
        background: #2d2d2d;
        border-radius: 2px;
        margin-bottom: 5px;
    }
    
    .dark-preview .preview-body {
        height: calc(100% - 17px);
        background: #2d2d2d;
        border-radius: 2px;
    }
    
    .theme-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-primary);
    }
    
    [data-theme="dark"] .theme-option:hover {
        background: rgba(13, 110, 253, 0.15);
    }
    
    [data-theme="dark"] .theme-option.active {
        background: rgba(13, 110, 253, 0.2);
    }
</style>

@section Scripts {
    <script>
        // Initialize theme selection on page load
        document.addEventListener('DOMContentLoaded', function() {
            const currentTheme = localStorage.getItem('theme') || 'light';
            updateThemeSelection(currentTheme);
        });
        
        function selectTheme(theme) {
            // Update the theme using the global function from student.js
            setTheme(theme);
            
            // Update the UI selection
            updateThemeSelection(theme);
        }
        
        function updateThemeSelection(theme) {
            const lightOption = document.getElementById('lightThemeOption');
            const darkOption = document.getElementById('darkThemeOption');
            
            if (lightOption && darkOption) {
                lightOption.classList.remove('active');
                darkOption.classList.remove('active');
                
                if (theme === 'dark') {
                    darkOption.classList.add('active');
                } else {
                    lightOption.classList.add('active');
                }
            }
        }
    </script>
    
    <script>
        // Profile Picture Preview
        (function() {
            const fileInput = document.getElementById('profilePictureFile');
            const preview = document.getElementById('profilePicturePreview');

            if (fileInput) {
                fileInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (!file) return;

                    // Validate file type
                    const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                    if (!validTypes.includes(file.type)) {
                        alert('Invalid file type. Please upload JPG, PNG, GIF, or WEBP image.');
                        fileInput.value = '';
                        return;
                    }

                    // Validate file size (5 MB)
                    if (file.size > 5 * 1024 * 1024) {
                        alert('File size must not exceed 5 MB.');
                        fileInput.value = '';
                        return;
                    }

                    // Show preview
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        // Replace icon/image with new preview
                        preview.outerHTML = `<img id="profilePicturePreview" 
                                                  src="${e.target.result}" 
                                                  alt="Profile Picture" 
                                                  class="img-thumbnail rounded-circle mb-3" 
                                                  style="width: 150px; height: 150px; object-fit: cover;">`;
                    };
                    reader.readAsDataURL(file);
                });
            }
        })();
    </script>
}
