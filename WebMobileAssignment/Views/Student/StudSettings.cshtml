@model WebMobileAssignment.Models.Student


@{
    ViewBag.Title = "Change Profile Settings";
    ViewBag.ActiveSubmenu = "Settings";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="row g-3">
<!-- Account Settings -->
<div class="col-lg-12">
  <div class="dashboard-card settings-account-card">
        <div class="card-header-custom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
               <i class="bi bi-person-circle"></i>
               Account Settings
            </h5>
            <a asp-controller="Student" asp-action="StudProfile" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
        </div>

        @* Use form POST to save changes with multipart for file upload *@
        <form asp-action="StudSettings" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            
            @* Success/Error Messages *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            
            <!-- Profile Picture Section -->
            <div class="mb-4">
                <h6 class="section-header mb-3">
                    <i class="bi bi-camera me-2"></i>Profile Picture
                </h6>
                
                <div class="row">
                    <div class="col-md-5 text-center profile-picture-column">
                        @if (!string.IsNullOrEmpty(Model?.User?.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                        {
                            <img id="profilePicturePreview" 
                                 src="@Model.User.ProfilePicture" 
                                 alt="Profile Picture" 
                                 class="rounded-circle mb-3" 
                                 style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #dee2e6;">
                        }
                        else
                        {
                            <div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 150px; height: 150px; border: 3px solid #dee2e6;">
                                <i class="bi bi-person-circle text-secondary" style="font-size: 7rem;"></i>
                            </div>
                        }
                        
                        <div class="d-grid gap-2 photo-buttons-container mx-auto" style="max-width: 300px;">
                            <!-- Choose Photo (Upload) - Red Solid -->
                            <label for="profilePictureFile" class="btn btn-photo-choose mb-0">
                                <i class="bi bi-upload me-2"></i>Choose Photo
                            </label>
                            <input type="file" 
                                   id="profilePictureFile" 
                                   name="profilePicture"
                                   accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" 
                                   style="display: none;">
                            
                            <!-- Take Photo - Blue Outline -->
                            <button type="button" id="btnTakePhoto" class="btn btn-photo-take">
                                <i class="bi bi-camera-fill me-2"></i>Take Photo
                            </button>
                            
                            <!-- Edit Photo - Green Outline -->
                            <button type="button" id="btnEditPhoto" class="btn btn-photo-edit">
                                <i class="bi bi-crop me-2"></i>Edit Photo
                            </button>
                            
                            <!-- Remove Photo - Red Outline -->
                            <button type="button" id="btnRemovePhoto" class="btn btn-photo-remove">
                                <i class="bi bi-trash me-2"></i>Remove
                            </button>
                        </div>
                        
                        <small class="text-muted d-block mt-3">
                            <i class="bi bi-info-circle"></i> Max size: 5 MB<br>
                            Formats: JPG, PNG, GIF, WEBP
                        </small>
                    </div>
                    
                    <div class="col-md-7">
                        <div class="profile-tips-box">
                            <h6 class="tips-heading">
                                <i class="bi bi-lightbulb-fill me-2"></i>Profile Picture Tips
                            </h6>
                            <ul class="tips-list">
                                <li>Upload a clear photo of yourself</li>
                                <li>Use your <strong>webcam</strong> to take a photo directly</li>
                                <li>Click <strong>"Edit Photo"</strong> to crop, rotate, and adjust your image</li>
                                <li>Square images work best (displayed as circle)</li>
                                <li>Your image will be automatically uploaded to secure cloud storage</li>
                                <li>Supported formats: JPG, PNG, GIF, WEBP</li>
                                <li>Maximum file size: 5 MB</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <hr class="my-4">
            
            <!-- Personal Information Section -->
            <div class="row g-3">
                <div class="col-12">
                    <h6 class="text-primary mb-3 border-bottom pb-2">
                        <i class="bi bi-person-fill me-2"></i>Personal Information
                    </h6>
                </div>
                
                <div class="col-12">
                    <label class="form-label">Full Name</label>
                    <input name="FullName" type="text" class="form-control" value="@(Model?.User?.FullName ?? "")" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input name="Email" type="email" class="form-control" value="@(Model?.User?.Email ?? "")" required>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-phone"></i></span>
                        <input name="PhoneNumber" type="tel" class="form-control" value="@(Model?.User?.PhoneNumber ?? "")">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Date of Birth</label>
                    <input name="DateOfBirth" type="date" class="form-control" value="@(Model?.User?.DateOfBirth.HasValue == true ? Model.User.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")">
                </div>
                
                <div class="col-md-6">
                    <label class="form-label">Gender</label>
                    <select name="Gender" class="form-select">
                        <option value="">-- Select Gender --</option>
                        <option value="Male" selected="@(Model?.Gender == "Male")">Male</option>
                        <option value="Female" selected="@(Model?.Gender == "Female")">Female</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Address</label>
                    <textarea name="Address" class="form-control" rows="2" placeholder="Enter your address">@("")</textarea>
                </div>

                <div class="col-12 mb-0">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>Save Changes
                    </button>
                </div>
            </div>
        </form>
      </div>
    </div>

    <!-- Theme Settings -->
    <div class="col-lg-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h5 class="card-title">
                    <i class="bi bi-palette-fill"></i>
                    Theme Settings
                </h5>
            </div>
            <div class="row align-items-center">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Appearance</label>
                    <p class="text-muted small mb-0">Choose your preferred theme for the portal</p>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3 justify-content-md-end">
                        <div class="theme-option" id="lightThemeOption" onclick="selectTheme('light')">
                            <div class="theme-preview light-preview">
                                <div class="preview-sidebar"></div>
                                <div class="preview-content">
                                    <div class="preview-header"></div>
                                    <div class="preview-body"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <i class="bi bi-sun-fill me-1"></i>Light
                            </div>
                        </div>
                        <div class="theme-option" id="darkThemeOption" onclick="selectTheme('dark')">
                            <div class="theme-preview dark-preview">
                                <div class="preview-sidebar"></div>
                                <div class="preview-content">
                                    <div class="preview-header"></div>
                                    <div class="preview-body"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <i class="bi bi-moon-fill me-1"></i>Dark
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Profile Picture Column - Push to Right */
.profile-picture-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-left: 3rem !important;
}

.photo-buttons-container {
    max-width: 400px;
    width: 100%;
}

/* Responsive adjustments */
@@media (max-width: 767px) {
    .profile-picture-column {
        padding-left: 0.75rem !important;
    }
}

/* Photo Action Buttons - Matching Reference Design */
.btn-photo-choose,
.btn-photo-take,
.btn-photo-edit,
.btn-photo-remove {
    width: 100%;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    transition: all 0.3s ease;
    border: 2px solid;
    cursor: pointer;
}

/* Choose Photo - Red Solid Button */
.btn-photo-choose {
    background-color: #dc3545;
    border-color: #dc3545;
    color: #ffffff;
}

.btn-photo-choose:hover {
    background-color: #bb2d3b;
    border-color: #b02a37;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
}

/* Take Photo - Blue Outline Button */
.btn-photo-take {
    background-color: transparent;
    border-color: #0d6efd;
    color: #0d6efd;
}

.btn-photo-take:hover {
    background-color: #0d6efd;
    border-color: #0d6efd;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(13, 110, 253, 0.3);
}

/* Edit Photo - Green Outline Button */
.btn-photo-edit {
    background-color: transparent;
    border-color: #198754;
    color: #198754;
}

.btn-photo-edit:hover {
    background-color: #198754;
    border-color: #198754;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(25, 135, 84, 0.3);
}

/* Remove Photo - Red Outline Button */
.btn-photo-remove {
    background-color: transparent;
    border-color: #dc3545;
    color: #dc3545;
}

.btn-photo-remove:hover {
    background-color: #dc3545;
    border-color: #dc3545;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
}

/* Active state for all buttons */
.btn-photo-choose:active,
.btn-photo-take:active,
.btn-photo-edit:active,
.btn-photo-remove:active {
    transform: translateY(0);
}

/* Dark mode adjustments */
[data-theme="dark"] .btn-photo-choose {
    background-color: #e74c3c;
    border-color: #e74c3c;
}

[data-theme="dark"] .btn-photo-choose:hover {
    background-color: #c0392b;
    border-color: #c0392b;
}

[data-theme="dark"] .btn-photo-take {
    border-color: #4dabf7;
    color: #4dabf7;
}

[data-theme="dark"] .btn-photo-take:hover {
    background-color: #4dabf7;
    border-color: #4dabf7;
    color: #ffffff;
}

[data-theme="dark"] .btn-photo-edit {
    border-color: #51cf66;
    color: #51cf66;
}

[data-theme="dark"] .btn-photo-edit:hover {
    background-color: #51cf66;
    border-color: #51cf66;
    color: #ffffff;
}

[data-theme="dark"] .btn-photo-remove {
    border-color: #ff6b6b;
    color: #ff6b6b;
}

[data-theme="dark"] .btn-photo-remove:hover {
    background-color: #ff6b6b;
    border-color: #ff6b6b;
    color: #ffffff;
}

/* Profile Picture Tips - Dark Mode Support */
.tips-highlight {
    color: inherit;
}

[data-theme="dark"] .tips-highlight {
    color: #ffffff !important;
    font-weight: 600;
}

html[data-theme="dark"] .tips-highlight {
    color: #ffffff !important;
    font-weight: 600;
}

body[data-theme="dark"] .tips-highlight {
    color: #ffffff !important;
    font-weight: 600;
}

[data-theme="dark"] .alert-info {
    background-color: #1e3a5f !important;
    color: #e0e0e0 !important;
}

[data-theme="dark"] .alert-info .alert-heading {
