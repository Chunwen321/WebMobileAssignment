@section Scripts {
    <!-- Cropper.js is already loaded in _StudentLayout.cshtml -->
    
    <!-- Inject Modals for ImageCropper -->
    <div id="imageCropperModals"></div>
    <script>
        if (typeof ImageCropper !== 'undefined') {
            document.getElementById('imageCropperModals').innerHTML = ImageCropper.getModalHTML();
        }
    </script>

    <script>
        // ==================== INITIALIZE IMAGE CROPPER ====================
        (function() {
            if (typeof ImageCropper !== 'undefined') {
                // Initialize ImageCropper for student profile
                ImageCropper.init({
                    targetId: 'studentSettings',
                    previewElementId: 'profilePicturePreview',
                    fileInputId: 'profilePictureFile',
                    editButtonId: 'btnEditPhoto',
                    previewWidth: 150,
                    previewHeight: 150
                });

                // Show Edit button if existing profile picture exists
                @if (!string.IsNullOrEmpty(Model?.User?.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                {
                    <text>
                    const btnEdit = document.getElementById('btnEditPhoto');
                    const btnRemove = document.getElementById('btnRemovePhoto');
                    if (btnEdit) btnEdit.style.display = 'block';
                    if (btnRemove) btnRemove.style.display = 'block';
                    </text>
                }
                else
                {
                    <text>
                    const btnEdit = document.getElementById('btnEditPhoto');
                    const btnRemove = document.getElementById('btnRemovePhoto');
                    if (btnEdit) btnEdit.style.display = 'none';
                    if (btnRemove) btnRemove.style.display = 'none';
                    </text>
                }
            } else {
                console.error('ImageCropper is not defined');
            }
        })();

        // ==================== WEBCAM FUNCTIONALITY ====================
        (function() {
            if (typeof WebcamCapture !== 'undefined') {
                // Initialize webcam capture
                WebcamCapture.init('profilePicturePreview', 'profilePictureFile', function(file) {
                    console.log('Photo captured from webcam:', file.name);
                    // Show edit and remove buttons after webcam capture
                    const btnEdit = document.getElementById('btnEditPhoto');
                    const btnRemove = document.getElementById('btnRemovePhoto');
                    if (btnEdit) btnEdit.style.display = 'block';
                    if (btnRemove) btnRemove.style.display = 'block';
                });

                // Webcam button click handler
                const webcamBtn = document.getElementById('btnTakePhoto');
                if (webcamBtn) {
                    webcamBtn.addEventListener('click', function() {
                        WebcamCapture.openModal();
                    });
                }
            } else {
                console.error('WebcamCapture is not defined');
            }
        })();

        // ==================== REMOVE PHOTO FUNCTIONALITY ====================
        (function() {
            const removeBtn = document.getElementById('btnRemovePhoto');
            if (removeBtn) {
                removeBtn.addEventListener('click', function() {
                    if (confirm('Are you sure you want to remove the profile picture?')) {
                        // Reset to default icon
                        const preview = document.getElementById('profilePicturePreview');
                        preview.outerHTML = `<div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 150px; height: 150px; border: 3px solid #dee2e6;">
                            <i class="bi bi-person-circle text-secondary" style="font-size: 7rem;"></i>
                        </div>`;
                        
                        // Clear file input
                        const fileInput = document.getElementById('profilePictureFile');
                        if (fileInput) fileInput.value = '';
                        
                        // Hide edit and remove buttons
                        const btnEdit = document.getElementById('btnEditPhoto');
                        const btnRemove = document.getElementById('btnRemovePhoto');
                        if (btnEdit) btnEdit.style.display = 'none';
                        if (btnRemove) btnRemove.style.display = 'none';
                    }
                });
            }
        })();

        // ==================== THEME SELECTION ====================
        // Initialize theme selection on page load
        document.addEventListener('DOMContentLoaded', function() {
            const currentTheme = localStorage.getItem('theme') || 'light';
            updateThemeSelection(currentTheme);
        });
        
        function selectTheme(theme) {
            // Update the theme using the global function from student.js
            setTheme(theme);
            
            // Update the UI selection
            updateThemeSelection(theme);
        }
        
        function updateThemeSelection(theme) {
            const lightOption = document.getElementById('lightThemeOption');
            const darkOption = document.getElementById('darkThemeOption');
            
            if (lightOption && darkOption) {
                lightOption.classList.remove('active');
                darkOption.classList.remove('active');
                
                if (theme === 'dark') {
                    darkOption.classList.add('active');
                } else {
                    lightOption.classList.add('active');
                }
            }
        }
    </script>
}
