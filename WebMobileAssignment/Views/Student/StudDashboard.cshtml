@{
    ViewBag.Title = "Student Dashboard";
    ViewBag.ActiveMenu = "StudDashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    
    var student = Model;
    var totalClasses = ViewBag.TotalClasses ?? 0;
    var presentCount = ViewBag.PresentCount ?? 0;
    var absentCount = ViewBag.AbsentCount ?? 0;
    var leaveCount = ViewBag.LeaveCount ?? 0;
    var attendanceRate = ViewBag.AttendanceRate ?? 0;
    var enrolledClasses = ViewBag.EnrolledClasses ?? 0;
    
    var presentPercentage = totalClasses > 0 ? Math.Round((double)presentCount / totalClasses * 100, 2) : 0;
    var absentPercentage = totalClasses > 0 ? Math.Round((double)absentCount / totalClasses * 100, 2) : 0;
    var leavePercentage = totalClasses > 0 ? Math.Round((double)leaveCount / totalClasses * 100, 2) : 0;
}
<div class="row g-3 mb-4">
    <!-- Attendance Stats -->
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #198754;">
            <div class="stat-label">Total Present</div>
            <div class="stat-value" id="presentCount">@presentPercentage%</div>
            <div class="stat-change positive"></div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #dc3545;">
            <div class="stat-label">Total Absent</div>
            <div class="stat-value" id="absentCount">@absentPercentage%</div>
            <div class="stat-change negative"></div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #ffc107;">
            <div class="stat-label">Medical Leave</div>
            <div class="stat-value" id="medicalLeaveCount">@leavePercentage%</div>
            <div class="stat-change positive"></div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #0d6efd;">
            <div class="stat-label">Attendance Rate</div>
            <div class="stat-value" id="attendanceRate">@(Math.Round(attendanceRate, 2))%</div>
            <div class="stat-change positive"></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Student Summary -->
    <div class="col-lg-4">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-person-badge-fill"></i>
                    Student Summary
                </h3>
            </div>
            <div class="text-center mb-3">
                @if (!string.IsNullOrEmpty(student?.User?.ProfilePicture) && !student.User.ProfilePicture.StartsWith("/images/"))
                {
                    <img src="@student.User.ProfilePicture" 
                         alt="@student?.User?.FullName" 
                         class="rounded-circle mb-3" 
                         style="width: 80px; height: 80px; object-fit: cover; border: 3px solid #02a145;">
                }
                else
                {
                    <div class="user-avatar mx-auto mb-3"
                         style="width: 80px; height: 80px; font-size: 2rem; background: #02a145; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                }
                <h5 class="mt-3 mb-1">@student?.User?.FullName</h5>
                <p class="text-muted mb-2">Student ID: @student?.StudentId</p>
            </div>

            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-book-fill me-2 text-primary"></i>Enrolled Classes</span>
                    <strong>@enrolledClasses</strong>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-calendar3 me-2 text-success"></i>Total Classes</span>
                    <strong>@totalClasses</strong>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-check-circle-fill me-2 text-success"></i>Present</span>
                    <strong>@presentCount</strong>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-x-circle-fill me-2 text-danger"></i>Absent</span>
                    <strong>@absentCount</strong>
                </div>
            </div>

            <a asp-controller="Student" asp-action="StudProfile"
               class="btn btn-outline-primary w-100 mt-3">
                <i class="bi bi-eye-fill me-2"></i>View Full Profile
            </a>
        </div>
    </div>

    <!-- Attendance Overview Chart -->
    <div class="col-lg-8">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-bar-chart-fill"></i>
                    Attendance Overview
                </h3>
                <select id="timePeriodSelect" class="form-select form-select-sm" style="width: auto;">
                    <option value="7days">Last 7 Days</option>
                    <option value="30days" selected>Last 30 Days</option>
                    <option value="3months">Last 3 Months</option>
                </select>
            </div>

            <!-- Chart Area -->
            <div style="background: #f8f9fa; border-radius: 8px; padding: 28px;">
                <!-- 7 Days - Line Chart -->
                <div id="chart7DaysContainer" style="display: none; position: relative; height: 300px;">
                    <canvas id="attendanceChart7Days"></canvas>
                </div>

                <!-- 30 Days - Bar Chart -->
                <div id="chart30DaysContainer" style="display: block; position: relative; height: 300px;">
                    <canvas id="attendanceChart30Days"></canvas>
                </div>

                <!-- 3 Months - Pie Chart -->
                <div id="chart3MonthsContainer" style="display: none; position: relative; height: 300px;">
                    <canvas id="attendanceChart3Months"></canvas>
                </div>
            </div>

            <!-- Summary Boxes -->
            <div class="row mt-4 text-center">
                <div class="col-4">
                    <div class="p-3"
                         style="background: rgba(25, 135, 84, 0.1); border-radius: 8px;">
                        <h4 class="mb-0" style="color: #198754;">@presentPercentage%</h4>
                        <small class="text-muted">Present</small>
                    </div>
                </div>

                <div class="col-4">
                    <div class="p-3"
                         style="background: rgba(220, 53, 69, 0.1); border-radius: 8px;">
                        <h4 class="mb-0" style="color: #dc3545;">@absentPercentage%</h4>
                        <small class="text-muted">Absent</small>
                    </div>
                </div>

                <div class="col-4">
                    <div class="p-3"
                         style="background: rgba(255, 193, 7, 0.1); border-radius: 8px;">
                        <h4 class="mb-0" style="color: #ffc107;">@leavePercentage%</h4>
                        <small class="text-muted">Medical Leave</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Attendance Table -->
<div class="row g-3 mt-3">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-clock-history"></i>
                    Recent Attendance
                </h3>
                <a asp-controller="Student" asp-action="StudAttendanceHistory"
                   class="btn btn-sm btn-outline-primary">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>



            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Classroom</th>
                            <th>Subject</th>
                            <th>Teacher</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var recentAttendances = ViewBag.RecentAttendances as List<WebMobileAssignment.Models.Attendance> ?? new List<WebMobileAssignment.Models.Attendance>();
                            
                            if (recentAttendances.Any())
                            {
                                foreach (var attendance in recentAttendances)
                                {
                                    var statusBadgeClass = attendance.Status switch
                                    {
                                        "Present" => "bg-success",
                                        "Absent" => "bg-danger",
                                        "Late" => "bg-warning",
                                        "Leave" => "bg-info",
                                        _ => "bg-secondary"
                                    };
                                    
                                    <tr>
                                        <td><i class="bi bi-calendar3 me-2 text-muted"></i>@attendance.Date.ToString("yyyy-MM-dd")</td>
                                        <td>@(attendance.Class?.RoomNumber ?? "N/A")</td>
                                        <td>@(attendance.Class?.Subject?.SubjectName ?? "N/A")</td>
                                        <td>@(attendance.Class?.Teacher?.User?.FullName ?? "N/A")</td>
                                        <td><span class="badge @statusBadgeClass">@attendance.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No attendance records found</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>
        let chart7Days, chart30Days, chart3Months;

        document.addEventListener('DOMContentLoaded', function () {
            // Parse attendance data from ViewBag
            const data7Days = @Html.Raw(ViewBag.Attendances7Days ?? "[]");
            const data30Days = @Html.Raw(ViewBag.Attendances30Days ?? "[]");
            const data3Months = @Html.Raw(ViewBag.Attendances3Months ?? "[]");

            // Initialize all charts
            initChart7Days(data7Days);
            initChart30Days(data30Days);
            initChart3Months(data3Months);

            // Handle time period selection
            document.getElementById('timePeriodSelect').addEventListener('change', function(e) {
                const period = e.target.value;
                showChart(period);
            });
        });

        function showChart(period) {
            const container7 = document.getElementById('chart7DaysContainer');
            const container30 = document.getElementById('chart30DaysContainer');
            const container3 = document.getElementById('chart3MonthsContainer');

            container7.style.display = 'none';
            container30.style.display = 'none';
            container3.style.display = 'none';

            if (period === '7days') {
                container7.style.display = 'block';
                if (chart7Days) chart7Days.resize();
            } else if (period === '30days') {
                container30.style.display = 'block';
                if (chart30Days) chart30Days.resize();
            } else if (period === '3months') {
                container3.style.display = 'block';
                if (chart3Months) chart3Months.resize();
            }
        }

        function initChart7Days(data) {
            if (!data || data.length === 0) return;

            const labels = data.map(d => new Date(d.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
            const presentData = data.map(d => d.present);
            const absentData = data.map(d => d.absent);
            const leaveData = data.map(d => d.leave);

            const ctx = document.getElementById('attendanceChart7Days').getContext('2d');
            chart7Days = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Present',
                            data: presentData,
                            borderColor: 'rgba(2, 161, 69, 1)',
                            backgroundColor: 'rgba(2, 161, 69, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: 'rgba(2, 161, 69, 1)'
                        },
                        {
                            label: 'Absent',
                            data: absentData,
                            borderColor: 'rgba(220, 53, 69, 1)',
                            backgroundColor: 'rgba(220, 53, 69, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: 'rgba(220, 53, 69, 1)'
                        },
                        {
                            label: 'Leave',
                            data: leaveData,
                            borderColor: 'rgba(255, 193, 7, 1)',
                            backgroundColor: 'rgba(255, 193, 7, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: 'rgba(255, 193, 7, 1)'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: { padding: 15 }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: 'Number of Days' }
                        }
                    }
                }
            });
        }

        function initChart30Days(data) {
            if (!data || data.length === 0) return;

            const labels = data.map(d => new Date(d.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
            const presentData = data.map(d => d.present);
            const absentData = data.map(d => d.absent);
            const leaveData = data.map(d => d.leave);

            const ctx = document.getElementById('attendanceChart30Days').getContext('2d');
            chart30Days = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Present',
                            data: presentData,
                            backgroundColor: 'rgba(2, 161, 69, 0.8)',
                            borderColor: 'rgba(2, 161, 69, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'Absent',
                            data: absentData,
                            backgroundColor: 'rgba(220, 53, 69, 0.8)',
                            borderColor: 'rgba(220, 53, 69, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'Leave',
                            data: leaveData,
                            backgroundColor: 'rgba(255, 193, 7, 0.8)',
                            borderColor: 'rgba(255, 193, 7, 1)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: { padding: 15 }
                        }
                    },
                    scales: {
                        x: {
                            stacked: false
                        },
                        y: {
                            beginAtZero: true,
                            stacked: false
                        }
                    }
                }
            });
        }

        function initChart3Months(data) {
            if (!data || data.length === 0) return;

            const totalPresent = data.reduce((sum, d) => sum + d.present, 0);
            const totalAbsent = data.reduce((sum, d) => sum + d.absent, 0);
            const totalLeave = data.reduce((sum, d) => sum + d.leave, 0);

            const ctx = document.getElementById('attendanceChart3Months').getContext('2d');
            chart3Months = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Present', 'Absent', 'Leave'],
                    datasets: [{
                        data: [totalPresent, totalAbsent, totalLeave],
                        backgroundColor: [
                            'rgba(2, 161, 69, 0.95)',
                            'rgba(220, 53, 69, 0.95)',
                            'rgba(255, 193, 7, 0.95)'
                        ],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 16
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    const label = context.label || '';
                                    const value = context.parsed || 0;
                                    return label + ': ' + value + ' days';
                                }
                            }
                        }
                    }
                }
            });
        }
    </script>
}