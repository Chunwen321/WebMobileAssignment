@{
ViewBag.Title = "Student Dashboard";
ViewBag.ActiveMenu = "StudDashboard";
Layout = "~/Views/Shared/_StudentLayout.cshtml";
    
    var student = Model;
    var totalClasses = ViewBag.TotalClasses ?? 0;
    var presentCount = ViewBag.PresentCount ?? 0;
    var absentCount = ViewBag.AbsentCount ?? 0;
    var leaveCount = ViewBag.LeaveCount ?? 0;
    var enrolledClasses = ViewBag.EnrolledClasses ?? 0;
    
    // Calculate percentages based on total attendance records
    var totalRecords = presentCount + absentCount + leaveCount;
    var presentPercentage = totalRecords > 0 ? Math.Round((double)presentCount / totalRecords * 100, 1) : 0;
    var absentPercentage = totalRecords > 0 ? Math.Round((double)absentCount / totalRecords * 100, 1) : 0;
    var leavePercentage = totalRecords > 0 ? Math.Round((double)leaveCount / totalRecords * 100, 1) : 0;
    
    // Attendance rate: (Present + Leave) / Total * 100 (Leave counts as present)
    var attendanceRate = totalRecords > 0 ? Math.Round((double)(presentCount + leaveCount) / totalRecords * 100, 1) : 0;
}
<div class="row g-3 mb-4">
    <!-- Attendance Stats -->
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #198754;">
            <div class="stat-label">Total Present</div>
            <div class="stat-value" id="presentCount">@presentCount</div>
            <div class="stat-change positive"></div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #dc3545;">
            <div class="stat-label">Total Absent</div>
            <div class="stat-value" id="absentCount">@absentCount</div>
            <div class="stat-change negative"></div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #ffc107;">
            <div class="stat-label">Medical Leave</div>
            <div class="stat-value" id="medicalLeaveCount">@leaveCount</div>
            <div class="stat-change positive"></div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #0d6efd;">
            <div class="stat-label">Attendance Rate</div>
            <div class="stat-value" id="attendanceRate">@attendanceRate%</div>
            <div class="stat-change positive"></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Student Summary -->
    <div class="col-lg-4">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-person-badge-fill"></i>
                    Student Summary
                </h3>
            </div>
            <div class="text-center mb-3">
                @if (!string.IsNullOrEmpty(student?.User?.ProfilePicture) && !student.User.ProfilePicture.StartsWith("/images/"))
                {
                    <img src="@student.User.ProfilePicture" 
                         alt="@student?.User?.FullName" 
                         class="rounded-circle mb-3" 
                         style="width: 80px; height: 80px; object-fit: cover; border: 3px solid #02a145;">
                }
                else
                {
                    <div class="user-avatar mx-auto mb-3"
                         style="width: 80px; height: 80px; font-size: 2rem; background: #02a145; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                }
                <h5 class="mt-3 mb-1">@student?.User?.FullName</h5>
                <p class="text-muted mb-2">Student ID: @student?.StudentId</p>
            </div>

            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-book-fill me-2 text-primary"></i>Enrolled Classes</span>
                    <strong>@enrolledClasses</strong>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-calendar3 me-2 text-success"></i>Total Classes</span>
                    <strong>@totalClasses</strong>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-check-circle-fill me-2 text-success"></i>Present</span>
                    <strong>@presentCount</strong>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted"><i class="bi bi-x-circle-fill me-2 text-danger"></i>Absent</span>
                    <strong>@absentCount</strong>
                </div>
            </div>

            <a asp-controller="Student" asp-action="StudProfile"
               class="btn btn-outline-primary w-100 mt-3">
                <i class="bi bi-eye-fill me-2"></i>View Full Profile
            </a>
        </div>
    </div>

    <!-- Attendance Overview Chart -->
    <div class="col-lg-8">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-pie-chart-fill"></i>
                    Attendance Overview
                </h3>
            </div>

            <!-- Pie Chart Area -->
            <div class="chart-container" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px; padding: 24px; box-shadow: inset 0 2px 4px rgba(0,0,0,0.06);">
                <div style="position: relative; height: 220px; max-width: 400px; margin: 0 auto;">
                    <canvas id="attendancePieChart"></canvas>
                </div>
            </div>

            <!-- Summary Boxes -->
            <div class="row mt-4 text-center">
                <div class="col-4">
                    <div class="p-3 attendance-stat-box present-stat"
                         style="background: rgba(25, 135, 84, 0.1); border-radius: 8px;">
                        <h4 class="mb-0 attendance-stat-value">@presentPercentage%</h4>
                        <small class="attendance-stat-label">Present</small>
                    </div>
                </div>

                <div class="col-4">
                    <div class="p-3 attendance-stat-box absent-stat"
                         style="background: rgba(220, 53, 69, 0.1); border-radius: 8px;">
                        <h4 class="mb-0 attendance-stat-value">@absentPercentage%</h4>
                        <small class="attendance-stat-label">Absent</small>
                    </div>
                </div>

                <div class="col-4">
                    <div class="p-3 attendance-stat-box leave-stat"
                         style="background: rgba(255, 193, 7, 0.15); border-radius: 8px;">
                        <h4 class="mb-0 attendance-stat-value">@leavePercentage%</h4>
                        <small class="attendance-stat-label">Medical Leave</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Attendance Table -->
<div class="row g-3 mt-3">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-clock-history"></i>
                    Recent Attendance
                </h3>
                <a asp-controller="Student" asp-action="StudAttendanceHistory"
                   class="btn btn-sm btn-outline-primary">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>



            <div class="table-responsive">
                <table id="recent-attendance-table" class="table table-hover align-middle" style="background-color: #f8f9fa;">
                    <thead style="background-color: #e9ecef;">
                        <tr>
                            <th>Date</th>
                            <th>Classroom</th>
                            <th>Subject</th>
                            <th>Teacher</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody style="background-color: #f8f9fa;">
                        @{
                            var recentAttendances = ViewBag.RecentAttendances as List<WebMobileAssignment.Models.Attendance> ?? new List<WebMobileAssignment.Models.Attendance>();
                            
                            if (recentAttendances.Any())
                            {
                                foreach (var attendance in recentAttendances)
                                {
                                    var statusBadgeClass = attendance.Status switch
                                    {
                                        "Present" => "bg-success",
                                        "Absent" => "bg-danger",
                                        "Late" => "bg-warning",
                                        "Leave" => "bg-info",
                                        _ => "bg-secondary"
                                    };
                                    
                                    <tr>
                                        <td><i class="bi bi-calendar3 me-2 text-muted"></i>@attendance.Date.ToString("yyyy-MM-dd")</td>
                                        <td>@(attendance.Class?.RoomNumber ?? "N/A")</td>
                                        <td>@(attendance.Class?.Subject?.SubjectName ?? "N/A")</td>
                                        <td>@(attendance.Class?.Teacher?.User?.FullName ?? "N/A")</td>
                                        <td><span class="badge @statusBadgeClass">@attendance.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No attendance records found</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>
        // Store chart instance globally for theme updates
        let attendanceChart = null;
        
        document.addEventListener('DOMContentLoaded', function () {
            // Get attendance counts from server
            const presentCount = @presentCount;
            const absentCount = @absentCount;
            const leaveCount = @leaveCount;
            
            // Initialize pie chart
            initPieChart(presentCount, absentCount, leaveCount);
            
            // Listen for theme changes
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.attributeName === 'data-theme') {
                        // Reinitialize chart with new theme
                        initPieChart(presentCount, absentCount, leaveCount);
                    }
                });
            });
            
            // Observe theme changes on document element
            observer.observe(document.documentElement, {
                attributes: true,
                attributeFilter: ['data-theme']
            });
        });

        function initPieChart(present, absent, leave) {
            const ctx = document.getElementById('attendancePieChart').getContext('2d');
            
            // Check if there's any data
            const total = present + absent + leave;
            
            if (total === 0) {
                // Show "No data" message
                ctx.font = '16px Arial';
                ctx.fillStyle = '#6c757d';
                ctx.textAlign = 'center';
                ctx.fillText('No attendance records yet', ctx.canvas.width / 2, ctx.canvas.height / 2);
                return;
            }
            
            // Destroy existing chart if it exists
            if (attendanceChart) {
                attendanceChart.destroy();
            }
            
            // Check current theme
            const isDarkTheme = document.documentElement.getAttribute('data-theme') === 'dark';
            const legendColor = isDarkTheme ? '#ffffff' : '#666666';
            
            attendanceChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Present', 'Absent', 'Medical Leave'],
                    datasets: [{
                        data: [present, absent, leave],
                        backgroundColor: [
                            '#28a745',
                            '#dc3545',
                            '#ffc107'
                        ],
                        borderColor: '#ffffff',
                        borderWidth: 3,
                        hoverOffset: 8,
                        hoverBorderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '55%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                pointStyle: 'circle',
                                padding: 16,
                                font: {
                                    size: 13,
                                    weight: '500'
                                },
                                color: legendColor
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            titleFont: { size: 14, weight: 'bold' },
                            bodyFont: { size: 13 },
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: function (context) {
                                    const label = context.label || '';
                                    const value = context.parsed || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                    return label + ': ' + value + ' (' + percentage + '%)';
                                }
                            }
                        }
                    },
                    animation: {
                        animateScale: true,
                        animateRotate: true
                    }
                }
            });
        }
    </script>
}