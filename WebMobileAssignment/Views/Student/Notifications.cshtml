@{
    ViewBag.Title = "Notifications";
    ViewBag.ActiveMenu = "Notifications";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

@{
    var notifications = ViewBag.Notifications as List<WebMobileAssignment.Models.Notification> ?? new List<WebMobileAssignment.Models.Notification>();
    var totalNotifications = ViewBag.TotalNotifications ?? 0;
    var unreadCount = ViewBag.UnreadCount ?? 0;
    var readCount = ViewBag.ReadCount ?? 0;
    var importantCount = ViewBag.ImportantCount ?? 0;
}

<form method="post" id="notificationForm">
    @Html.AntiForgeryToken()
</form>

<div class="row g-3 mb-4">
    <!-- Notification Stats -->
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #0d6efd;">
            <div class="stat-label">Total Notifications</div>
            <div class="stat-value">@totalNotifications</div>
            <div class="stat-change">
                <i class="bi bi-bell-fill"></i>
                <span>All messages</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #dc3545;">
            <div class="stat-label">Unread</div>
            <div class="stat-value">@unreadCount</div>
            <div class="stat-change">
                <i class="bi bi-envelope-fill"></i>
                <span>Needs attention</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #ffc107;">
            <div class="stat-label">Important</div>
            <div class="stat-value">@importantCount</div>
            <div class="stat-change">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>Class & enrollment updates</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #198754;">
            <div class="stat-label">Completed</div>
            <div class="stat-value">@readCount</div>
            <div class="stat-change positive">
                <i class="bi bi-check-circle-fill"></i>
                <span>Read & acknowledged</span>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-card">
    <div class="card-header-custom">
        <div>
            <h3 class="card-title">
                <i class="bi bi-bell-fill"></i>
                All Notifications
            </h3>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            @if (unreadCount > 0)
            {
                <button class="btn btn-sm btn-outline-primary" onclick="markAllAsRead()">
                    <i class="bi bi-check-all me-2"></i>Mark All as Read
                </button>
            }
            <button class="btn btn-sm btn-outline-danger" onclick="deleteAllRead()">
                <i class="bi bi-trash me-2"></i>Clear Read
            </button>
            <div class="input-group input-group-sm" style="max-width: 250px;">
                <input type="text" class="form-control" id="searchInput" placeholder="Search notifications..." onkeyup="filterNotifications()">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <ul class="nav nav-tabs" role="tablist" style="border-bottom: 1px solid var(--border-color); padding: 0 1rem;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab" aria-controls="all" aria-selected="true" onclick="filterByType('all')">
                <i class="bi bi-bell me-1"></i>All
                <span class="badge bg-secondary ms-2">@totalNotifications</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="unread-tab" data-bs-toggle="tab" data-bs-target="#unread" type="button" role="tab" aria-controls="unread" aria-selected="false" onclick="filterByType('unread')">
                <i class="bi bi-envelope-fill me-1"></i>Unread
                <span class="badge bg-danger ms-2">@unreadCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="important-tab" data-bs-toggle="tab" data-bs-target="#important" type="button" role="tab" aria-controls="important" aria-selected="false" onclick="filterByType('important')">
                <i class="bi bi-star-fill me-1"></i>Important
                <span class="badge bg-warning text-dark ms-2">@importantCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="system-tab" data-bs-toggle="tab" data-bs-target="#system" type="button" role="tab" aria-controls="system" aria-selected="false" onclick="filterByType('system')">
                <i class="bi bi-info-circle me-1"></i>System
            </button>
        </li>
    </ul>

    <!-- Notifications List -->
    <div class="tab-content">
        <div class="tab-pane fade show active" id="all" role="tabpanel" aria-labelledby="all-tab">
            @if (notifications.Any())
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications)
                    {
                        var isUnread = notification.Status == "unread";
                        var isImportant = notification.Description.ToLower().Contains("class") ||
                                        notification.Description.ToLower().Contains("enrollment") ||
                                        notification.Description.ToLower().Contains("leave");
                        var isSystem = notification.Description.ToLower().Contains("system") ||
                                     notification.Description.ToLower().Contains("update") ||
                                     notification.Description.ToLower().Contains("maintenance");

                        var iconClass = isImportant ? "bi-star-fill" : (isSystem ? "bi-info-circle-fill" : "bi-bell-fill");
                        var iconType = isImportant ? "warning" : (isSystem ? "primary" : "success");
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item notification-record @(isUnread ? "unread" : "read") @(isImportant ? "type-important" : (isSystem ? "type-system" : "type-general"))" 
                             data-notification-id="@notification.NotificationId"
                             data-type="@(isImportant ? "important" : (isSystem ? "system" : "general"))" 
                             data-status="@(isUnread ? "unread" : "read")"
                             onclick="showNotificationDetails('@notification.NotificationId')" 
                             style="cursor: pointer;">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon @iconType flex-shrink-0">
                                        <i class="bi @iconClass"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>@timeAgo
                                        </small>
                                    </div>
                                    @if (isUnread)
                                    {
                                        <span class="badge bg-danger flex-shrink-0">Unread</span>
                                    }
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-0 notification-description">@notification.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-bell-slash" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No notifications yet</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="unread" role="tabpanel" aria-labelledby="unread-tab">
            @if (notifications.Any(n => n.Status == "unread"))
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications.Where(n => n.Status == "unread"))
                    {
                        var isImportant = notification.Description.ToLower().Contains("class") ||
                                        notification.Description.ToLower().Contains("enrollment") ||
                                        notification.Description.ToLower().Contains("leave");
                        var isSystem = notification.Description.ToLower().Contains("system") ||
                                     notification.Description.ToLower().Contains("update");
                        var iconClass = isImportant ? "bi-star-fill" : (isSystem ? "bi-info-circle-fill" : "bi-bell-fill");
                        var iconType = isImportant ? "warning" : (isSystem ? "primary" : "success");
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item unread notification-record" 
                             data-notification-id="@notification.NotificationId"
                             data-type="@(isImportant ? "important" : (isSystem ? "system" : "general"))" 
                             data-status="unread"
                             onclick="showNotificationDetails('@notification.NotificationId')" 
                             style="cursor: pointer;">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon @iconType flex-shrink-0">
                                        <i class="bi @iconClass"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@timeAgo</small>
                                    </div>
                                    <span class="badge bg-danger flex-shrink-0">Unread</span>
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-0">@notification.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-check-circle" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">All caught up! No unread notifications</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="important" role="tabpanel" aria-labelledby="important-tab">
            @if (notifications.Any(n => n.Description.ToLower().Contains("class") || 
                                        n.Description.ToLower().Contains("enrollment") || 
                                        n.Description.ToLower().Contains("leave")))
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications.Where(n => n.Description.ToLower().Contains("class") || 
                                                                           n.Description.ToLower().Contains("enrollment") || 
                                                                           n.Description.ToLower().Contains("leave")))
                    {
                        var isUnread = notification.Status == "unread";
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item type-important notification-record @(isUnread ? "unread" : "read")" 
                             data-notification-id="@notification.NotificationId"
                             data-type="important" 
                             data-status="@(isUnread ? "unread" : "read")"
                             onclick="showNotificationDetails('@notification.NotificationId')" 
                             style="cursor: pointer;">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon warning flex-shrink-0">
                                        <i class="bi bi-star-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@timeAgo</small>
                                    </div>
                                    @if (isUnread)
                                    {
                                        <span class="badge bg-danger flex-shrink-0">Unread</span>
                                    }
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-0">@notification.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-star" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No important notifications</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="system" role="tabpanel" aria-labelledby="system-tab">
            @if (notifications.Any(n => n.Description.ToLower().Contains("system") || 
                                        n.Description.ToLower().Contains("update") || 
                                        n.Description.ToLower().Contains("maintenance")))
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications.Where(n => n.Description.ToLower().Contains("system") || 
                                                                           n.Description.ToLower().Contains("update") || 
                                                                           n.Description.ToLower().Contains("maintenance")))
                    {
                        var isUnread = notification.Status == "unread";
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item type-system notification-record @(isUnread ? "unread" : "read")" 
                             data-notification-id="@notification.NotificationId"
                             data-type="system" 
                             data-status="@(isUnread ? "unread" : "read")"
                             onclick="showNotificationDetails('@notification.NotificationId')" 
                             style="cursor: pointer;">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon primary flex-shrink-0">
                                        <i class="bi bi-info-circle-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@timeAgo</small>
                                    </div>
                                    @if (isUnread)
                                    {
                                        <span class="badge bg-danger flex-shrink-0">Unread</span>
                                    }
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-0">@notification.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-gear" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No system notifications</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Notification Detail Modal -->
<div class="modal fade" id="notificationDetailModal" tabindex="-1" aria-labelledby="notificationDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="notificationDetailModalLabel">
                    <i class="bi bi-bell-fill me-2"></i>
                    <span id="modalNotificationType">Notification Details</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="notificationDetailBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">Loading notification details...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime date)
    {
        var timeSpan = DateTime.Now - date;

        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} minute{((int)timeSpan.TotalMinutes == 1 ? "" : "s")} ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} hour{((int)timeSpan.TotalHours == 1 ? "" : "s")} ago";
        if (timeSpan.TotalDays < 30)
            return $"{(int)timeSpan.TotalDays} day{((int)timeSpan.TotalDays == 1 ? "" : "s")} ago";
        if (timeSpan.TotalDays < 365)
            return $"{(int)(timeSpan.TotalDays / 30)} month{((int)(timeSpan.TotalDays / 30) == 1 ? "" : "s")} ago";

        return date.ToString("MMM dd, yyyy");
    }

    string GetNotificationTitle(string description)
    {
        if (description.ToLower().Contains("leave application"))
            return "Leave Application Update";
        if (description.ToLower().Contains("leave"))
            return "Leave Notice";
        if (description.ToLower().Contains("enrollment"))
            return "Enrollment Update";
        if (description.ToLower().Contains("class"))
            return "Class Notification";
        if (description.ToLower().Contains("attendance"))
            return "Attendance Notice";
        if (description.ToLower().Contains("system"))
            return "System Notification";
        if (description.ToLower().Contains("update"))
            return "System Update";
        if (description.ToLower().Contains("maintenance"))
            return "Maintenance Notice";

        return "Notification";
    }
}

@section Scripts {
<script>
    function markAsRead(notificationId) {
        $.ajax({
            url: '@Url.Action("MarkAsRead", "Student")',
            type: 'POST',
            data: {
                notificationId: notificationId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function() {
                alert('An error occurred while marking notification as read.');
            }
        });
    }

    function markAllAsRead() {
        if (confirm('Mark all notifications as read?')) {
            $.ajax({
                url: '@Url.Action("MarkAllAsRead", "Student")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while marking all notifications as read.');
                }
            });
        }
    }

    function deleteNotification(notificationId) {
        if (confirm('Are you sure you want to delete this notification?')) {
            $.ajax({
                url: '@Url.Action("DeleteNotification", "Student")',
                type: 'POST',
                data: {
                    notificationId: notificationId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while deleting the notification.');
                }
            });
        }
    }

    function deleteAllRead() {
        if (confirm('Delete all read notifications? This cannot be undone.')) {
            $.ajax({
                url: '@Url.Action("DeleteAllRead", "Student")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while deleting read notifications.');
                }
            });
        }
    }

    function filterByType(type) {
        // Tab switching is handled by Bootstrap
    }

    function filterNotifications() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const notifications = document.querySelectorAll('.notification-record');

        notifications.forEach(notification => {
            const title = notification.querySelector('.notification-content h6').textContent.toLowerCase();
            const description = notification.querySelector('.notification-description').textContent.toLowerCase();

            if (title.includes(searchTerm) || description.includes(searchTerm)) {
                notification.style.display = '';
            } else {
                notification.style.display = 'none';
            }
        });
    }

    function showNotificationDetails(notificationId) {
        // Show modal with loading state
        const modal = new bootstrap.Modal(document.getElementById('notificationDetailModal'));
        modal.show();

        // Mark notification as read
        $.ajax({
            url: '@Url.Action("MarkAsRead", "Student")',
            type: 'POST',
            data: {
                notificationId: notificationId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    // Update the notification card to show as read
                    const notificationCard = $('[data-notification-id="' + notificationId + '"]');
                    notificationCard.removeClass('unread').addClass('read');
                    notificationCard.attr('data-status', 'read');
                    notificationCard.find('.badge.bg-danger').remove();
                }
            }
        });

        // Fetch notification details
        $.ajax({
            url: '@Url.Action("GetNotificationDetails", "Student")',
            type: 'GET',
            data: { notificationId: notificationId },
            success: function(response) {
                if (response.success) {
                    $('#modalNotificationType').text(response.notification.type || 'Notification');
                    $('#notificationDetailBody').html(buildNotificationDetailHTML(response));
                } else {
                    $('#notificationDetailBody').html('<div class="alert alert-danger">Error loading notification details: ' + response.message + '</div>');
                }
            },
            error: function() {
                $('#notificationDetailBody').html('<div class="alert alert-danger">An error occurred while loading notification details.</div>');
            }
        });
    }

    function buildNotificationDetailHTML(response) {
        const notification = response.notification;
        const details = response.details;
        let html = '';

        if (!details) {
            // Only show basic info if no details available
            html += '<div class="mb-3">';
            html += '<div class="d-flex justify-content-between align-items-start mb-2">';
            html += '<span class="badge bg-primary">' + (notification.type || 'Notification') + '</span>';
            html += '<small class="text-muted"><i class="bi bi-clock me-1"></i>' + notification.createdDate + '</small>';
            html += '</div>';
            html += '<p class="text-muted mb-0">' + notification.description + '</p>';
            html += '</div>';
            return html;
        }

        // Build details based on notification type
        switch (notification.type) {
            case 'Class Enrollment':
            case 'Class Unenrollment':
                html += buildClassDetails(details);
                break;
            case 'Leave Application':
            case 'Leave Approved':
            case 'Leave Rejected':
                html += buildLeaveDetails(details);
                break;
            case 'Attendance Marked':
            case 'Low Attendance Alert':
            case 'Low Attendance Warning':
                html += buildAttendanceDetails(details);
                break;
            default:
                html += '<p class="text-muted">No additional details available.</p>';
        }

        return html;
    }

    function buildClassDetails(details) {
        let html = '<h6 class="mb-3"><i class="bi bi-book me-2"></i>Class Details</h6>';
        html += '<div class="row g-3">';
        html += '<div class="col-md-6"><strong>Class Name:</strong><br/>' + details.className + '</div>';
        html += '<div class="col-md-6"><strong>Teacher:</strong><br/>' + (details.teacher || 'N/A') + '</div>';
        html += '<div class="col-md-6"><strong>Venue:</strong><br/>' + (details.room || 'N/A') + '</div>';
        html += '<div class="col-md-6"><strong>Day:</strong><br/>' + (details.day || 'N/A') + '</div>';
        html += '<div class="col-md-6"><strong>Time:</strong><br/>' + (details.time || 'N/A') + '</div>';
        html += '<div class="col-md-6"><strong>Capacity:</strong><br/>' + details.capacity + '</div>';
        if (details.subject) {
            html += '<div class="col-12"><strong>Subject:</strong><br/>' + details.subject + '</div>';
        }
        html += '</div>';
        return html;
    }

    function buildLeaveDetails(details) {
        let html = '<h6 class="mb-3"><i class="bi bi-calendar-x me-2"></i>Leave Application Details</h6>';
        html += '<div class="card border-0 bg-light mb-3">';
        html += '<div class="card-body">';
        html += '<div class="row g-3">';
        if (details.leaveId) {
            html += '<div class="col-md-6"><i class="bi bi-hash text-primary me-2"></i><strong>Leave ID:</strong><br/><span class="ms-4">' + details.leaveId + '</span></div>';
        }
        if (details.applicant) {
            html += '<div class="col-md-6"><i class="bi bi-person text-primary me-2"></i><strong>Applicant:</strong><br/><span class="ms-4">' + details.applicant + '</span></div>';
            html += '<div class="col-md-6"><i class="bi bi-envelope text-primary me-2"></i><strong>Email:</strong><br/><span class="ms-4">' + details.email + '</span></div>';
        }
        html += '<div class="col-md-6"><i class="bi bi-calendar-check text-success me-2"></i><strong>Start Date:</strong><br/><span class="ms-4">' + details.startDate + '</span></div>';
        html += '<div class="col-md-6"><i class="bi bi-calendar-x text-danger me-2"></i><strong>End Date:</strong><br/><span class="ms-4">' + details.endDate + '</span></div>';
        html += '<div class="col-md-6"><i class="bi bi-calendar3 text-info me-2"></i><strong>Total Days:</strong><br/><span class="ms-4 fs-5 fw-bold">' + details.totalDays + '</span></div>';
        html += '<div class="col-md-6"><i class="bi bi-check-circle me-2"></i><strong>Status:</strong><br/><span class="ms-4"><span class="badge bg-' + 
                (details.status === 'Approved' ? 'success' : (details.status === 'Rejected' ? 'danger' : 'warning')) + ' fs-6">' + 
                details.status + '</span></span></div>';
        html += '</div>';
        if (details.reason) {
            html += '<div class="mt-3 p-3 detail-section rounded"><strong><i class="bi bi-chat-left-text text-primary me-2"></i>Reason:</strong><br/><p class="mb-0 mt-2 ms-4">' + details.reason + '</p></div>';
        }
        if (details.remarks) {
            html += '<div class="mt-3 p-3 detail-section rounded"><strong><i class="bi bi-sticky text-warning me-2"></i>Remarks:</strong><br/><p class="mb-0 mt-2 ms-4">' + details.remarks + '</p></div>';
        }
        if (details.createdDate) {
            html += '<div class="mt-3"><small class="text-muted"><i class="bi bi-clock-history me-1"></i>Applied On: ' + details.createdDate + '</small></div>';
        }
        html += '</div></div>';
        return html;
    }

    function buildAttendanceDetails(details) {
        const rate = parseFloat(details.attendanceRate);
        let html = '<h6 class="mb-3"><i class="bi bi-clipboard-check me-2"></i>Student Attendance Report</h6>';
        if (rate < 60) {
            html += '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i><strong>Critical:</strong> Attendance rate is below minimum requirement (60%).</div>';
        } else if (rate < 80) {
            html += '<div class="alert alert-warning"><i class="bi bi-exclamation-circle me-2"></i><strong>Warning:</strong> Attendance rate needs improvement.</div>';
        }
        html += '<div class="card border-0 bg-light">';
        html += '<div class="card-body">';
        html += '<div class="row g-3 mb-4">';
        html += '<div class="col-md-6"><i class="bi bi-person-badge text-primary me-2"></i><strong>Student ID:</strong><br/><span class="ms-4">' + details.studentId + '</span></div>';
        html += '<div class="col-md-6"><i class="bi bi-person text-primary me-2"></i><strong>Student Name:</strong><br/><span class="ms-4">' + details.studentName + '</span></div>';
        html += '<div class="col-12"><i class="bi bi-envelope text-primary me-2"></i><strong>Email:</strong><br/><span class="ms-4">' + details.email + '</span></div>';
        html += '</div>';
        html += '<div class="mb-3"><strong>Attendance Rate:</strong></div>';
        html += '<div class="progress" style="height: 30px;">';
        html += '<div class="progress-bar bg-' + (rate >= 80 ? 'success' : (rate >= 60 ? 'warning' : 'danger')) + '" role="progressbar" style="width: ' + rate + '%" aria-valuenow="' + rate + '" aria-valuemin="0" aria-valuemax="100">';
        html += '<strong>' + details.attendanceRate + '</strong></div></div>';
        html += '<div class="row g-3 mt-3 text-center">';
        html += '<div class="col-4"><div class="p-3 bg-white rounded"><div class="fs-2 fw-bold text-primary">' + details.totalClasses + '</div><small class="text-muted">Total Classes</small></div></div>';
        html += '<div class="col-4"><div class="p-3 bg-white rounded"><div class="fs-2 fw-bold text-success">' + details.presentCount + '</div><small class="text-muted">Present</small></div></div>';
        html += '<div class="col-4"><div class="p-3 bg-white rounded"><div class="fs-2 fw-bold text-danger">' + details.absentCount + '</div><small class="text-muted">Absent</small></div></div>';
        html += '</div>';
        html += '</div></div>';
        return html;
    }
</script>

