@model IEnumerable<WebMobileAssignment.Models.Attendance>

@{
    ViewBag.Title = "Student Attendance History";
    ViewBag.ActiveMenu = "Attendance";
    ViewBag.ActiveSubmenu = "StudAttendanceHistory";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    // Prepare distinct subjects for the Subject filter
    var subjectNames = Model?
        .Select(a => a.Class?.Subject?.SubjectName ?? string.Empty)
        .Where(n => !string.IsNullOrEmpty(n))
        .Distinct()
        .OrderBy(n => n)
        .ToList() ?? new List<string>();
}

<div class="dashboard-card mb-4">

    <!-- Header -->
    <div class="card-header-custom d-flex align-items-center justify-content-between">
        <h3 class="card-title">
            <i class="bi bi-clock-history"></i>
            Attendance History
        </h3>

        <div class="d-flex gap-2 align-items-center">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input id="tableSearch" type="text" class="form-control"
                       placeholder="Search (class, subject)" />
            </div>

            <button id="exportExcelBtn" class="btn btn-sm btn-success">
                <i class="bi bi-file-earmark-excel"></i> Excel
            </button>

            <button id="exportPdfBtn" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-file-earmark-pdf"></i> PDF
            </button>
        </div>
    </div>

    <!-- Summary Section -->
    <div class="mb-4">
        <h6 class="mb-2">Summary</h6>
        <div class="row g-2">
            <div class="col-md-4 col-sm-6">
                <div class="text-white text-center py-2 px-2 rounded" style="background-color: #28a745;">
                    <div class="small fw-bold">Present</div>
                    <div class="fs-5 fw-bold" id="summaryPresent">0</div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="text-white text-center py-2 px-2 rounded" style="background-color: #dc3545;">
                    <div class="small fw-bold">Absent</div>
                    <div class="fs-5 fw-bold" id="summaryAbsent">0</div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="text-white text-center py-2 px-2 rounded" style="background-color: #17a2b8;">
                    <div class="small fw-bold">Leave</div>
                    <div class="fs-5 fw-bold" id="summaryLeave">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label">Subject</label>
            <select id="filterSubject" class="form-select">
                <option value="">All Subjects</option>
                @foreach (var sn in subjectNames)
                {
                    <option value="@sn">@sn</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Date</label>
            <input id="filterDate" type="date" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Status</label>
            <select id="filterStatus" class="form-select">
                <option value="">All Status</option>
                <option>Present</option>
                <option>Absent</option>
                <option>Leave</option>
            </select>
        </div>
    </div>

    <!-- Attendance Table -->
    <div class="table-responsive">
        <table id="attendanceTable" class="table table-hover align-middle" style="background-color: #f8f9fa;">
            <thead style="background-color: #e9ecef;">
                <tr>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Class</th>
                    <th>Subject</th>
                    <th>Time Taken</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody style="background-color: #f8f9fa;">
                @if (Model != null && Model.Any())
                {
                    foreach (var a in Model.OrderByDescending(x => x.Date))
                    {
                        var dateStr = a.Date.ToString("yyyy-MM-dd");
                        var dayStr = a.Date.DayOfWeek.ToString();
                        var className = a.Class?.ClassName ?? "-";
                        var subjectName = a.Class?.Subject?.SubjectName ?? "-";
                        // Use 24-hour format (HH:mm) for cleaner display
                        var timeTaken = a.TakenOn != default ? a.TakenOn.ToString("HH:mm") : "-";

                        string badgeClass = a.Status switch
                        {
                            "Present" => "bg-success",
                            "Late" => "bg-warning text-dark",
                            "Absent" => "bg-danger",
                            "Leave" => "bg-info",
                            _ => "bg-light text-dark"
                        };
                <tr data-fulldate="@dateStr" data-class="@className" data-subject="@subjectName" data-status="@a.Status" data-time="@timeTaken">
                    <td>@dateStr</td>
                    <td>@dayStr</td>
                    <td>@className</td>
                    <td>@subjectName</td>
                    <td class="time-taken" data-rawtime="@timeTaken">@timeTaken</td>
                    <td><span class="badge @badgeClass">@a.Status</span></td>
                </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No attendance records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {

<!-- Excel -->
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<!-- PDF generation now handled server-side with QuestPDF -->

<script>
        // -------- UPDATE SUMMARY COUNTS --------
        function updateSummary() {
            let presentCount = 0, absentCount = 0, leaveCount = 0;
            
            const rows = document.querySelectorAll("#attendanceTable tbody tr");
            rows.forEach(row => {
                // Skip "no records" row and hidden rows
                if (row.querySelectorAll("td").length === 1 || row.style.display === "none") {
                    return;
                }
                
                const status = row.dataset.status || "";
                if (status === "Present") presentCount++;
                else if (status === "Absent") absentCount++;
                else if (status === "Leave") leaveCount++;
            });
            
            document.getElementById("summaryPresent").textContent = presentCount;
            document.getElementById("summaryAbsent").textContent = absentCount;
            document.getElementById("summaryLeave").textContent = leaveCount;
        }

        // -------- CLIENT FILTERING --------
        function applyFilters() {
            const search = document.getElementById("tableSearch").value.trim().toLowerCase();
            const subjectFilter = document.getElementById("filterSubject").value;
            const dateFilter = document.getElementById("filterDate").value; // yyyy-MM-dd
            const statusFilter = document.getElementById("filterStatus").value;

            const rows = document.querySelectorAll("#attendanceTable tbody tr");
            rows.forEach(row => {
                // If this is the "no records" row keep it for later
                if (row.querySelectorAll("td").length === 1) {
                    row.style.display = "none";
                    return;
                }

                const rowSubject = (row.dataset.subject || "").toLowerCase();
                const rowStatus = (row.dataset.status || "");
                const rowFullDate = row.dataset.fulldate || ""; // yyyy-MM-dd
                const rowText = row.innerText.toLowerCase();

                let visible = true;

                if (search && !rowText.includes(search)) visible = false;
                if (subjectFilter && rowSubject !== subjectFilter.toLowerCase()) visible = false;
                if (dateFilter && rowFullDate !== dateFilter) visible = false;
                if (statusFilter && rowStatus !== statusFilter) visible = false;

                row.style.display = visible ? "" : "none";
            });

            // show "no records" row if none visible
            const anyVisible = Array.from(document.querySelectorAll("#attendanceTable tbody tr"))
                .some(r => r.style.display !== "none" && r.querySelectorAll("td").length > 1);

            let noRow = document.querySelector("#attendanceTable tbody tr.no-records");
            if (!noRow) {
                noRow = document.createElement("tr");
                noRow.classList.add("no-records");
                noRow.innerHTML = '<td colspan="6" class="text-center">No attendance records found.</td>';
                document.querySelector("#attendanceTable tbody").appendChild(noRow);
            }
            noRow.style.display = anyVisible ? "none" : "";
            
            // Update summary after filtering
            updateSummary();
        }

        document.getElementById("tableSearch").addEventListener("input", applyFilters);
        document.getElementById("filterSubject").addEventListener("change", applyFilters);
        document.getElementById("filterDate").addEventListener("change", applyFilters);
        document.getElementById("filterStatus").addEventListener("change", applyFilters);

        // initial filter pass
        applyFilters();

        // -------- EXCEL EXPORT (Only visible rows) --------
        document.getElementById("exportExcelBtn").addEventListener("click", function () {
            // Get visible rows only
            const table = document.getElementById("attendanceTable");
            const visibleRows = [];
            
            // Add header row
            const headerRow = [];
            table.querySelectorAll("thead th").forEach(th => {
                headerRow.push(th.textContent.trim());
            });
            visibleRows.push(headerRow);
            
            // Add visible data rows - use data attributes for time to avoid encoding issues
            table.querySelectorAll("tbody tr").forEach(row => {
                if (row.style.display !== "none" && row.querySelectorAll("td").length > 1) {
                    const rowData = [];
                    const cells = row.querySelectorAll("td");
                    
                    // Date (index 0)
                    rowData.push(cells[0].textContent.trim());
                    // Day (index 1)
                    rowData.push(cells[1].textContent.trim());
                    // Class (index 2)
                    rowData.push(cells[2].textContent.trim());
                    // Subject (index 3)
                    rowData.push(cells[3].textContent.trim());
                    // Time Taken (index 4) - get from data-rawtime attribute on the cell
                    const timeCell = cells[4];
                    rowData.push(timeCell.dataset.rawtime || timeCell.textContent.trim());
                    // Status (index 5) - get from badge
                    const badge = cells[5].querySelector('.badge');
                    rowData.push(badge ? badge.textContent.trim() : cells[5].textContent.trim());
                    
                    visibleRows.push(rowData);
                }
            });
            
            // Create workbook
            const ws = XLSX.utils.aoa_to_sheet(visibleRows);
            
            // Set column widths
            ws['!cols'] = [
                { wch: 12 },  // Date
                { wch: 12 },  // Day
                { wch: 15 },  // Class
                { wch: 20 },  // Subject
                { wch: 12 },  // Time Taken
                { wch: 10 }   // Status
            ];
            
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Attendance History");
            
            // Generate filename with date
            const today = new Date().toISOString().split('T')[0];
            XLSX.writeFile(wb, `attendance-history-${today}.xlsx`);
        });

        // -------- PDF EXPORT (Server-side with QuestPDF) --------
        document.getElementById("exportPdfBtn").addEventListener("click", function () {
            // Get current filter values
            const subjectFilter = document.getElementById("filterSubject").value;
            const dateFilter = document.getElementById("filterDate").value;
            const statusFilter = document.getElementById("filterStatus").value;

            // Build query string for filters
            const params = new URLSearchParams();
            if (subjectFilter) params.append('subject', subjectFilter);
            if (dateFilter) params.append('date', dateFilter);
            if (statusFilter) params.append('status', statusFilter);

            // Redirect to PDF export endpoint
            const url = '@Url.Action("ExportAttendanceHistoryPdf", "Student")' + 
                        (params.toString() ? '?' + params.toString() : '');
            window.open(url, '_blank');
        });

