@model WebMobileAssignment.Models.Class
@{
    ViewBag.Title = "Class Attendance Detail";
    ViewBag.ActiveMenu = "Attendance";
    ViewBag.ActiveSubmenu = "MarkAttendance";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    
    var allSessions = ViewBag.AllSessions as List<WebMobileAssignment.Models.AttendanceSession> ?? new List<WebMobileAssignment.Models.AttendanceSession>();
    var sessions = ViewBag.Sessions as List<WebMobileAssignment.Models.AttendanceSession> ?? new List<WebMobileAssignment.Models.AttendanceSession>();
    
    // Get selected date from ViewBag, default to today
    var selectedDate = ViewBag.SelectedDate as DateTime? ?? DateTime.Today;
    var selectedDay = selectedDate.DayOfWeek.ToString();
    var isSelectedDate = !string.IsNullOrEmpty(Model.Day) && Model.Day.Equals(selectedDay, StringComparison.OrdinalIgnoreCase);
    
    // Check for session created on selected date ONLY
    var sessionOnSelectedDate = sessions.FirstOrDefault(s => s.ClassId == Model.ClassId && s.CreatedDate.Date == selectedDate.Date);
    var hasValidSession = sessionOnSelectedDate != null;
    
    // Check if PIN is expired (after class end time on the same day)
    var isPinExpired = false;
    if (hasValidSession && Model.EndTime.HasValue && selectedDate.Date == DateTime.Today)
    {
        var nowTime = DateTime.Now.TimeOfDay;
        isPinExpired = nowTime > Model.EndTime.Value;
    }
    
    var todayAttendances = ViewBag.TodayAttendances as List<WebMobileAssignment.Models.Attendance> ?? new List<WebMobileAssignment.Models.Attendance>();
    
    var todayDay = DateTime.Now.DayOfWeek.ToString();
    var isToday = !string.IsNullOrEmpty(Model.Day) && Model.Day.Equals(todayDay, StringComparison.OrdinalIgnoreCase) && selectedDate.Date == DateTime.Today;
    
    var currentTime = DateTime.Now.TimeOfDay;
    var isActive = Model.StartTime.HasValue && Model.EndTime.HasValue && 
                   currentTime >= Model.StartTime.Value && currentTime <= Model.EndTime.Value &&
                   selectedDate.Date == DateTime.Today;
    
    // Use filtered enrollments - only students enrolled on or before the selected date
    var filteredEnrollments = ViewBag.FilteredEnrollments as List<WebMobileAssignment.Models.Enrollment> ?? Model.Enrollments.ToList();
    var filteredEnrollmentCount = filteredEnrollments.Count;
}

<!-- Header Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1">
                    <i class="bi bi-book text-primary me-2"></i>
                    @Model.ClassName - Attendance
                </h5>
                <p class="text-muted small mb-0">@selectedDate.ToString("dddd, MMMM dd, yyyy")</p>
            </div>
            <a href="@Url.Action("TeachMarkAttendance", new { selectedDate = selectedDate.ToString("yyyy-MM-dd") })" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Classes
            </a>
        </div>
    </div>
</div>

<!-- Class Information -->
<div class="row mb-4">
    <div class="col-lg-8">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h6 class="card-title mb-0">
                    <i class="bi bi-info-circle me-2"></i>Class Information
                </h6>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="info-box">
                            <div class="info-label">Class ID</div>
                            <div class="info-value">@Model.ClassId</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-box">
                            <div class="info-label">Class Name</div>
                            <div class="info-value">@Model.ClassName</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-box">
                            <div class="info-label">Schedule</div>
                            <div class="info-value">
                                @if (Model.StartTime.HasValue && Model.EndTime.HasValue)
                                {
                                    <span>@Model.Day - @Model.StartTime.Value.ToString("hh\\:mm") to @Model.EndTime.Value.ToString("hh\\:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not scheduled</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-box">
                            <div class="info-label">Room</div>
                            <div class="info-value">@(Model.RoomNumber ?? "Not assigned")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-box">
                            <div class="info-label">Enrolled Students</div>
                            <div class="info-value">@filteredEnrollmentCount students</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-box">
                            <div class="info-label">Status</div>
                            <div class="info-value">
                                @if (selectedDate.Date > DateTime.Today)
                                {
                                    <span class="badge bg-info"><i class="bi bi-calendar-event"></i> Future Date</span>
                                }
                                else if (selectedDate.Date < DateTime.Today)
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-calendar-x"></i> Past Date</span>
                                }
                                else if (isActive)
                                {
                                    <span class="badge bg-success"><i class="bi bi-circle-fill blink"></i> Class in Progress</span>
                                }
                                else if (Model.EndTime.HasValue && currentTime > Model.EndTime.Value)
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-check-circle"></i> Class Ended</span>
                                }
                                else
                                {
                                    <span class="badge bg-info"><i class="bi bi-clock"></i> Upcoming</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PIN Generation Card -->
    <div class="col-lg-4">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h6 class="card-title mb-0">
                    <i class="bi bi-key me-2"></i>Attendance PIN
                </h6>
            </div>
            <div class="p-4 text-center">
                @if (!isSelectedDate)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle mb-2" style="font-size: 2rem;"></i>
                        <p class="mb-0 small"><strong>Not Scheduled for This Date</strong></p>
                        <p class="mb-0 small">This class is scheduled for <strong>@Model.Day</strong>, not @selectedDay.</p>
                    </div>
                }
                else if (hasValidSession)
                {
                    <!-- Show existing PIN (valid for the selected date) -->
                    @if (isPinExpired || selectedDate.Date < DateTime.Today)
                    {
                        <!-- PIN exists but expired (past date or class ended) -->
                        <div class="pin-display-large" style="position: relative; opacity: 0.7;">
                            <div class="pin-label">6-DIGIT PIN CODE</div>
                            @if (sessionOnSelectedDate != null)
                            {
                                <div class="pin-code">@sessionOnSelectedDate.PinCode</div>
                            }
                            
                            <!-- Red overlay with EXPIRED text -->
                            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(220, 53, 69, 0.6); border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                                <div style="font-size: 2.5rem; font-weight: bold; color: white; letter-spacing: 2px;">EXPIRED</div>
                                <div style="font-size: 0.9rem; color: white; margin-top: 8px;">@(selectedDate.Date < DateTime.Today ? "Class date has passed" : "Class ended")</div>
                            </div>
                        </div>
                        
                        @if (sessionOnSelectedDate != null)
                        {
                            <div class="alert alert-secondary mt-2 mb-0">
                                <i class="bi bi-info-circle"></i>
                                <small>
                                    Generated by @(sessionOnSelectedDate.CreatedByTeacherId == null ? "Admin" : "You")
                                </small>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- PIN is active -->
                        <div class="pin-display-large">
                            <div class="pin-label">6-DIGIT PIN CODE</div>
                            @if (sessionOnSelectedDate != null)
                            {
                                <div class="pin-code">@sessionOnSelectedDate.PinCode</div>
                                @if (sessionOnSelectedDate.CreatedByTeacherId == null)
                                {
                                    <div class="badge bg-info mt-2">
                                        <i class="bi bi-shield-check"></i> Generated by Admin
                                    </div>
                                }
                                else
                                {
                                    <div class="badge bg-success mt-2">
                                        <i class="bi bi-person-check"></i> Generated by You
                                    </div>
                                }
                            }
                            <button id="copyPinBtn" class="btn btn-outline-light btn-sm mt-2">
                                <i class="bi bi-clipboard"></i> Copy PIN
                            </button>
                        </div>
                        
                        <div class="qr-display mt-3">
                            <div class="qr-label mb-2">SCAN QR CODE</div>
                            <div id="qrCodeContainer" class="qr-container"></div>
                            <small class="text-muted d-block mt-2">
                                <i class="bi bi-info-circle"></i> Students scan to mark attendance
                            </small>
                        </div>

                        @if (selectedDate.Date == DateTime.Today && Model.EndTime.HasValue)
                        {
                            <div class="alert alert-success mt-3 mb-0">
                                <i class="bi bi-check-circle"></i>
                                <small>PIN is active until @Model.EndTime.Value.ToString("hh\\:mm") (class ends)</small>
                            </div>
                        }
                    }
                }
                else if (selectedDate.Date > DateTime.Today)
                {
                    <!-- Future date -->
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-calendar-event mb-2" style="font-size: 2rem;"></i>
                        <p class="mb-0 small"><strong>Future Date</strong></p>
                        <p class="mb-0 small">PIN can only be generated on the actual class date.</p>
                    </div>
                }
                else if (selectedDate.Date < DateTime.Today)
                {
                    <!-- Past date with no PIN -->
                    <div class="alert alert-secondary mb-0">
                        <i class="bi bi-calendar-x mb-2" style="font-size: 2rem;"></i>
                        <p class="mb-0 small"><strong>No PIN Generated</strong></p>
                        <p class="mb-0 small">No PIN was generated for this past date (@selectedDate.ToString("MMM dd, yyyy")).</p>
                    </div>
                }
                else if (!isActive)
                {
                    <!-- Today but class not active -->
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-clock mb-2" style="font-size: 2rem;"></i>
                        <p class="mb-0 small"><strong>Class Not Active</strong></p>
                        <p class="mb-0 small">PIN can only be generated during class hours.</p>
                        @if (Model.StartTime.HasValue && currentTime < Model.StartTime.Value)
                        {
                            <p class="mb-0 small mt-2">Starts at <strong>@Model.StartTime.Value.ToString("hh\\:mm")</strong></p>
                        }
                        else if (Model.EndTime.HasValue)
                        {
                            <p class="mb-0 small mt-2">Class ended at <strong>@Model.EndTime.Value.ToString("hh\\:mm")</strong></p>
                        }
                    </div>
                }
                else
                {
                    <!-- Generate PIN Button (only for today during class hours) -->
                    <div class="generate-section">
                        <i class="bi bi-key-fill mb-3" style="font-size: 3rem; color: #6366f1;"></i>
                        <p class="mb-3"><strong>Ready to Take Attendance</strong></p>
                        <p class="text-muted small mb-3">Generate a PIN code for students to mark their attendance.</p>
                        <button id="generatePinBtn" class="btn btn-primary w-100" 
                                data-class-id="@Model.ClassId">
                            <i class="bi bi-key-fill me-2"></i>Generate PIN Code
                        </button>
                        <p class="text-muted small mt-2 mb-0">
                            <i class="bi bi-info-circle"></i> PIN can only be generated once per day
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Manual Attendance Taking -->
<div class="row">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom d-flex justify-content-between align-items-center">
                <h6 class="card-title mb-0">
                    <i class="bi bi-people me-2"></i>Enrolled Students (@filteredEnrollmentCount)
                </h6>
                <div>
                    <button id="checkAllBtn" class="btn btn-sm btn-outline-success me-2">
                        <i class="bi bi-check-all"></i> Check All
                    </button>
                    <button id="uncheckAllBtn" class="btn btn-sm btn-outline-secondary me-2">
                        <i class="bi bi-x"></i> Uncheck All
                    </button>
                    <span id="savingIndicator" class="text-muted small" style="display: none;">
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        Saving...
                    </span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 attendance-table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">
                                <input type="checkbox" id="selectAllCheckbox" class="form-check-input" />
                            </th>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="studentList">
                        @if (filteredEnrollments != null && filteredEnrollments.Any())
                        {
                            @foreach (var enrollment in filteredEnrollments.OrderBy(e => e.Student.User.FullName))
                            {
                                var attendance = todayAttendances.FirstOrDefault(a => a.StudentId == enrollment.Student.StudentId);
                                var isPresent = attendance != null && attendance.Status == "Present";
                                var hasMarkedAttendance = attendance != null;
                                
                                <tr data-student-id="@enrollment.Student.StudentId">
                                    <td>
                                        <input type="checkbox" 
                                               class="form-check-input student-checkbox" 
                                               data-student-id="@enrollment.Student.StudentId"
                                               @(isPresent ? "checked" : "")
                                               @(hasMarkedAttendance ? "data-existing='true'" : "")
                                               @(attendance != null && attendance.Status == "Leave" ? "disabled" : "") />
                                    </td>
                                    <td><strong>@enrollment.Student.StudentId</strong></td>
                                    <td>@enrollment.Student.User.FullName</td>
                                    <td>@enrollment.Student.User.Email</td>
                                    <td>
                                        <span class="status-badge" data-student-id="@enrollment.Student.StudentId">
                                            @if (attendance != null)
                                            {
                                                @if (attendance.Status == "Present")
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-check-circle"></i> Present
                                                    </span>
                                                }
                                                else if (attendance.Status == "Late")
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="bi bi-clock-history"></i> Late
                                                    </span>
                                                }
                                                else if (attendance.Status == "Absent")
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-x-circle"></i> Absent
                                                    </span>
                                                }
                                                else if (attendance.Status == "Leave")
                                                {
                                                    <span class="badge bg-info">
                                                        <i class="bi bi-calendar-check"></i> Leave
                                                    </span>
                                                }
                                                else if (attendance.Status == "Not Marked")
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="bi bi-dash-circle"></i> Not Marked
                                                    </span>
                                                }
                                                @if (attendance.Flag)
                                                {
                                                    <i class="bi bi-flag-fill text-danger ms-2" title="Duplicate IP detected"></i>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-dash-circle"></i> Not Marked
                                                </span>
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">No students enrolled as of @selectedDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Load QRCode library from CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    
    <script>
        $(document).ready(function() {
            console.log("Teacher attendance script loaded");
            
            const classId = '@Model.ClassId';
            const selectedDate = '@selectedDate.ToString("yyyy-MM-dd")';
            const hasValidSession = @hasValidSession.ToString().ToLower();
            const isPinExpired = @isPinExpired.ToString().ToLower();
            
            console.log("ClassId:", classId, "SelectedDate:", selectedDate);
            
            // Batch save queue to prevent concurrent requests
            let saveQueue = [];
            let isSaving = false;
            
            // Only generate QR code if PIN exists and is not expired
            if (hasValidSession && !isPinExpired) {
                // Generate QR Code - Redirect to STUDENT page
                const request = window.location;
                const baseUrl = `${request.protocol}//${request.host}`;
                const qrUrl = `${baseUrl}/Student/StudTakeAttendance?pin=@(sessionOnSelectedDate?.PinCode ?? "")`;

                // Clear any existing QR code first
                document.getElementById("qrCodeContainer").innerHTML = "";

                // Generate new QR code
                new QRCode(document.getElementById("qrCodeContainer"), {
                    text: qrUrl,
                    width: 200,
                    height: 200,
                    colorDark: "#000000",
                    colorLight: "#ffffff",
                    correctLevel: QRCode.CorrectLevel.H
                });
                
                console.log("QR Code generated for URL:", qrUrl);
            }

            // Copy PIN button
            $('#copyPinBtn').click(function() {
                const pin = $('.pin-code').text().trim();
                navigator.clipboard.writeText(pin).then(function() {
                    $('#copyPinBtn').html('<i class="bi bi-check"></i> Copied!');
                    setTimeout(() => {
                        $('#copyPinBtn').html('<i class="bi bi-clipboard"></i> Copy PIN');
                    }, 2000);
                });
            });

            // Generate PIN button
            $('#generatePinBtn').click(function() {
                const btn = $(this);

                if (!confirm('Generate PIN code for this class? This can only be done once per day.')) {
                    return;
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Generating...');

                $.ajax({
                    url: '@Url.Action("GenerateAttendancePin", "Teacher")',
                    type: 'POST',
                    data: { classId: classId },
                    success: function(response) {
                        if (response.success) {
                            alert('PIN generated successfully! The page will reload.');
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                            btn.prop('disabled', false).html('<i class="bi bi-key-fill me-2"></i>Generate PIN Code');
                        }
                    },
                    error: function() {
                        alert('Failed to generate PIN. Please try again.');
                        btn.prop('disabled', false).html('<i class="bi bi-key-fill me-2"></i>Generate PIN Code');
                    }
                });
            });

            // Process save queue sequentially
            function processSaveQueue() {
                if (isSaving || saveQueue.length === 0) {
                    return;
                }
                
                isSaving = true;
                $('#savingIndicator').show();
                
                const item = saveQueue.shift();
                const { studentId, status, checkbox, row, statusBadge, originalChecked } = item;
                
                // Disable checkbox while saving
                checkbox.prop('disabled', true);

                // Save attendance via AJAX
                $.ajax({
                    url: '@Url.Action("SaveTeacherAttendance", "Teacher")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        classId: classId,
                        studentId: studentId,
                        date: selectedDate,
                        status: status
                    }),
                    success: function(response) {
                        if (response.success) {
                            // Update status badge
                            if (status === 'Present') {
                                statusBadge.html('<span class="badge bg-success"><i class="bi bi-check-circle"></i> Present</span>');
                            } else {
                                statusBadge.html('<span class="badge bg-danger"><i class="bi bi-x-circle"></i> Absent</span>');
                            }
                            
                            // Show success animation
                            row.addClass('table-success');
                            setTimeout(() => {
                                row.removeClass('table-success');
                            }, 500);
                            
                            console.log(`Attendance saved: ${studentId} - ${status}`);
                        } else {
                            console.error('Error:', response.message);
                            // Revert checkbox
                            checkbox.prop('checked', originalChecked);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('AJAX Error:', error);
                        // Revert checkbox
                        checkbox.prop('checked', originalChecked);
                    },
                    complete: function() {
                        // Re-enable checkbox
                        checkbox.prop('disabled', false);
                        isSaving = false;
                        
                        // Process next item in queue
                        if (saveQueue.length > 0) {
                            setTimeout(processSaveQueue, 200); // Small delay between requests
                        } else {
                            $('#savingIndicator').hide();
                        }
                    }
                });
            }

            // Auto-save attendance on checkbox change
            $('.student-checkbox').on('change', function() {
                console.log("Individual checkbox changed");
                const checkbox = $(this);
                const studentId = checkbox.data('student-id');
                const isChecked = checkbox.is(':checked');
                const status = isChecked ? 'Present' : 'Absent';
                const row = checkbox.closest('tr');
                const statusBadge = row.find('.status-badge[data-student-id="' + studentId + '"]');
                
                console.log("Student:", studentId, "Status:", status);
                
                // Get original state to revert if needed
                const originalChecked = !isChecked;
                
                // Add to save queue
                saveQueue.push({
                    studentId: studentId,
                    status: status,
                    checkbox: checkbox,
                    row: row,
                    statusBadge: statusBadge,
                    originalChecked: originalChecked
                });
                
                // Start processing queue
                processSaveQueue();
            });

            // Select all checkbox with batch processing
            $('#selectAllCheckbox').on('change', function() {
                console.log("Select All checkbox toggled");
                const isChecked = $(this).is(':checked');
                console.log("Select All checked:", isChecked);
                
                // Collect all students that need status change (skip disabled checkboxes)
                const studentsToMark = [];
                $('.student-checkbox:not(:disabled)').each(function() {
                    const checkbox = $(this);
                    const currentlyChecked = checkbox.is(':checked');
                    
                    // Only process if state is different
                    if (currentlyChecked !== isChecked) {
                        const studentId = checkbox.data('student-id');
                        studentsToMark.push({
                            studentId: studentId,
                            status: isChecked ? 'Present' : 'Absent'
                        });
                        checkbox.prop('checked', isChecked);
                    }
                });
                
                console.log("Students to mark:", studentsToMark.length);
                
                if (studentsToMark.length === 0) {
                    return;
                }
                
                // Use batch save endpoint
                $('#savingIndicator').show();
                $('.student-checkbox').prop('disabled', true);
                
                $.ajax({
                    url: '@Url.Action("SaveTeacherManualAttendance", "Teacher")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        classId: classId,
                        date: selectedDate,
                        attendances: studentsToMark
                    }),
                    success: function(response) {
                        if (response.success) {
                            console.log(`Batch saved ${response.marked} student(s)`);
                            
                            // Update all status badges
                            studentsToMark.forEach(item => {
                                const row = $(`tr[data-student-id="${item.studentId}"]`);
                                const statusBadge = row.find('.status-badge');
                                
                                if (item.status === 'Present') {
                                    statusBadge.html('<span class="badge bg-success"><i class="bi bi-check-circle"></i> Present</span>');
                                    row.addClass('table-success');
                                } else {
                                    statusBadge.html('<span class="badge bg-danger"><i class="bi bi-x-circle"></i> Absent</span>');
                                    row.addClass('table-danger');
                                }
                            });
                            
                            setTimeout(() => {
                                $('.table-success, .table-danger').removeClass('table-success table-danger');
                            }, 1000);
                            
                            // Show success message
                            const badgeClass = isChecked ? 'success' : 'warning';
                            const icon = isChecked ? 'check-circle' : 'x-circle';
                            const statusText = isChecked ? 'present' : 'absent';
                            
                            const toast = $(`<div class="alert alert-${badgeClass} alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 9999;">` +
                                `<i class="bi bi-${icon} me-2"></i>` +
                                `Marked ${response.marked} student(s) as ${statusText}` +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                '</div>');
                            
                            $('body').append(toast);
                            setTimeout(() => toast.remove(), 3000);
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('Failed to save attendance. Please try again.');
                    },
                    complete: function() {
                        $('.student-checkbox').prop('disabled', false);
                        $('#savingIndicator').hide();
                    }
                });
            });

            // Check all button - marks ALL students as Present
            $('#checkAllBtn').on('click', function() {
                console.log("Check All button clicked");
                // Collect ALL students and mark them as present (skip disabled checkboxes)
                const studentsToMark = [];
                $('.student-checkbox:not(:disabled)').each(function() {
                    const studentId = $(this).data('student-id');
                    studentsToMark.push({
                        studentId: studentId,
                        status: 'Present'
                    });
                    // Check all boxes visually
                    $(this).prop('checked', true);
                });
                
                console.log("Students found:", studentsToMark.length);
                
                if (studentsToMark.length === 0) {
                    alert('No students found to mark as present');
                    return;
                }
                
                $('#selectAllCheckbox').prop('checked', true);
                
                // Use batch save endpoint
                $('#savingIndicator').show();
                $('.student-checkbox').prop('disabled', true);
                
                $.ajax({
                    url: '@Url.Action("SaveTeacherManualAttendance", "Teacher")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        classId: classId,
                        date: selectedDate,
                        attendances: studentsToMark
                    }),
                    success: function(response) {
                        if (response.success) {
                            console.log(`Batch saved ${response.marked} student(s)`);
                            
                            // Update all status badges
                            studentsToMark.forEach(item => {
                                const row = $(`tr[data-student-id="${item.studentId}"]`);
                                const statusBadge = row.find('.status-badge');
                                statusBadge.html('<span class="badge bg-success"><i class="bi bi-check-circle"></i> Present</span>');
                                row.addClass('table-success');
                            });
                            
                            setTimeout(() => {
                                $('.table-success').removeClass('table-success');
                            }, 1000);
                            
                            // Show success message
                            const toast = $('<div class="alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 9999;">' +
                                '<i class="bi bi-check-circle me-2"></i>' +
                                `Successfully marked ${response.marked} student(s) as present` +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                '</div>');
                            
                            $('body').append(toast);
                            setTimeout(() => toast.remove(), 3000);
                        } else {
                            alert('Error: ' + response.message);
                            // Revert checkboxes on error
                            location.reload();
                        }
                    },
                    error: function() {
                        alert('Failed to save attendance. Please try again.');
                        location.reload();
                    },
                    complete: function() {
                        $('.student-checkbox').prop('disabled', false);
                        $('#savingIndicator').hide();
                    }
                });
            });

            // Uncheck all button - marks ALL students as Absent
            $('#uncheckAllBtn').on('click', function() {
                console.log("Uncheck All button clicked");
                // Collect ALL students and mark them as absent (skip disabled checkboxes)
                const studentsToMark = [];
                $('.student-checkbox:not(:disabled)').each(function() {
                    const studentId = $(this).data('student-id');
                    studentsToMark.push({
                        studentId: studentId,
                        status: 'Absent'
                    });
                    // Uncheck all boxes visually
                    $(this).prop('checked', false);
                });
                
                console.log("Students found:", studentsToMark.length);
                
                if (studentsToMark.length === 0) {
                    alert('No students found to mark as absent');
                    return;
                }
                
                $('#selectAllCheckbox').prop('checked', false);
                
                // Use batch save endpoint
                $('#savingIndicator').show();
                $('.student-checkbox').prop('disabled', true);
                
                $.ajax({
                    url: '@Url.Action("SaveTeacherManualAttendance", "Teacher")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        classId: classId,
                        date: selectedDate,
                        attendances: studentsToMark
                    }),
                    success: function(response) {
                        if (response.success) {
                            console.log(`Batch saved ${response.marked} student(s) as absent`);
                            
                            // Update all status badges
                            studentsToMark.forEach(item => {
                                const row = $(`tr[data-student-id="${item.studentId}"]`);
                                const statusBadge = row.find('.status-badge');
                                statusBadge.html('<span class="badge bg-danger"><i class="bi bi-x-circle"></i> Absent</span>');
                                row.addClass('table-danger');
                            });
                            
                            setTimeout(() => {
                                $('.table-danger').removeClass('table-danger');
                            }, 1000);
                            
                            // Show success message
                            const toast = $('<div class="alert alert-warning alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 9999;">' +
                                '<i class="bi bi-x-circle me-2"></i>' +
                                `Marked ${response.marked} student(s) as absent` +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                '</div>');
                            
                            $('body').append(toast);
                            setTimeout(() => toast.remove(), 3000);
                        } else {
                            alert('Error: ' + response.message);
                            location.reload();
                        }
                    },
                    error: function() {
                        alert('Failed to save attendance. Please try again.');
                        location.reload();
                    },
                    complete: function() {
                        $('.student-checkbox').prop('disabled', false);
                        $('#savingIndicator').hide();
                    }
                });
            });
            
            // Log that all event handlers are attached
            console.log("All event handlers attached successfully");
            console.log("Student checkboxes found:", $('.student-checkbox').length);
            console.log("Check All button found:", $('#checkAllBtn').length);
            console.log("Uncheck All button found:", $('#uncheckAllBtn').length);
            console.log("Select All checkbox found:", $('#selectAllCheckbox').length);
        });
    </script>
}

