@using WebMobileAssignment.Models;
@{
    ViewBag.Title = "Students";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="row g-3">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-people-fill"></i>
                    Students
                </h3>
            </div>

            <!-- Filters -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <label class="form-label">Search by Name</label>
                    <input type="text" class="form-control" placeholder="Enter student name..." id="searchName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Search by ID</label>
                    <input type="text" class="form-control" placeholder="Enter student ID..." id="searchId" />
                </div>
            </div>

            <!-- Students List -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th>Classes Enrolled</th>
                            <th>Parent Name</th>
                            <th>Attendance Rate</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Students != null && ((List<Student>)ViewBag.Students).Count > 0)
                        {
                            @foreach (var student in (List<Student>)ViewBag.Students)
                            {
                                var classCount = student.Enrollments?.Count ?? 0;
                                var totalAttendance = student.Enrollments?.SelectMany(e => e.Class.Attendances)
                                    .Where(a => a.StudentId == student.StudentId).ToList() ?? new List<Attendance>();
                                var attendanceRate = totalAttendance.Count > 0
                                    ? Math.Round((decimal)(totalAttendance.Count(a => a.Status == "Present") * 100) / totalAttendance.Count(), 2)
                                    : 0;
                                var badgeClass = attendanceRate >= 90 ? "bg-success" : attendanceRate >= 80 ? "bg-warning" : "bg-danger";
                                
                                <tr>
                                    <td>@student.StudentId</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="user-avatar me-2" style="width: 40px; height: 40px;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <span>@student.User?.FullName</span>
                                        </div>
                                    </td>
                                    <td>@classCount</td>
                                    <td>@(student.Parent?.User?.FullName ?? "N/A")</td>
                                    <td><span class="badge @badgeClass">@attendanceRate%</span></td>
                                    <td><span class="badge bg-info">Active</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No students assigned to your classes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Simple client-side filtering
    document.getElementById('searchName').addEventListener('keyup', filterTable);
    document.getElementById('searchId').addEventListener('keyup', filterTable);

    function filterTable() {
        const nameFilter = document.getElementById('searchName').value.toLowerCase();
        const idFilter = document.getElementById('searchId').value.toLowerCase();
        const rows = document.querySelectorAll('tbody tr');

        rows.forEach(row => {
            const cells = row.querySelectorAll('td');
            if (cells.length > 0) {
                const studentId = cells[0].textContent.toLowerCase();
                const studentName = cells[1].textContent.toLowerCase();

                const nameMatch = studentName.includes(nameFilter);
                const idMatch = studentId.includes(idFilter);

                row.style.display = (nameMatch && idMatch) ? '' : 'none';
            }
        });
    }
</script>
