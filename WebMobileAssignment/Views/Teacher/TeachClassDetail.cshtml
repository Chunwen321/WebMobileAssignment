@using WebMobileAssignment.Models;
@model Class
@{
    ViewBag.Title = "Class Details";
    ViewBag.ActiveMenu = "Classes";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-start">
            <div>
                <h1 class="mb-2">@Model?.ClassName</h1>
                <p class="text-muted">
                    @(string.IsNullOrEmpty(Model?.Subject?.SubjectName) ? "Subject Not Set" : Model.Subject.SubjectName)
                </p>
            </div>
            <a asp-controller="Teacher" asp-action="TeachClasses" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Classes
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Class Information -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="dashboard-card">
                <div class="card-header-custom">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle"></i> Class Information
                    </h5>
                </div>
                <div class="info-row">
                    <label class="info-label">Instructor:</label>
                    <span class="info-value">@Model?.Teacher?.User?.FullName</span>
                </div>
                <div class="info-row">
                    <label class="info-label">Class ID:</label>
                    <span class="info-value">@Model?.ClassId</span>
                </div>
                <div class="info-row">
                    <label class="info-label">Venue/Location:</label>
                    <span class="info-value">@(string.IsNullOrEmpty(Model?.RoomNumber) ? "Not Set" : Model.RoomNumber)</span>
                </div>
                @if (Model?.StartTime.HasValue == true && Model?.EndTime.HasValue == true)
                {
                    <div class="info-row">
                        <label class="info-label">Time:</label>
                        <span class="info-value">
                            @Model.StartTime.Value.ToString(@"hh\:mm") - @Model.EndTime.Value.ToString(@"hh\:mm")
                        </span>
                    </div>
                }
                <div class="info-row">
                    <label class="info-label">Enrolled:</label>
                    <span class="info-value">
                        <span class="badge bg-success">@ViewBag.TotalStudents Students</span>
                    </span>
                </div>
                <div class="info-row">
                    <label class="info-label">Status:</label>
                    <span class="info-value">
                        <span class="badge bg-primary">Active</span>
                    </span>
                </div>
            </div>
        </div>

        <!-- Attendance Overview -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="dashboard-card">
                <div class="card-header-custom">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-clipboard-check"></i> Attendance Overview
                    </h5>
                </div>
                @{
                    var attendanceStatsOverview = (List<dynamic>)ViewBag.AttendanceStats ?? new List<dynamic>();
                    var totalSessions = ViewBag.SessionCount ?? 0;
                    var avgAttendance = 0m;
                    
                    if (attendanceStatsOverview.Count > 0)
                    {
                        avgAttendance = Math.Round((decimal)attendanceStatsOverview.Average(s => (decimal)s.Rate), 2);
                    }
                }
                <div class="attendance-stats">
                    <div class="stat-item">
                        <span class="stat-item-label">Average Attendance:</span>
                        <span class="stat-item-value text-success">@avgAttendance%</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-item-label">Total Sessions:</span>
                        <span class="stat-item-value">@totalSessions</span>
                    </div>
                    @if (Model?.Attendances != null)
                    {
                        var absentCount = Model.Attendances.Count(a => a.Status == "Absent");
                        var leaveCount = Model.Attendances.Count(a => a.Status == "Leave");
                        
                        <div class="stat-item">
                            <span class="stat-item-label">Absent:</span>
                            <span class="stat-item-value text-danger">@absentCount</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-item-label">Leave:</span>
                            <span class="stat-item-value text-warning">@leaveCount</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="dashboard-card">
                <div class="card-header-custom">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-lightning"></i> Quick Actions
                    </h5>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Teacher" asp-action="TeachMarkAttendance" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil"></i> Mark Attendance
                    </a>
                    <a asp-controller="Teacher" asp-action="TeachAttendanceHistory" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-history"></i> View History
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Enrolled Students Section -->
    @if (Model?.Enrollments != null && Model.Enrollments.Count > 0)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="dashboard-card">
                    <div class="card-header-custom">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-people"></i> Enrolled Students (@Model.Enrollments.Count)
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th width="5%">#</th>
                                    <th width="20%">Student Name</th>
                                    <th width="15%">Student ID</th>
                                    <th width="15%">Email</th>
                                    <th width="20%">Attendance</th>
                                    <th width="10%">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var attendanceStatsList = (List<dynamic>)ViewBag.AttendanceStats ?? new List<dynamic>();
                                    int studentIndex = 1;
                                }
                                @foreach (var enrollment in Model.Enrollments)
                                {
                                    var stats = attendanceStatsList.FirstOrDefault(s => (string)s.StudentId == enrollment.StudentId);
                                    var attendanceRate = stats != null ? (decimal)stats.Rate : 0;
                                    var badgeClass = attendanceRate >= 90 ? "bg-success" : 
                                                   attendanceRate >= 80 ? "bg-warning" : 
                                                   attendanceRate >= 70 ? "bg-info" : "bg-danger";
                                    var statusBadge = attendanceRate >= 90 ? "bg-success" : 
                                                    attendanceRate >= 75 ? "bg-warning text-dark" : "bg-danger";
                                    
                                    <tr>
                                        <td>@(studentIndex++)</td>
                                        <td><strong>@enrollment.Student?.User?.FullName</strong></td>
                                        <td>@enrollment.Student?.StudentId</td>
                                        <td>@enrollment.Student?.User?.Email</td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar @badgeClass" style="width: @(attendanceRate)%">@attendanceRate%</div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (attendanceRate >= 75)
                                            {
                                                <span class="badge @statusBadge">@(attendanceRate >= 90 ? "Active" : "Warning")</span>
                                            }
                                            else
                                            {
                                                <span class="badge @statusBadge">At Risk</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Recent Sessions -->
    @{
        var sessionsList = ViewBag.Sessions as List<dynamic> ?? new List<dynamic>();
    }
    @if (sessionsList != null && sessionsList.Count > 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="dashboard-card">
                    <div class="card-header-custom">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-calendar-event"></i> Attendance Sessions (@sessionsList.Count)
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th width="25%">Date & Time</th>
                                    <th width="25%">Total Students</th>
                                    <th width="25%">Present</th>
                                    <th width="25%">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in sessionsList)
                                {
                                    var sessionDate = ((DateTime)session.CreatedDate).Date;
                                    var attendanceForDate = Model?.Attendances?
                                        .Where(a => a.Date.Date == sessionDate)
                                        .ToList() ?? new List<Attendance>();
                                    var presentCount = attendanceForDate.Count(a => a.Status == "Present");
                                    var totalCount = attendanceForDate.Count;
                                    var detailsUrl = Url.Action("TeachAttendanceClassDetail", "Teacher", new { id = Model.ClassId, selectedDate = sessionDate.ToString("yyyy-MM-dd") });
                                    
                                    <tr>
                                        <td>
                                            <strong>@((DateTime)session.CreatedDate).ToString("MMM dd, yyyy")</strong><br>
                                            <small class="text-muted">@((DateTime)session.CreatedDate).ToString("HH:mm:ss")</small>
                                        </td>
                                        <td>@ViewBag.TotalStudents</td>
                                        <td><span class="badge bg-success">@presentCount</span></td>
                                        <td>
                                            <a href="@detailsUrl" class="btn btn-sm btn-primary" target="_blank">
                                                <i class="bi bi-eye"></i> View Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (sessionsList == null || sessionsList.Count == 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle"></i> No attendance sessions have been created for this class yet.
                </div>
            </div>
        </div>
    }
</div>

<!-- Styles for Clickable Rows -->
<style>
    .clickable-row {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .clickable-row:hover {
        background-color: #f8f9fa !important;
    }

    .clickable-row:active {
        background-color: #e9ecef !important;
    }

    /* Dark mode styles for clickable rows */
    [data-theme="dark"] .clickable-row:hover {
        background-color: rgba(13, 110, 253, 0.1) !important;
    }

    [data-theme="dark"] .clickable-row:active {
        background-color: rgba(13, 110, 253, 0.15) !important;
    }
</style>

<!-- Script for Clickable Rows -->
<script>
    document.querySelectorAll('.clickable-row').forEach(row => {
        row.addEventListener('click', function() {
            const url = this.getAttribute('data-href');
            if (url) {
                window.open(url, '_blank');
            }
        });

        row.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                const url = this.getAttribute('data-href');
                if (url) {
                    window.open(url, '_blank');
                }
            }
        });
    });
</script>
