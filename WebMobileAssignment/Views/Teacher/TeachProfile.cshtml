@using WebMobileAssignment.Models;
@model Teacher
@{
    ViewBag.Title = "Teacher Profile";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="dashboard-card text-center">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-person-badge-fill"></i>
                    Profile Information
                </h3>
            </div>
            <div class="user-avatar mx-auto mb-3" style="width: 120px; height: 120px; font-size: 3rem; background: #0d6efd;">
                <i class="bi bi-person-fill"></i>
            </div>
            <h5 class="mb-2">@Model?.User?.FullName</h5>
            <p class="text-muted mb-3">Teacher ID: @Model?.TeacherId</p>
            <p class="text-muted mb-4">@(Model?.Title ?? "Instructor")</p>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-file-earmark-person-fill"></i>
                    Personal Information
                </h3>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Full Name</label>
                    <input type="text" class="form-control" value="@Model?.User?.FullName" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Teacher ID</label>
                    <input type="text" class="form-control" value="@Model?.TeacherId" disabled />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Email Address</label>
                    <input type="email" class="form-control" value="@Model?.User?.Email" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Title</label>
                    <input type="text" class="form-control" value="@(Model?.Title ?? "N/A")" disabled />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">User ID</label>
                    <input type="text" class="form-control" value="@Model?.UserId" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">User Type</label>
                    <input type="text" class="form-control" value="@(Model?.User?.UserType ?? "N/A")" disabled />
                </div>
            </div>

            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Note:</strong> To edit your profile information, please contact your administrator.
            </div>
        </div>

        <!-- Professional Information -->
        <div class="dashboard-card mt-3">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-info-circle-fill"></i>
                    Professional Information
                </h3>
            </div>

            @{
                var totalClasses = Model?.Classes?.Count ?? 0;
                var totalStudents = Model?.Classes?.SelectMany(c => c.Enrollments).Count() ?? 0;
                var totalSessions = Model?.Classes?.SelectMany(c => c.Attendances).Count() ?? 0;
                var attendances = Model?.Classes?.SelectMany(c => c.Attendances).ToList() ?? new List<Attendance>();
                var avgAttendance = attendances.Count > 0
                    ? Math.Round((decimal)(attendances.Count(a => a.Status == "Present") * 100) / attendances.Count(), 2)
                    : 0;
            }

            <div class="list-group list-group-flush">
                <div class="list-group-item px-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-briefcase-fill me-2"></i>Total Classes Teaching</span>
                        <strong>@totalClasses</strong>
                    </div>
                </div>
                <div class="list-group-item px-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-people-fill me-2"></i>Total Students</span>
                        <strong>@totalStudents</strong>
                    </div>
                </div>
                <div class="list-group-item px-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-calendar-event-fill me-2"></i>Sessions Conducted</span>
                        <strong>@totalSessions</strong>
                    </div>
                </div>
                <div class="list-group-item px-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-graph-up me-2"></i>Avg. Attendance Rate</span>
                        <strong><span class="badge @(avgAttendance >= 90 ? "bg-success" : avgAttendance >= 80 ? "bg-warning" : "bg-danger")">@avgAttendance%</span></strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Classes Overview -->
        <div class="dashboard-card mt-3">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-book-fill"></i>
                    Classes Teaching
                </h3>
            </div>

            @if (Model?.Classes != null && Model.Classes.Count > 0)
            {
                <div class="list-group list-group-flush">
                    @foreach (var cls in Model.Classes)
                    {
                        var studentCount = cls.Enrollments?.Count ?? 0;
                        var sessionCount = cls.Attendances?.Count ?? 0;
                        <div class="list-group-item px-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@cls.ClassName</strong>
                                    <br />
                                    <small class="text-muted">@studentCount students • @sessionCount sessions</small>
                                </div>
                                <a asp-controller="Teacher" asp-action="TeachClassDetail" asp-route-id="@cls.ClassId" 
                                   class="btn btn-sm btn-outline-primary">View</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">No classes assigned</div>
            }
        </div>
    </div>
</div>
