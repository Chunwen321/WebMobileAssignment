@using WebMobileAssignment.Models;
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="row g-3 mb-4">
    <!-- Classes Stats -->
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #198754;">
            <div class="stat-label">Total Classes</div>
            <div class="stat-value">@ViewBag.TotalClasses</div>
            <div class="stat-change positive">
                <i class="bi bi-book-fill"></i>
                <span>Active classes</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #0d6efd;">
            <div class="stat-label">Total Students</div>
            <div class="stat-value">@ViewBag.TotalStudents</div>
            <div class="stat-change positive">
                <i class="bi bi-people-fill"></i>
                <span>Enrolled students</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #ffc107;">
            <div class="stat-label">Attendance Rate</div>
            <div class="stat-value">@ViewBag.AttendanceRate%</div>
            <div class="stat-change positive">
                <i class="bi bi-percent"></i>
                <span>Today's attendance</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #17a2b8;">
            <div class="stat-label">Sessions</div>
            <div class="stat-value">@ViewBag.SessionsCount</div>
            <div class="stat-change positive">
                <i class="bi bi-calendar-event"></i>
                <span>Total recorded</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Classes Summary -->
    <div class="col-lg-8">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-book-fill"></i>
                    Classes Overview
                </h3>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Class Name</th>
                            <th>Students</th>
                            <th>Sessions</th>
                            <th>Avg. Attendance</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Classes != null && ((List<Class>)ViewBag.Classes).Count > 0)
                        {
                            @foreach (var cls in (List<Class>)ViewBag.Classes)
                            {
                                var studentCount = cls.Enrollments?.Count ?? 0;
                                var sessionCounts = ViewBag.SessionCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
                                var sessionCount = sessionCounts.ContainsKey(cls.ClassId) ? sessionCounts[cls.ClassId] : 0;
                                var avgAttendance = sessionCount > 0 
                                    ? Math.Round((decimal)(cls.Attendances.Count(a => a.Status == "Present") * 100) / sessionCount, 2)
                                    : 0;
                                var badgeClass = avgAttendance >= 90 ? "bg-success" : avgAttendance >= 80 ? "bg-warning" : "bg-danger";
                                <tr>
                                    <td><strong>@cls.ClassName</strong></td>
                                    <td>@studentCount</td>
                                    <td>@sessionCount</td>
                                    <td><span class="badge @badgeClass">@avgAttendance%</span></td>
                                    <td>
                                        <a asp-controller="Teacher" asp-action="TeachClassDetail" asp-route-id="@cls.ClassId" class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No classes assigned</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <a asp-controller="Teacher" asp-action="TeachClasses" class="btn btn-outline-primary w-100 mt-3">
                <i class="bi bi-arrow-right me-2"></i>View All Classes
            </a>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-lightning-fill"></i>
                    Quick Actions
                </h3>
            </div>
            <div class="list-group list-group-flush">
                <a asp-controller="Teacher" asp-action="TeachMarkAttendance" class="list-group-item list-group-item-action px-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-pencil-square text-primary me-3" style="font-size: 1.5rem;"></i>
                        <div>
                            <h6 class="mb-0">Mark Attendance</h6>
                            <small class="text-muted">Record student attendance</small>
                        </div>
                    </div>
                </a>
                <a asp-controller="Teacher" asp-action="TeachAttendanceHistory" class="list-group-item list-group-item-action px-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-clock-history text-success me-3" style="font-size: 1.5rem;"></i>
                        <div>
                            <h6 class="mb-0">View History</h6>
                            <small class="text-muted">Check attendance records</small>
                        </div>
                    </div>
                </a>
                <a asp-controller="Teacher" asp-action="TeachStudents" class="list-group-item list-group-item-action px-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-people-fill text-info me-3" style="font-size: 1.5rem;"></i>
                        <div>
                            <h6 class="mb-0">Manage Students</h6>
                            <small class="text-muted">View student information</small>
                        </div>
                    </div>
                </a>
                <a asp-controller="Teacher" asp-action="TeachProfile" class="list-group-item list-group-item-action px-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-badge-fill text-warning me-3" style="font-size: 1.5rem;"></i>
                        <div>
                            <h6 class="mb-0">My Profile</h6>
                            <small class="text-muted">View/edit profile information</small>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Sessions -->
<div class="row g-3 mt-3">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-calendar-event-fill"></i>
                    Recent Sessions
                </h3>
                <a asp-controller="Teacher" asp-action="TeachAttendanceHistory" class="btn btn-sm btn-outline-primary">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Class</th>
                            <th>PIN</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var recentSessions = ViewBag.RecentSessions as List<dynamic> ?? new List<dynamic>();
                        }
                        @if (recentSessions.Count > 0)
                        {
                            @foreach (var session in recentSessions)
                            {
                                var sessionDate = ((DateTime)session.CreatedDate);
                                var classData = session.Class as Class;
                                var isExpired = sessionDate.AddHours(24) < DateTime.Now;
                                
                                <tr>
                                    <td><i class="bi bi-calendar3 me-2 text-muted"></i>@sessionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@classData?.ClassName</td>
                                    <td><code>@session.PinCode</code></td>
                                    <td>
                                        @if (isExpired)
                                        {
                                            <span class="badge bg-secondary">Expired</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No session records yet</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
