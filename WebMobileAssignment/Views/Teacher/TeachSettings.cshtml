@using WebMobileAssignment.Models;
@model Teacher
@{
    ViewBag.Title = "Settings";
    ViewBag.ActiveMenu = "Settings";
    ViewBag.ActiveSubmenu = "Settings";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>@TempData["SuccessMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>@TempData["ErrorMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3">
    <!-- Account Settings -->
    <div class="col-lg-8">
        <!-- Profile Picture Section -->
        <div class="dashboard-card settings-account-card mb-3">
            <div class="card-header-custom">
                <h5 class="card-title">
                    <i class="bi bi-person-badge-fill"></i>
                    Profile Picture
                </h5>
            </div>

            <div class="row">
                <div class="col-md-4 text-center">
                    <div class="profile-picture-container">
                        @if (!string.IsNullOrEmpty(Model?.User?.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                        {
                            <img id="profilePicturePreview" 
                                 src="@Model.User.ProfilePicture" 
                                 alt="Profile Picture" 
                                 class="img-thumbnail rounded-circle mb-3" 
                                 style="width: 180px; height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 180px; height: 180px;">
                                <i class="bi bi-person-circle text-secondary" style="font-size: 8rem;"></i>
                            </div>
                        }
                        
                        <div class="d-grid gap-2">
                            <label for="profilePictureFile" class="btn btn-primary">
                                <i class="bi bi-upload"></i> Choose Photo
                            </label>
                            <input type="file" 
                                   id="profilePictureFile"
                                   name="profilePicture"
                                   accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" 
                                   style="display: none;">
                            
                            <button type="button" id="btnWebcam" class="btn btn-outline-primary">
                                <i class="bi bi-camera-fill"></i> Take Photo
                            </button>
                            
                            <button type="button" id="btnEditPhoto" class="btn btn-outline-success" style="display: none;">
                                <i class="bi bi-crop"></i> Edit Photo
                            </button>
                            
                            <button type="button" id="clearProfilePictureBtn" class="btn btn-outline-secondary" style="display: none;">
                                <i class="bi bi-x"></i> Clear
                            </button>
                        </div>
                        
                        <div id="uploadProgress" class="mt-3" style="display: none;">
                            <div class="progress">
                                <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                     role="progressbar" 
                                     style="width: 100%">Uploading...</div>
                            </div>
                        </div>
                        
                        <div id="uploadMessage" class="mt-3"></div>
                        
                        <small class="text-muted d-block mt-3">
                            <i class="bi bi-info-circle"></i> Max size: 5 MB<br>
                            Formats: JPG, PNG, GIF, WEBP
                        </small>
                    </div>
                </div>
                
                <div class="col-md-8">
                    <div class="alert alert-info border-0 mb-0">
                        <h6 class="alert-heading">
                            <i class="bi bi-lightbulb-fill me-2"></i>Profile Picture Guidelines
                        </h6>
                        <ul class="mb-0">
                            <li>Upload a clear photo of yourself</li>
                            <li>Use your webcam to take a photo directly</li>
                            <li>Click "Edit Photo" to crop, rotate, and adjust your image</li>
                            <li>Supported formats: JPG, PNG, GIF, WEBP</li>
                            <li>Maximum file size: 5 MB</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Profile Section -->
        <div class="dashboard-card settings-account-card">
            <div class="card-header-custom">
                <h5 class="card-title">
                    <i class="bi bi-person-circle"></i>
                    Edit Profile
                </h5>
            </div>

            <form asp-action="UpdateTeacherProfile" method="post">
                @Html.AntiForgeryToken()
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input type="text" name="fullName" class="form-control" value="@Model?.User?.FullName" required>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input type="email" name="email" class="form-control" value="@Model?.User?.Email" required readonly>
                        </div>
                        <small class="text-muted d-block mt-1">Email cannot be changed</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                            <input type="tel" name="phoneNumber" class="form-control" value="@(Model?.User?.PhoneNumber ?? "")" placeholder="Optional">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Date of Birth</label>
                        <input type="date" class="form-control" name="dateOfBirth" value="@(Model?.User?.DateOfBirth?.ToString("yyyy-MM-dd"))">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Gender</label>
                        <select class="form-select" name="gender">
                            <option value="">Select Gender</option>
                            @if (Model?.User?.Gender == "Male")
                            {
                                <option value="Male" selected>Male</option>
                            }
                            else
                            {
                                <option value="Male">Male</option>
                            }
                            @if (Model?.User?.Gender == "Female")
                            {
                                <option value="Female" selected>Female</option>
                            }
                            else
                            {
                                <option value="Female">Female</option>
                            }
                            @if (Model?.User?.Gender == "Other")
                            {
                                <option value="Other" selected>Other</option>
                            }
                            else
                            {
                                <option value="Other">Other</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Title / Position</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-briefcase"></i></span>
                            <input type="text" name="title" class="form-control" value="@(Model?.Title ?? "")" placeholder="e.g., Senior Teacher">
                        </div>
                    </div>
                    
                    <div class="col-12 mb-0">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-2"></i>Save Changes
                        </button>
                        <button type="button" class="btn btn-outline-secondary px-4" onclick="window.location.reload();">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Profile Summary -->
        <div class="dashboard-card profile-card">
            <div class="text-center mb-4">
                @if (!string.IsNullOrEmpty(Model?.User?.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                {
                    <img src="@Model.User.ProfilePicture" 
                         alt="Profile Picture" 
                         class="rounded-circle mx-auto mb-3 shadow-sm" 
                         style="width: 100px; height: 100px; object-fit: cover;">
                }
                else
                {
                    <div class="user-avatar mx-auto mb-3 shadow-sm" style="width: 100px; height: 100px; font-size: 2.5rem; background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);">
                        <i class="bi bi-person-fill"></i>
                    </div>
                }
                <h5 class="mb-1 fw-bold">@Model?.User?.FullName</h5>
                <p class="text-muted mb-2 small">@(Model?.Title ?? "Teacher")</p>
                <span class="badge bg-primary px-3 py-2">Teacher</span>
            </div>
            <div class="profile-info">
                <div class="profile-info-item">
                    <i class="bi bi-hash text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Teacher ID</small>
                        <strong class="text-dark">@Model?.TeacherId</strong>
                    </div>
                </div>
                <div class="profile-info-item">
                    <i class="bi bi-envelope text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Email</small>
                        <strong class="text-dark">@Model?.User?.Email</strong>
                    </div>
                </div>
                <div class="profile-info-item">
                    <i class="bi bi-book-fill text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Total Classes</small>
                        <strong class="text-dark">@(Model?.Classes?.Count ?? 0)</strong>
                    </div>
                </div>
            </div>

            <!-- System Information Inside Profile Card -->
            <div class="system-info-section mt-4">
                <div class="section-divider mb-3">
                    <h6 class="section-title mb-0 fw-bold">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i>
                        Account Information
                    </h6>
                </div>
                <div class="system-info">
                    <div class="system-info-item">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-calendar-check text-primary"></i>
                                <small class="text-muted">Member Since</small>
                            </div>
                            <strong class="text-dark">@Model?.User?.CreatedDate.ToString("MMM dd, yyyy")</strong>
                        </div>
                    </div>
                    <div class="system-info-item">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-telephone text-primary"></i>
                                <small class="text-muted">Phone Number</small>
                            </div>
                            <strong class="text-dark">@(Model?.User?.PhoneNumber ?? "Not provided")</strong>
                        </div>
                    </div>
                    <div class="system-info-item">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-gender-ambiguous text-primary"></i>
                                <small class="text-muted">Gender</small>
                            </div>
                            <strong class="text-dark">@(Model?.User?.Gender ?? "Not specified")</strong>
                        </div>
                    </div>
                    <div class="system-info-item">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-cake2 text-primary"></i>
                                <small class="text-muted">Date of Birth</small>
                            </div>
                            <strong class="text-dark">
                                @if (Model?.User?.DateOfBirth.HasValue == true)
                                {
                                    @Model.User.DateOfBirth.Value.ToString("MMM dd, yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Not provided</span>
                                }
                            </strong>
                        </div>
                    </div>
                    <div class="system-info-item">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-key-fill text-primary"></i>
                                <small class="text-muted">Password</small>
                            </div>
                            <a href="@Url.Action("TeachChangePassword", "Teacher")" class="btn btn-sm btn-outline-primary">
                                Change
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .settings-account-card {
        background: var(--bg-primary);
    }

    [data-theme="dark"] .settings-account-card {
        background: #2a2a2a;
    }

    .profile-card {
        background: var(--bg-primary);
    }

    [data-theme="dark"] .profile-card {
        background: #2a2a2a;
    }

    .profile-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
        padding: 1rem 0;
    }

    [data-theme="dark"] .profile-info {
        border-color: #353535;
    }

    .profile-info-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .profile-info-item i {
        font-size: 1.25rem;
        margin-top: 0.25rem;
        flex-shrink: 0;
    }

    .profile-info-item div {
        flex: 1;
    }

    .section-divider {
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    [data-theme="dark"] .section-divider {
        border-color: #353535;
    }

    .system-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .system-info-item {
        padding: 0.75rem 0;
    }

    .system-info-item:not(:last-child) {
        border-bottom: 1px solid var(--border-color);
    }

    [data-theme="dark"] .system-info-item:not(:last-child) {
        border-color: #353535;
    }

    .system-info-section {
        margin-top: 1rem;
        padding-top: 1rem;
    }

    .input-group-text {
        border-color: var(--border-color) !important;
    }

    [data-theme="dark"] .input-group-text {
        background-color: #353535 !important;
        border-color: #404040 !important;
    }

    [data-theme="dark"] .input-group-text i {
        color: #0d6efd !important;
    }

    [data-theme="dark"] .dashboard-card {
        background: #2a2a2a;
    }

    /* Dark mode text visibility fixes */
    [data-theme="dark"] .form-label {
        color: #e0e0e0 !important;
    }

    [data-theme="dark"] .text-dark {
        color: #e0e0e0 !important;
    }

    [data-theme="dark"] .text-muted {
        color: #9ca3af !important;
    }

    [data-theme="dark"] .form-control {
        background-color: #353535;
        border-color: #404040;
        color: #e0e0e0;
    }

    [data-theme="dark"] .form-control:focus {
        background-color: #353535;
        border-color: #0d6efd;
        color: #e0e0e0;
    }

    [data-theme="dark"] .form-control::placeholder {
        color: #6b7280;
    }

    [data-theme="dark"] .form-select {
        background-color: #353535;
        border-color: #404040;
        color: #e0e0e0;
    }

    [data-theme="dark"] .form-select:focus {
        background-color: #353535;
        border-color: #0d6efd;
        color: #e0e0e0;
    }

    [data-theme="dark"] .form-select option {
        background-color: #353535;
        color: #e0e0e0;
    }

    [data-theme="dark"] h5 {
        color: #e0e0e0 !important;
    }

    [data-theme="dark"] h6 {
        color: #e0e0e0 !important;
    }

    [data-theme="dark"] .section-title {
        color: #e0e0e0 !important;
    }

    [data-theme="dark"] small {
        color: #9ca3af !important;
    }

    [data-theme="dark"] strong {
        color: #e0e0e0 !important;
    }

    /* Profile Picture Section Styles */
    .profile-picture-container {
        padding: 1rem;
    }

    [data-theme="dark"] .profile-picture-container .bg-light {
        background-color: #353535 !important;
    }

    [data-theme="dark"] .profile-picture-container .text-secondary {
        color: #6b7280 !important;
    }

    [data-theme="dark"] .alert-info {
        background-color: rgba(13, 110, 253, 0.15) !important;
        border-color: rgba(13, 110, 253, 0.25) !important;
        color: #e0e0e0 !important;
    }

    [data-theme="dark"] .alert-info .alert-heading {
        color: #e0e0e0 !important;
    }

    [data-theme="dark"] .alert-info ul li {
        color: #c0c0c0 !important;
    }
</style>

@section Scripts {
    <!-- Cropper.js CSS and JS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>

    <!-- Webcam Capture Script -->
    <script src="~/js/webcam-capture.js"></script>

    <!-- Image Cropper Module -->
    <script src="~/js/image-cropper.js"></script>

    <!-- Inject Modals -->
    <div id="imageCropperModals"></div>
    <script>
        document.getElementById('imageCropperModals').innerHTML = ImageCropper.getModalHTML();
    </script>

    <script>
        // ==================== INITIALIZE IMAGE CROPPER ====================
        ImageCropper.init({
            targetId: 'teacher',
            previewElementId: 'profilePicturePreview',
            fileInputId: 'profilePictureFile',
            clearButtonId: 'clearProfilePictureBtn',
            editButtonId: 'btnEditPhoto',
            previewWidth: 180,
            previewHeight: 180,
            onCropComplete: function(croppedFile) {
                // Upload the cropped image
                uploadProfilePicture(croppedFile);
            }
        });

        // Show Edit button if existing profile picture exists
        @if (!string.IsNullOrEmpty(Model?.User?.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
        {
            <text>
            document.getElementById('btnEditPhoto').style.display = 'block';
            document.getElementById('clearProfilePictureBtn').style.display = 'block';
            </text>
        }

        // ==================== WEBCAM FUNCTIONALITY ====================
        (function() {
            WebcamCapture.init('profilePicturePreview', 'profilePictureFile', function(file) {
                console.log('Photo captured from webcam:', file.name);
                document.getElementById('btnEditPhoto').style.display = 'block';
                document.getElementById('clearProfilePictureBtn').style.display = 'block';
            });

            const webcamBtn = document.getElementById('btnWebcam');
            if (webcamBtn) {
                webcamBtn.addEventListener('click', function() {
                    WebcamCapture.openModal();
                });
            }
        })();

        // ==================== UPLOAD PROFILE PICTURE ====================
        async function uploadProfilePicture(file) {
            const uploadProgress = document.getElementById('uploadProgress');
            const uploadMessage = document.getElementById('uploadMessage');
            
            try {
                uploadProgress.style.display = 'block';
                uploadMessage.innerHTML = '';

                const formData = new FormData();
                formData.append('file', file);

                const response = await fetch('@Url.Action("UploadProfilePicture", "Teacher")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                uploadProgress.style.display = 'none';

                if (result.success) {
                    uploadMessage.innerHTML = '<div class="alert alert-success py-2"><i class="bi bi-check-circle me-2"></i>' + result.message + '</div>';
                    
                    // Update the preview
                    const preview = document.getElementById('profilePicturePreview');
                    if (preview.tagName === 'DIV') {
                        // Replace the placeholder with an actual image
                        const img = document.createElement('img');
                        img.id = 'profilePicturePreview';
                        img.src = result.pictureUrl;
                        img.alt = 'Profile Picture';
                        img.className = 'img-thumbnail rounded-circle mb-3';
                        img.style.cssText = 'width: 180px; height: 180px; object-fit: cover;';
                        preview.parentNode.replaceChild(img, preview);
                    } else {
                        preview.src = result.pictureUrl;
                    }

                    document.getElementById('btnEditPhoto').style.display = 'block';
                    document.getElementById('clearProfilePictureBtn').style.display = 'block';

                    // Reload the page after a short delay to update sidebar
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    uploadMessage.innerHTML = '<div class="alert alert-danger py-2"><i class="bi bi-exclamation-circle me-2"></i>' + result.message + '</div>';
                }
            } catch (error) {
                uploadProgress.style.display = 'none';
                uploadMessage.innerHTML = '<div class="alert alert-danger py-2"><i class="bi bi-exclamation-circle me-2"></i>Upload failed: ' + error.message + '</div>';
            }
        }

        // ==================== CLEAR PROFILE PICTURE (PREVIEW ONLY) ====================
        (function() {
            const clearBtn = document.getElementById('clearProfilePictureBtn');
            if (clearBtn) {
                clearBtn.addEventListener('click', function() {
                    const preview = document.getElementById('profilePicturePreview');
                    
                    // Create placeholder div
                    const placeholder = document.createElement('div');
                    placeholder.id = 'profilePicturePreview';
                    placeholder.className = 'd-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light';
                    placeholder.style.cssText = 'width: 180px; height: 180px;';
                    placeholder.innerHTML = '<i class="bi bi-person-circle text-secondary" style="font-size: 8rem;"></i>';
                    
                    preview.parentNode.replaceChild(placeholder, preview);
                    
                    // Clear file input
                    document.getElementById('profilePictureFile').value = '';
                    
                    // Hide buttons
                    document.getElementById('btnEditPhoto').style.display = 'none';
                    document.getElementById('clearProfilePictureBtn').style.display = 'none';
                    
                    // Clear any messages
                    document.getElementById('uploadMessage').innerHTML = '';
                });
            }
        })();

        // ==================== FILE INPUT CHANGE HANDLER ====================
        document.getElementById('profilePictureFile').addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                document.getElementById('btnEditPhoto').style.display = 'block';
                document.getElementById('clearProfilePictureBtn').style.display = 'block';
            }
        });
    </script>
}