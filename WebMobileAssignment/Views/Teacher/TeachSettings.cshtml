@{
    ViewBag.Title = "Settings";
    ViewBag.ActiveSubmenu = "Settings";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="list-group">
            <a href="#generalSettings" class="list-group-item list-group-item-action active" data-bs-toggle="list">
                <i class="bi bi-gear-fill me-2"></i>General Settings
            </a>
            <a href="#accountSettings" class="list-group-item list-group-item-action" data-bs-toggle="list">
                <i class="bi bi-person-circle me-2"></i>Account
            </a>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- General Settings -->
        <div class="dashboard-card" id="generalSettings">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-gear-fill"></i>
                    General Settings
                </h3>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label">
                        <i class="bi bi-palette-fill me-2"></i>Theme
                    </label>
                    <select class="form-select" id="themeSelector" onchange="handleThemeChange(this.value)">
                        <option value="light">Light Theme</option>
                        <option value="dark">Dark Theme</option>
                    </select>
                    <small class="form-text text-muted d-block mt-2">
                        Light theme displays bright colors, dark theme displays dark colors for comfortable viewing
                    </small>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <div class="alert alert-info" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Theme Settings:</strong> Your theme preference is saved locally and will be remembered on your next visit.
                    </div>
                </div>
            </div>

            <button class="btn btn-primary" disabled title="Theme changes are saved automatically">
                <i class="bi bi-check-circle me-2"></i>Settings Auto-Saved
            </button>
        </div>

        <!-- Account Settings -->
        <div class="dashboard-card" id="accountSettings" style="display: none;">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-person-circle"></i>
                    Account Settings
                </h3>
            </div>

            <div class="alert alert-info mb-4">
                <i class="bi bi-info-circle me-2"></i>
                Manage your account security and login information
            </div>

            <h6 class="mb-3">Two-Factor Authentication</h6>
            <div class="mb-4">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="twoFactorAuth" disabled>
                    <label class="form-check-label" for="twoFactorAuth">
                        Enable two-factor authentication for enhanced security (Coming Soon)
                    </label>
                </div>
            </div>

            <h6 class="mb-3">Active Sessions</h6>
            <div class="table-responsive mb-4">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Location</th>
                            <th>Last Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Chrome - Windows</td>
                            <td>New York, USA</td>
                            <td>Current Session</td>
                            <td><span class="badge bg-success">Active</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h6 class="mb-3">Account Security</h6>
            <div class="mb-3">
                <a href="@Url.Action("TeachChangePassword", "Teacher")" class="btn btn-outline-primary">
                    <i class="bi bi-key-fill me-2"></i>Change Password
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Initialize theme on page load (prevents flash)
    (function() {
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
        document.getElementById('themeSelector').value = savedTheme;
    })();

    // Handle theme change
    function handleThemeChange(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
    }
</script>