@using WebMobileAssignment.Models;
@{
    ViewBag.Title = "Attendance History";
    ViewBag.ActiveMenu = "Attendance";
    ViewBag.ActiveSubmenu = "History";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    
    var attendances = ViewBag.Attendances as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var attendanceList = attendances.ToList();
}

<!-- Header Section -->
<div class="row mb-2">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">
                    <i class="bi bi-clock-history text-primary me-2"></i>
                    Attendance History
                </h5>
            </div>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="row mb-3">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="p-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="filterDate" class="form-label fw-semibold">
                            <i class="bi bi-calendar me-1"></i>Filter by Date
                        </label>
                        <input type="date" class="form-control" id="filterDate" placeholder="Filter by date" />
                    </div>
                    <div class="col-md-4">
                        <label for="filterClass" class="form-label fw-semibold">
                            <i class="bi bi-search me-1"></i>Search by Class
                        </label>
                        <input type="text" class="form-control" id="filterClass" placeholder="Enter class name..." />
                    </div>
                    <div class="col-md-4">
                        <label for="filterStudent" class="form-label fw-semibold">
                            <i class="bi bi-person me-1"></i>Search by Student
                        </label>
                        <input type="text" class="form-control" id="filterStudent" placeholder="Enter student name..." />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Attendance Sessions -->
<div class="row">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h6 class="card-title mb-0" style="font-size: 0.95rem;">
                    <i class="bi bi-journal-text me-2"></i>
                    Attendance Records (@attendanceList.Count)
                </h6>
            </div>
            
            @if (attendanceList.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0 session-history-table">
                        <thead>
                            <tr>
                                <th style="width: 12%;">Date</th>
                                <th style="width: 15%;">Time Marked</th>
                                <th style="width: 15%;">Student ID</th>
                                <th style="width: 20%;">Student Name</th>
                                <th style="width: 18%;">Class</th>
                                <th style="width: 10%;">Venue</th>
                                <th style="width: 10%;">Status</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceTableBody">
                            @foreach (var record in attendanceList)
                            {
                                var recordDate = (DateTime)record.Date;
                                var takenOn = (DateTime)record.TakenOn;
                                var studentId = record.StudentId ?? "N/A";
                                var studentName = record.StudentName ?? "Unknown";
                                var className = record.ClassName ?? "N/A";
                                var venue = record.RoomNumber ?? "N/A";
                                var status = record.Status ?? "Not Marked";

                                <tr class="attendance-row" 
                                    data-date="@recordDate.ToString("yyyy-MM-dd")" 
                                    data-class="@className"
                                    data-student="@studentName">
                                    <td>
                                        <small class="fw-semibold">@recordDate.ToString("MMM dd, yyyy")</small>
                                    </td>
                                    <td>
                                        <small class="text-muted">@takenOn.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@studentId</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@studentName</span>
                                    </td>
                                    <td>
                                        <small>@className</small>
                                    </td>
                                    <td>
                                        <small><i class="bi bi-geo-alt me-1 text-muted"></i>@venue</small>
                                    </td>
                                    <td>
                                        @if (status == "Present")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Present</span>
                                        }
                                        else if (status == "Absent")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Absent</span>
                                        }
                                        else if (status == "Late")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> Late</span>
                                        }
                                        else if (status == "Leave")
                                        {
                                            <span class="badge bg-info"><i class="bi bi-calendar-check"></i> Leave</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-dash-circle"></i> Not Marked</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-0"><strong>No attendance records found</strong></p>
                    <p class="small mt-1">Attendance records for your classes will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Styles -->
<style>
    .attendance-row {
        transition: all 0.3s ease;
    }

    .attendance-row:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }

    .table-sm td {
        vertical-align: middle;
        padding: 0.5rem 0.4rem;
    }

    .table-sm th {
        padding: 0.5rem 0.4rem;
        font-size: 0.8rem;
    }

    .table thead.table-light {
        background-color: #f8f9fa;
    }

    .dashboard-card {
        margin-bottom: 0;
    }
</style>

<!-- Filter Script -->
<script>
    const filterDateInput = document.getElementById('filterDate');
    const filterClassInput = document.getElementById('filterClass');
    const filterStudentInput = document.getElementById('filterStudent');
    const attendanceRows = document.querySelectorAll('.attendance-row');

    function applyFilters() {
        const selectedDate = filterDateInput.value;
        const searchClass = filterClassInput.value.toLowerCase();
        const searchStudent = filterStudentInput.value.toLowerCase();

        attendanceRows.forEach(row => {
            const rowDate = row.getAttribute('data-date');
            const rowClass = row.getAttribute('data-class').toLowerCase();
            const rowStudent = row.getAttribute('data-student').toLowerCase();

            const dateMatch = !selectedDate || rowDate === selectedDate;
            const classMatch = !searchClass || rowClass.includes(searchClass);
            const studentMatch = !searchStudent || rowStudent.includes(searchStudent);

            row.style.display = (dateMatch && classMatch && studentMatch) ? '' : 'none';
        });

        // Show/hide empty message
        const visibleRows = Array.from(attendanceRows).filter(row => row.style.display !== 'none');
        const tbody = document.getElementById('attendanceTableBody');
        
        if (visibleRows.length === 0 && attendanceRows.length > 0) {
            if (!document.getElementById('noResultsMessage')) {
                const noResultsRow = document.createElement('tr');
                noResultsRow.id = 'noResultsMessage';
                noResultsRow.innerHTML = '<td colspan="7" class="text-center text-muted py-4">No matching records found</td>';
                tbody.appendChild(noResultsRow);
            }
        } else {
            const noResultsRow = document.getElementById('noResultsMessage');
            if (noResultsRow) {
                noResultsRow.remove();
            }
        }
    }

    filterDateInput.addEventListener('change', applyFilters);
    filterClassInput.addEventListener('keyup', applyFilters);
    filterStudentInput.addEventListener('keyup', applyFilters);
</script>

<style>
    /* Light Theme - Session History Table Styling */
    .session-history-table thead {
        background: transparent !important;
        border-bottom: 2px solid #dee2e6 !important;
    }

    .session-history-table thead th {
        background: transparent !important;
        color: #212529 !important;
        font-weight: 600 !important;
        border-bottom: 2px solid #dee2e6 !important;
    }

    /* Dark Theme - Session History Table Styling */
    [data-theme="dark"] .session-history-table thead {
        background: transparent !important;
        border-bottom: 2px solid #404040 !important;
    }

    [data-theme="dark"] .session-history-table thead th {
        background: transparent !important;
        color: #e0e0e0 !important;
        font-weight: 600 !important;
        border-bottom: 2px solid #404040 !important;
    }
</style>
