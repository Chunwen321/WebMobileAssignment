@using WebMobileAssignment.Models;
@{
    ViewBag.Title = "Attendance History";
    ViewBag.ActiveMenu = "Attendance";
    ViewBag.ActiveSubmenu = "History";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    
    var sessions = ViewBag.Sessions as List<dynamic> ?? new List<dynamic>();
}

<!-- Header Section -->
<div class="row mb-2">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">
                    <i class="bi bi-clock-history text-primary me-2"></i>
                    Attendance History
                </h5>
            </div>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="row mb-3">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="filterDate" class="form-label fw-semibold">
                            <i class="bi bi-calendar me-1"></i>Filter by Date
                        </label>
                        <input type="date" class="form-control" id="filterDate" placeholder="Filter by date" />
                    </div>
                    <div class="col-md-6">
                        <label for="filterClass" class="form-label fw-semibold">
                            <i class="bi bi-search me-1"></i>Search by Class
                        </label>
                        <input type="text" class="form-control" id="filterClass" placeholder="Enter class name..." />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Attendance Sessions -->
<div class="row">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h6 class="card-title mb-0" style="font-size: 0.95rem;">
                    <i class="bi bi-journal-text me-2"></i>
                    Session History (@sessions.Count)
                </h6>
            </div>
            
            @if (sessions.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0 session-history-table">
                        <thead>
                            <tr>
                                <th style="width: 15%;">Date & Time</th>
                                <th style="width: 25%;">Class Name</th>
                                <th style="width: 20%;">Venue</th>
                                <th style="width: 15%;">Students</th>
                                <th style="width: 15%;">Attendance Rate</th>
                                <th style="width: 10%;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="sessionTableBody">
                            @foreach (var session in sessions)
                            {
                                var className = session.ClassName ?? "N/A";
                                var venue = session.RoomNumber ?? "N/A";
                                var createdDate = (DateTime)session.CreatedDate;
                                var startTime = session.StartTime;
                                var enrollmentCount = (int)session.EnrollmentCount;
                                var presentCount = (int)session.PresentCount;
                                var attendanceRate = enrollmentCount > 0 ? Math.Round((decimal)(presentCount * 100) / enrollmentCount, 1) : 0;
                                var classId = session.ClassId;

                                <tr class="session-row" data-date="@createdDate.ToString("yyyy-MM-dd")" data-class="@className">
                                    <td>
                                        <div class="session-datetime">
                                            <small class="fw-semibold">@createdDate.ToString("MMM dd, yyyy")</small><br>
                                            <small class="text-muted">@startTime?.ToString(@"hh\:mm") - @session.EndTime?.ToString(@"hh\:mm")</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@className</span>
                                    </td>
                                    <td>
                                        <i class="bi bi-geo-alt me-1 text-muted"></i>@venue
                                    </td>
                                    <td>
                                        <small>
                                            <span class="badge bg-info">@presentCount/@enrollmentCount</span>
                                        </small>
                                    </td>
                                    <td>
                                        @{
                                            var rateColor = attendanceRate >= 80 ? "bg-success" :
                                                           attendanceRate >= 60 ? "bg-warning" : "bg-danger";
                                        }
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="min-width: 80px; height: 20px;">
                                                <div class="progress-bar @(attendanceRate >= 80 ? "bg-success" : attendanceRate >= 60 ? "bg-warning" : "bg-danger")" 
                                                     role="progressbar" 
                                                     style="width: @attendanceRate%"
                                                     aria-valuenow="@attendanceRate" 
                                                     aria-valuemin="0" 
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <span class="@rateColor badge">@attendanceRate%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("TeachAttendanceClassDetail", "Teacher", new { id = classId, selectedDate = createdDate.ToString("yyyy-MM-dd") })"
                                           class="btn btn-sm btn-primary"
                                           target="_blank">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-0"><strong>No attendance sessions found</strong></p>
                    <p class="small mt-1">Attendance sessions will appear here as you mark attendance.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Styles -->
<style>
    .session-row {
        transition: all 0.3s ease;
    }

    .session-row:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }

    .session-datetime {
        line-height: 1.3;
        font-size: 0.875rem;
    }

    .progress {
        background-color: #e9ecef;
    }

    .table-sm td {
        vertical-align: middle;
        padding: 0.5rem 0.4rem;
    }

    .table-sm th {
        padding: 0.5rem 0.4rem;
        font-size: 0.8rem;
    }

    .table thead.table-light {
        background-color: #f8f9fa;
    }

    .dashboard-card {
        margin-bottom: 0;
    }
</style>

<!-- Filter Script -->
<script>
    const filterDateInput = document.getElementById('filterDate');
    const filterClassInput = document.getElementById('filterClass');
    const sessionRows = document.querySelectorAll('.session-row');

    function applyFilters() {
        const selectedDate = filterDateInput.value;
        const searchClass = filterClassInput.value.toLowerCase();

        sessionRows.forEach(row => {
            const rowDate = row.getAttribute('data-date');
            const rowClass = row.getAttribute('data-class').toLowerCase();

            const dateMatch = !selectedDate || rowDate === selectedDate;
            const classMatch = !searchClass || rowClass.includes(searchClass);

            row.style.display = (dateMatch && classMatch) ? '' : 'none';
        });

        // Show/hide empty message
        const visibleRows = Array.from(sessionRows).filter(row => row.style.display !== 'none');
        const tbody = document.getElementById('sessionTableBody');
        
        if (visibleRows.length === 0 && sessionRows.length > 0) {
            if (!document.getElementById('noResultsMessage')) {
                const noResultsRow = document.createElement('tr');
                noResultsRow.id = 'noResultsMessage';
                noResultsRow.innerHTML = '<td colspan="6" class="text-center text-muted py-4">No matching records found</td>';
                tbody.appendChild(noResultsRow);
            }
        } else {
            const noResultsRow = document.getElementById('noResultsMessage');
            if (noResultsRow) {
                noResultsRow.remove();
            }
        }
    }

    filterDateInput.addEventListener('change', applyFilters);
    filterClassInput.addEventListener('keyup', applyFilters);
</script>

<style>
    /* Light Theme - Session History Table Styling */
    .session-history-table thead {
        background: transparent !important;
        border-bottom: 2px solid #dee2e6 !important;
    }

    .session-history-table thead th {
        background: transparent !important;
        color: #212529 !important;
        font-weight: 600 !important;
        border-bottom: 2px solid #dee2e6 !important;
    }

    /* Dark Theme - Session History Table Styling */
    [data-theme="dark"] .session-history-table thead {
        background: transparent !important;
        border-bottom: 2px solid #404040 !important;
    }

    [data-theme="dark"] .session-history-table thead th {
        background: transparent !important;
        color: #e0e0e0 !important;
        font-weight: 600 !important;
        border-bottom: 2px solid #404040 !important;
    }
</style>
