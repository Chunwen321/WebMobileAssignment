@using WebMobileAssignment.Models;
@{
    ViewBag.Title = "Attendance History";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="row g-3">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-clock-history"></i>
                    Attendance History
                </h3>
            </div>

            <!-- Filters -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label">Filter by Date</label>
                    <input type="date" class="form-control" id="filterDate" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Search by Class</label>
                    <input type="text" class="form-control" id="filterClass" placeholder="Enter class name..." />
                </div>
            </div>

            <!-- Attendance Records -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Class</th>
                            <th>Student</th>
                            <th>Status</th>
                            <th>Marked By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Attendances != null && ((List<Attendance>)ViewBag.Attendances).Count > 0)
                        {
                            @foreach (var att in (List<Attendance>)ViewBag.Attendances)
                            {
                                var statusBadge = att.Status == "Present" ? "bg-success" : 
                                                  att.Status == "Absent" ? "bg-danger" : 
                                                  att.Status == "Late" ? "bg-warning" : "bg-secondary";
                                
                                <tr>
                                    <td>
                                        <i class="bi bi-calendar3 me-2 text-muted"></i>
                                        <span class="attendance-date">@att.Date.ToString("yyyy-MM-dd")</span>
                                    </td>
                                    <td>
                                        <span class="attendance-class">@att.Class?.ClassName</span>
                                    </td>
                                    <td>@att.Student?.User?.FullName</td>
                                    <td>
                                        <span class="badge @statusBadge">@att.Status</span>
                                    </td>
                                    <td>@att.MarkedByTeacher?.User?.FullName</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No attendance records found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ViewBag.Attendances != null && ((List<Attendance>)ViewBag.Attendances).Count > 0)
            {
                <div class="mt-3 text-muted">
                    <small>Total Records: @((List<Attendance>)ViewBag.Attendances).Count</small>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Client-side filtering
    document.getElementById('filterDate').addEventListener('change', filterRecords);
    document.getElementById('filterClass').addEventListener('keyup', filterRecords);

    function filterRecords() {
        const dateFilter = document.getElementById('filterDate').value;
        const classFilter = document.getElementById('filterClass').value.toLowerCase();
        const rows = document.querySelectorAll('tbody tr');

        rows.forEach(row => {
            const dateCell = row.querySelector('.attendance-date');
            const classCell = row.querySelector('.attendance-class');
            
            if (dateCell && classCell) {
                const dateMatch = !dateFilter || dateCell.textContent.includes(dateFilter);
                const classMatch = !classFilter || classCell.textContent.toLowerCase().includes(classFilter);

                row.style.display = (dateMatch && classMatch) ? '' : 'none';
            }
        });
    }
</script>
