        html += '<div class="col-md-6">';
        html += '<div class="detail-item">';
        html += '<i class="bi bi-people text-warning me-2"></i>';
        html += '<strong>Total Enrolled:</strong> <span class="ms-2">' + details.totalEnrolled + ' / ' + details.capacity + '</span>';
        html += '</div>';
        html += '</div>';
        
        html += '</div>'; // row
        html += '</div>'; // details-card
        html += '</div>'; // class-details-section
        
        html += '</div>'; // enrollment-letter-style
        
        return html;
    }

    function buildLeaveDetails(details) {
        let html = '<h6 class="mb-3"><i class="bi bi-calendar-x me-2"></i>Leave Application Details</h6>';
        html += '<div class="row g-3">';
        if (details.leaveId) {
            html += '<div class="col-md-6"><strong>Leave ID:</strong><br/>' + details.leaveId + '</div>';
        }
        if (details.applicant) {
            html += '<div class="col-md-6"><strong>Applicant:</strong><br/>' + details.applicant + '</div>';
            html += '<div class="col-md-6"><strong>Email:</strong><br/>' + details.email + '</div>';
        }
        html += '<div class="col-md-6"><strong>Start Date:</strong><br/>' + details.startDate + '</div>';
        html += '<div class="col-md-6"><strong>End Date:</strong><br/>' + details.endDate + '</div>';
        html += '<div class="col-md-6"><strong>Total Days:</strong><br/>' + details.totalDays + '</div>';
        html += '<div class="col-md-6"><strong>Status:</strong><br/><span class="badge bg-' + 
                (details.status === 'Approved' ? 'success' : (details.status === 'Rejected' ? 'danger' : 'warning')) + '">' + 
                details.status + '</span></div>';
        if (details.reason) {
            html += '<div class="col-12"><strong>Reason:</strong><br/>' + details.reason + '</div>';
        }
        if (details.remarks) {
            html += '<div class="col-12"><strong>Remarks:</strong><br/>' + details.remarks + '</div>';
        }
        if (details.createdDate) {
            html += '<div class="col-12"><strong>Applied On:</strong><br/>' + details.createdDate + '</div>';
        }
        html += '</div>';
        return html;
