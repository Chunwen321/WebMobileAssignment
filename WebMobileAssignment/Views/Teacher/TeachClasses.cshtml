@using WebMobileAssignment.Models;
@{
    ViewBag.Title = "Classes";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="row g-3">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h3 class="card-title">
                    <i class="bi bi-book-fill"></i>
                    My Classes
                </h3>
            </div>

            <!-- Classes Grid -->
            <div class="row">
                @if (ViewBag.Classes != null && ((List<Class>)ViewBag.Classes).Count > 0)
                {
                    @foreach (var cls in (List<Class>)ViewBag.Classes)
                    {
                        var studentCount = cls.Enrollments?.Count ?? 0;
                        var sessionCounts = ViewBag.SessionCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
                        var sessionCount = sessionCounts.ContainsKey(cls.ClassId) ? sessionCounts[cls.ClassId] : 0;
                        var avgAttendance = sessionCount > 0 
                            ? Math.Round((decimal)(cls.Attendances.Count(a => a.Status == "Present") * 100) / sessionCount, 0)
                            : 0;
                        var badgeClass = avgAttendance >= 90 ? "bg-success" : avgAttendance >= 80 ? "bg-warning" : "bg-danger";
                        var iconClass = avgAttendance >= 90 ? "text-primary" : avgAttendance >= 80 ? "text-warning" : "text-danger";

                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="bi bi-book-fill @iconClass me-2"></i>@cls.ClassName
                                    </h5>
                                    <p class="text-muted mb-3">@(cls.Subject?.SubjectName ?? "Subject Not Set")</p>
                                    <div class="row text-center mb-3">
                                        <div class="col-6">
                                            <h6 class="mb-1">@studentCount</h6>
                                            <small class="text-muted">Students</small>
                                        </div>
                                        <div class="col-6">
                                            <h6 class="mb-1">@sessionCount</h6>
                                            <small class="text-muted">Sessions</small>
                                        </div>
                                    </div>
                                    <p class="mb-3">
                                        <small class="text-muted">Avg. Attendance:</small><br>
                                        <span class="badge @badgeClass">@avgAttendance%</span>
                                    </p>
                                    <a asp-controller="Teacher" asp-action="TeachClassDetail" asp-route-id="@cls.ClassId" class="btn btn-sm btn-outline-primary w-100">View Details</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle me-2"></i>No classes assigned yet. Contact your administrator.
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
