@model WebMobileAssignment.Models.Class
@{
    ViewBag.Title = "Edit Class";
    ViewBag.ActiveMenu = "ClassManagement";
    ViewBag.ActiveSubmenu = "Classes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Class</h5>
            <a asp-action="ClassIndex" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>@TempData["ErrorMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="dashboard-card bg-white p-4 rounded shadow-sm">
            <form asp-action="ClassEdit" method="post">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error!</strong> Please correct the following errors:
                        <ul class="mb-0 mt-2">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                <input type="hidden" name="classId" value="@Model.ClassId" />

                <!-- Header with ID display -->
                <div class="alert alert-light border d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-info-circle-fill text-info me-2"></i>
                    <div>
                        Editing details for Class ID: <strong>@Model.ClassId</strong>
                        | Current Enrollments: <span class="badge bg-info">@Model.CurrentCapacity/@Model.MaxCapacity</span>
                    </div>
                </div>

                <!-- Basic Information -->
                <h6 class="text-muted mb-3 border-bottom pb-2">
                    <i class="bi bi-book text-danger me-2"></i>Basic Information
                </h6>
                <div class="row">
                    <!-- Class Name -->
                    <div class="col-md-6 mb-3">
                        <label for="className" class="form-label">Class Name <span class="text-danger">*</span></label>
                        <input type="text" id="className" name="className" class="form-control" value="@Model.ClassName" required />
                    </div>

                    <!-- Subject -->
                    <div class="col-md-6 mb-3">
                        <label for="subjectId" class="form-label">Subject</label>
                        <select id="subjectId" name="subjectId" class="form-select">
                            <option value="">-- No Subject --</option>
                            @if (ViewBag.Subjects != null)
                            {
                                @foreach (var subject in ViewBag.Subjects)
                                {
                                    <option value="@subject.SubjectId" selected="@(Model.SubjectId == subject.SubjectId)">
                                        @subject.SubjectName (@subject.SubjectId)
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <!-- Teacher Assignment -->
                    <div class="col-md-6 mb-3">
                        <label for="teacherId" class="form-label">Assigned Teacher</label>
                        <select id="teacherId" name="teacherId" class="form-select">
                            <option value="">-- No Teacher Assigned --</option>
                            @if (ViewBag.Teachers != null)
                            {
                                @foreach (var teacher in ViewBag.Teachers)
                                {
                                    <option value="@teacher.TeacherId" selected="@(Model.TeacherId == teacher.TeacherId)">
                                        @teacher.User.FullName (@teacher.TeacherId)
                                        @if (!string.IsNullOrEmpty(teacher.SubjectTeach))
                                        {
                                            <text> - @teacher.SubjectTeach</text>
                                        }
                                    </option>
                                }
                            }
                        </select>
                        @if (Model.Teacher != null)
                        {
                            <small class="text-muted">Current: @Model.Teacher.User.FullName</small>
                        }
                    </div>

                    <!-- Room Number -->
                    <div class="col-md-6 mb-3">
                        <label for="roomNumber" class="form-label">Venue/Room <span class="text-danger">*</span></label>
                        <select id="roomNumber" name="roomNumber" class="form-select" required>
                            <option value="">-- Select Venue --</option>
                            <option value="K101" selected="@(Model.RoomNumber == "K101")">K101</option>
                            <option value="K102" selected="@(Model.RoomNumber == "K102")">K102</option>
                            <option value="K103" selected="@(Model.RoomNumber == "K103")">K103</option>
                            <option value="K104" selected="@(Model.RoomNumber == "K104")">K104</option>
                            <option value="K201" selected="@(Model.RoomNumber == "K201")">K201</option>
                            <option value="K202" selected="@(Model.RoomNumber == "K202")">K202</option>
                            <option value="K203" selected="@(Model.RoomNumber == "K203")">K203</option>
                            <option value="K204" selected="@(Model.RoomNumber == "K204")">K204</option>
                            <option value="D101" selected="@(Model.RoomNumber == "D101")">D101</option>
                            <option value="D102" selected="@(Model.RoomNumber == "D102")">D102</option>
                        </select>
                        <small class="text-muted">Physical location where class is held</small>
                    </div>
                </div>

                <!-- Schedule Information -->
                <h6 class="text-muted mb-3 mt-4 border-bottom pb-2">
                    <i class="bi bi-calendar-week text-danger me-2"></i>Schedule Information
                </h6>
                <div class="row">
                    <!-- Day of Week -->
                    <div class="col-md-4 mb-3">
                        <label for="day" class="form-label">Day of Week</label>
                        <select id="day" name="day" class="form-select">
                            <option value="">-- No Day Set --</option>
                            <option value="Monday" selected="@(Model.Day == "Monday")">Monday</option>
                            <option value="Tuesday" selected="@(Model.Day == "Tuesday")">Tuesday</option>
                            <option value="Wednesday" selected="@(Model.Day == "Wednesday")">Wednesday</option>
                            <option value="Thursday" selected="@(Model.Day == "Thursday")">Thursday</option>
                            <option value="Friday" selected="@(Model.Day == "Friday")">Friday</option>
                            <option value="Saturday" selected="@(Model.Day == "Saturday")">Saturday</option>
                            <option value="Sunday" selected="@(Model.Day == "Sunday")">Sunday</option>
                        </select>
                    </div>

                    <!-- Start Time -->
                    <div class="col-md-4 mb-3">
                        <label for="startTime" class="form-label">Start Time</label>
                        <input type="time" id="startTime" name="startTime" class="form-control" 
                               value="@(Model.StartTime?.ToString("hh\\:mm"))" />
                    </div>

                    <!-- End Time -->
                    <div class="col-md-4 mb-3">
                        <label for="endTime" class="form-label">End Time</label>
                        <input type="time" id="endTime" name="endTime" class="form-control" 
                               value="@(Model.EndTime?.ToString("hh\\:mm"))" />
                    </div>
                </div>

                <!-- Capacity Information -->
                <h6 class="text-muted mb-3 mt-4 border-bottom pb-2">
                    <i class="bi bi-people text-danger me-2"></i>Capacity Settings
                </h6>
                <div class="row">
                    <!-- Max Capacity -->
                    <div class="col-md-6 mb-3">
                        <label for="maxCapacity" class="form-label">Maximum Capacity <span class="text-danger">*</span></label>
                        <input type="number" id="maxCapacity" name="maxCapacity" class="form-control" 
                               min="@Model.CurrentCapacity" max="1000" value="@Model.MaxCapacity" required />
                        <small class="text-muted">
                            Must be at least <strong>@Model.CurrentCapacity</strong> (current enrollments)
                        </small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="alert alert-info mb-0">
                            <strong>Current Status:</strong><br />
                            Enrolled: <span class="badge bg-primary">@Model.CurrentCapacity</span><br />
                            Max Capacity: <span class="badge bg-secondary">@Model.MaxCapacity</span><br />
                            Available: <span class="badge bg-success">@(Model.MaxCapacity - Model.CurrentCapacity)</span>
                        </div>
                    </div>
                </div>

                <!-- Student Enrollment Management -->
                <h6 class="text-muted mb-3 mt-4 border-bottom pb-2">
                    <i class="bi bi-person-plus text-danger me-2"></i>Student Enrollment
                </h6>
                
                <!-- Pending Changes Alert -->
                <div id="enrollment-changes-alert" class="alert alert-info d-none mb-3" role="alert">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <strong>Pending Changes:</strong> <span id="changes-summary"></span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="reset-changes-btn">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset All Changes
                        </button>
                    </div>
                </div>
                
                <div class="row">
                    <!-- Currently Enrolled Students -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-people-fill text-primary me-1"></i>Currently Enrolled Students
                            <span class="badge bg-primary ms-2">@(Model.Enrollments?.Count(e => e.UnenrolledDate == null) ?? 0)</span>
                        </label>
                        <input type="text" id="search-enrolled" class="form-control form-control-sm mb-2" placeholder="🔍 Search enrolled students...">
                        <div class="student-list-container border rounded p-2">
                            @if (Model.Enrollments != null && Model.Enrollments.Any())
                            {
                                <input type="hidden" id="removeStudentIds" name="removeStudentIds" />
                                <div id="enrolled-list" class="list-group">
                                    @foreach (var enrollment in Model.Enrollments.Where(e => e.UnenrolledDate == null))
                                    {
                                        <div class="list-group-item list-group-item-action enrolled-student-item mb-1" 
                                             data-student-id="@enrollment.StudentId"
                                             data-student-name="@enrollment.Student.User.FullName">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center">
                                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" 
                                                             style="width: 32px; height: 32px; font-size: 14px;">
                                                            @enrollment.Student.User.FullName.Substring(0, 1).ToUpper()
                                                        </div>
                                                        <div>
                                                            <strong class="student-name-text text-white">@enrollment.Student.User.FullName</strong>
                                                            <span class="badge bg-success ms-1" style="font-size: 0.65rem;">Active</span>
                                                            <br />
                                                            <small class="text-muted">
                                                                <i class="bi bi-hash"></i>@enrollment.StudentId | 
                                                                <i class="bi bi-calendar-check"></i>@enrollment.EnrolledDate.ToString("MMM dd, yyyy")
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-outline-danger toggle-remove-btn" 
                                                        data-student-id="@enrollment.StudentId"
                                                        data-student-name="@enrollment.Student.User.FullName">
                                                    <i class="bi bi-dash-circle"></i> Remove
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="bi bi-inbox" style="font-size: 2rem; color: #dee2e6;"></i>
                                    <p class="text-muted mb-0 mt-2">No students currently enrolled</p>
                                </div>
                            }
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i> Click "Remove" to mark for unenrollment (can be undone before saving)
                        </small>
                    </div>

                    <!-- Add Students -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-person-plus-fill text-success me-1"></i>Add Students to Class
                            <span class="badge bg-secondary ms-2" id="available-count">
                                @{
                                    var enrolledIds = Model.Enrollments?.Where(e => e.UnenrolledDate == null).Select(e => e.StudentId).ToList() ?? new List<string>();
                                    var availCount = ViewBag.Students != null ? ((List<WebMobileAssignment.Models.Student>)ViewBag.Students).Count(s => !enrolledIds.Contains(s.StudentId)) : 0;
                                }
                                @availCount Available
                            </span>
                        </label>
                        <input type="text" id="search-available" class="form-control form-control-sm mb-2" placeholder="🔍 Search available students...">
                        <div class="student-list-container border rounded p-2">
                            @if (ViewBag.Students != null && ((List<WebMobileAssignment.Models.Student>)ViewBag.Students).Any())
                            {
                                var enrolledStudentIds = Model.Enrollments?.Where(e => e.UnenrolledDate == null).Select(e => e.StudentId).ToList() ?? new List<string>();
                                var availableStudents = ((List<WebMobileAssignment.Models.Student>)ViewBag.Students)
                                    .Where(s => !enrolledStudentIds.Contains(s.StudentId))
                                    .OrderBy(s => s.User.FullName)
                                    .ToList();

                                @if (availableStudents.Any())
                                {
                                    <div id="available-list" class="list-group">
                                        @foreach (var student in availableStudents)
                                        {
                                            <label class="list-group-item list-group-item-action mb-1 available-student-item" 
                                                   for="student_@student.StudentId"
                                                   data-student-name="@student.User.FullName">
                                                <div class="d-flex align-items-center">
                                                    <input class="form-check-input me-2 flex-shrink-0" type="checkbox" 
                                                           name="studentIds" value="@student.StudentId" 
                                                           id="student_@student.StudentId">
                                                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0" 
                                                         style="width: 32px; height: 32px; font-size: 14px;">
                                                        @student.User.FullName.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <strong class="student-name-text text-white">@student.User.FullName</strong>
                                                        <br />
                                                        <small class="text-muted">
                                                            <i class="bi bi-hash"></i>@student.StudentId
                                                            @if (student.Parent != null)
                                                            {
                                                                <span> | <i class="bi bi-person"></i>@student.Parent.User.FullName</span>
                                                            }
                                                        </small>
                                                    </div>
                                                </div>
                                            </label>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="bi bi-check-circle-fill text-success" style="font-size: 2rem;"></i>
                                        <p class="text-muted mb-0 mt-2">All students are already enrolled</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="bi bi-inbox" style="font-size: 2rem; color: #dee2e6;"></i>
                                    <p class="text-muted mb-0 mt-2">No students available</p>
                                </div>
                            }
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i> Check students to enroll them in this class
                        </small>
                    </div>
                </div>

                <h6 class="text-muted mb-3 mt-4 border-bottom pb-2">
                    <i class="bi bi-toggle-on text-danger me-2"></i>Status
                </h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="isActive" name="isActive" value="true"
                                   @(Model.IsActive ? "checked" : "") />
                            <label class="form-check-label" for="isActive">
                                Class is Active
                            </label>
                        </div>
                        <small class="text-muted">
                            Inactive classes won't show in attendance for future dates
                        </small>
                    </div>
                </div>

                @if (Model.CurrentCapacity > 0)
                {
                    <div class="alert alert-warning mt-3" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> This class has @Model.CurrentCapacity enrolled student(s). 
                        You cannot reduce max capacity below the current enrollment count.
                    </div>
                }

                <div class="row mt-4">
                    <div class="col-12 text-end">
                        <a asp-action="ClassIndex" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-check-circle"></i> Update Class
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            const currentCapacity = @Model.CurrentCapacity;
            let studentsToRemove = [];
            
            // Search functionality for enrolled students
            $('#search-enrolled').on('keyup', function() {
                const searchText = $(this).val().toLowerCase();
                $('.enrolled-student-item').each(function() {
                    const studentName = $(this).data('student-name').toLowerCase();
                    $(this).toggle(studentName.includes(searchText));
                });
            });
            
            // Search functionality for available students
            $('#search-available').on('keyup', function() {
                const searchText = $(this).val().toLowerCase();
                $('.available-student-item').each(function() {
                    const studentName = $(this).data('student-name').toLowerCase();
                    $(this).toggle(studentName.includes(searchText));
                });
            });
            
            // Validate max capacity with pending changes
            $('#maxCapacity').on('change', function() {
                const maxCap = parseInt($(this).val());
                const projectedCapacity = currentCapacity - studentsToRemove.length + $('input[name="studentIds"]:checked').length;
                
                if (maxCap < projectedCapacity) {
                    alert(`Maximum capacity (${maxCap}) cannot be less than projected enrollment (${projectedCapacity}).\n\nCurrent: ${currentCapacity} | Removing: ${studentsToRemove.length} | Adding: ${$('input[name="studentIds"]:checked').length}`);
                    $(this).val(projectedCapacity);
                }
            });

            // Validate time range
            $('#startTime, #endTime').on('change', function() {
                const startTime = $('#startTime').val();
                const endTime = $('#endTime').val();
                
                if (startTime && endTime && startTime >= endTime) {
                    alert('End time must be after start time');
                    $('#endTime').val('');
                }
            });

            // Handle student removal toggle (can be undone)
            $(document).on('click', '.toggle-remove-btn', function() {
                const studentId = $(this).data('student-id');
                const studentName = $(this).data('student-name');
                const item = $(this).closest('.enrolled-student-item');
                const isMarkedForRemoval = studentsToRemove.includes(studentId);
                
                if (isMarkedForRemoval) {
                    // Undo removal
                    studentsToRemove = studentsToRemove.filter(id => id !== studentId);
                    item.removeClass('marked-for-removal')
                        .find('.student-name-text').removeClass('text-decoration-line-through');
                    item.find('.badge').removeClass('bg-danger').addClass('bg-success').text('Active');
                    $(this).removeClass('btn-success').addClass('btn-outline-danger')
                        .html('<i class="bi bi-dash-circle"></i> Remove');
                } else {
                    // Mark for removal
                    studentsToRemove.push(studentId);
                    item.addClass('marked-for-removal')
                        .find('.student-name-text').addClass('text-decoration-line-through');
                    item.find('.badge').removeClass('bg-success').addClass('bg-danger').text('To Remove');
                    $(this).removeClass('btn-outline-danger').addClass('btn-success')
                        .html('<i class="bi bi-arrow-counterclockwise"></i> Undo');
                }
                
                $('#removeStudentIds').val(studentsToRemove.join(','));
                updateEnrollmentSummary();
            });

            // Monitor student additions
            $('input[name="studentIds"]').on('change', function() {
                const checkbox = $(this);
                const label = checkbox.closest('.available-student-item');
                
                if (checkbox.is(':checked')) {
                    label.addClass('checked');
                } else {
                    label.removeClass('checked');
                }
                
                updateEnrollmentSummary();
            });

            // Reset all changes
            $('#reset-changes-btn').on('click', function() {
                if (confirm('Reset all pending changes? This will undo all student additions and removals.')) {
                    // Undo all removals
                    studentsToRemove.forEach(studentId => {
                        const item = $(`.enrolled-student-item[data-student-id="${studentId}"]`);
                        item.removeClass('marked-for-removal')
                            .find('.student-name-text').removeClass('text-decoration-line-through');
                        item.find('.badge').removeClass('bg-danger').addClass('bg-success').text('Active');
                        item.find('.toggle-remove-btn')
                            .removeClass('btn-success').addClass('btn-outline-danger')
                            .html('<i class="bi bi-dash-circle"></i> Remove');
                    });
                    studentsToRemove = [];
                    $('#removeStudentIds').val('');
                    
                    // Uncheck all additions
                    $('input[name="studentIds"]:checked').each(function() {
                        $(this).prop('checked', false)
                            .closest('.available-student-item')
                            .removeClass('checked');
                    });
                    
                    updateEnrollmentSummary();
                }
            });

            // Update enrollment summary
            function updateEnrollmentSummary() {
                const addCount = $('input[name="studentIds"]:checked').length;
                const removeCount = studentsToRemove.length;
                const projectedCapacity = currentCapacity - removeCount + addCount;
                const maxCap = parseInt($('#maxCapacity').val());
                
                // Check capacity
                if (projectedCapacity > maxCap) {
                    alert(`Cannot make these changes!\n\nProjected enrollment (${projectedCapacity}) would exceed maximum capacity (${maxCap}).\n\nPlease increase max capacity or reduce the number of students to add.`);
                    return false;
                }
                
                // Update summary display
                if (addCount > 0 || removeCount > 0) {
                    let summary = [];
                    if (addCount > 0) summary.push(`<span class="text-success"><i class="bi bi-plus-circle-fill"></i> ${addCount} to enroll</span>`);
                    if (removeCount > 0) summary.push(`<span class="text-danger"><i class="bi bi-dash-circle-fill"></i> ${removeCount} to remove</span>`);
                    summary.push(`<span class="text-info"><i class="bi bi-people-fill"></i> Projected: ${projectedCapacity}/${maxCap}</span>`);
                    
                    $('#changes-summary').html(summary.join(' | '));
                    $('#enrollment-changes-alert').removeClass('d-none');
                } else {
                    $('#enrollment-changes-alert').addClass('d-none');
                }
                
                return true;
            }
            
            // Initialize on page load
            updateEnrollmentSummary();
        });
    </script>
}
