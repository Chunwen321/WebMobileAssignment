@{
    ViewBag.Title = "Notifications";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
<style>
    /* Dark mode support for notification details */
    body.dark-mode .bg-white {
        background-color: rgba(255, 255, 255, 0.05) !important;
        color: #e0e0e0;
    }
    
    body.dark-mode .bg-light {
        background-color: rgba(255, 255, 255, 0.03) !important;
        color: #e0e0e0;
    }
    
    body.dark-mode .modal-content {
        background-color: #1a1a1a;
        color: #e0e0e0;
    }
    
    body.dark-mode .modal-header {
        background-color: #2a2a2a;
        border-bottom-color: #404040;
    }
    
    body.dark-mode .modal-footer {
        border-top-color: #404040;
    }
    
    body.dark-mode .card {
        background-color: rgba(255, 255, 255, 0.03);
        color: #e0e0e0;
    }
    
    body.dark-mode .text-muted {
        color: #999 !important;
    }
    
    /* Detail section styling */
    .detail-section {
        background-color: #f8f9fa;
    }
    
    body.dark-mode .detail-section {
        background-color: rgba(255, 255, 255, 0.05) !important;
        color: #e0e0e0;
    }
</style>
}

@{
    var notifications = ViewBag.Notifications as List<WebMobileAssignment.Models.Notification> ?? new List<WebMobileAssignment.Models.Notification>();
    var totalNotifications = ViewBag.TotalNotifications ?? 0;
    var unreadCount = ViewBag.UnreadCount ?? 0;
    var readCount = ViewBag.ReadCount ?? 0;
    var leaveCount = ViewBag.LeaveCount ?? 0;
    var announcementCount = ViewBag.AnnouncementCount ?? 0;
}

<form method="post" id="notificationForm">
    @Html.AntiForgeryToken()
</form>

<div class="row g-3 mb-4">
    <!-- Notification Stats -->
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #0d6efd;">
            <div class="stat-label">Total Notifications</div>
            <div class="stat-value">@totalNotifications</div>
            <div class="stat-change">
                <i class="bi bi-bell-fill"></i>
                <span>All time</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #dc3545;">
            <div class="stat-label">Unread</div>
            <div class="stat-value">@unreadCount</div>
            <div class="stat-change">
                <i class="bi bi-envelope-fill"></i>
                <span>Needs attention</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #ffc107;">
            <div class="stat-label">Leave Applications</div>
            <div class="stat-value">@leaveCount</div>
            <div class="stat-change">
                <i class="bi bi-calendar-x"></i>
                <span>Pending reviews</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #d63384;">
            <div class="stat-label">System Announcements</div>
            <div class="stat-value">@announcementCount</div>
            <div class="stat-change">
                <i class="bi bi-megaphone-fill"></i>
                <span>Unread announcements</span>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-card">
    <div class="card-header-custom">
        <div>
            <h3 class="card-title">
                <i class="bi bi-bell-fill"></i>
                All Notifications
            </h3>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <a asp-action="CreateAnnouncement" class="btn btn-sm btn-danger">
                <i class="bi bi-megaphone-fill me-2"></i>Create Announcement
            </a>
            @if (unreadCount > 0)
            {
                <button class="btn btn-sm btn-outline-primary" onclick="markAllAsRead()">
                    <i class="bi bi-check-all me-2"></i>Mark All as Read
                </button>
            }
            <button class="btn btn-sm btn-outline-danger" onclick="deleteAllRead()">
                <i class="bi bi-trash me-2"></i>Clear Read
            </button>
            <div class="input-group input-group-sm" style="max-width: 250px;">
                <input type="text" class="form-control" id="searchInput" placeholder="Search notifications..." onkeyup="filterNotifications()">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <ul class="nav nav-tabs" role="tablist" style="border-bottom: 1px solid var(--border-color); padding: 0 1rem;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab" aria-controls="all" aria-selected="true" onclick="filterByType('all')">
                <i class="bi bi-bell me-1"></i>All
                <span class="badge bg-secondary ms-2">@totalNotifications</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="unread-tab" data-bs-toggle="tab" data-bs-target="#unread" type="button" role="tab" aria-controls="unread" aria-selected="false" onclick="filterByType('unread')">
                <i class="bi bi-envelope-fill me-1"></i>Unread
                <span class="badge bg-danger ms-2">@unreadCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="announcements-tab" data-bs-toggle="tab" data-bs-target="#announcements" type="button" role="tab" aria-controls="announcements" aria-selected="false" onclick="filterByType('announcements')">
                <i class="bi bi-megaphone-fill me-1"></i>Announcements
                <span class="badge bg-danger ms-2">@announcementCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="leave-tab" data-bs-toggle="tab" data-bs-target="#leave" type="button" role="tab" aria-controls="leave" aria-selected="false" onclick="filterByType('leave')">
                <i class="bi bi-calendar-x me-1"></i>Leave Applications
                <span class="badge bg-warning text-dark ms-2">@leaveCount</span>
            </button>
        </li>
    </ul>

    <!-- Notifications List -->
    <div class="tab-content">
        <div class="tab-pane fade show active" id="all" role="tabpanel" aria-labelledby="all-tab">
            @if (notifications.Any(n => n.Type != "Announcement"))
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications.Where(n => n.Type != "Announcement"))
                    {
                        var isUnread = notification.Status == "unread";
                        var isLeave = notification.Description.ToLower().Contains("leave application");
                        var isSystem = notification.Type == "Announcement" || 
                                       notification.Description.ToLower().Contains("system") || 
                                       notification.Description.ToLower().Contains("update");

                        var iconClass = isLeave ? "bi-calendar-x" : (isSystem ? "bi-info-circle-fill" : "bi-bell-fill");
                        var iconType = isLeave ? "warning" : (isSystem ? "primary" : "success");
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item notification-record @(isUnread ? "unread" : "read") @(isLeave ? "type-leave" : (isSystem ? "type-system" : "type-general"))" 
                             data-type="@(isLeave ? "leave" : (isSystem ? "system" : "general"))" 
                             data-status="@(isUnread ? "unread" : "read")"
                             data-notification-id="@notification.NotificationId"
                             style="cursor: pointer;"
                             onclick="showNotificationDetails('@notification.NotificationId')">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon @iconType flex-shrink-0">
                                        <i class="bi @iconClass"></i>
                                    </div>
                                    <div class="flex-grow-1 notification-content">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                                <small class="text-muted">
                                                    <i class="bi bi-clock me-1"></i>@timeAgo
                                                </small>
                                            </div>
                                            @if (isUnread)
                                            {
                                                <span class="badge bg-danger flex-shrink-0">Unread</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-2 notification-description">@notification.Description</p>
                            </div>
                            <div class="notification-footer">
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (isUnread)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation(); markAsRead('@notification.NotificationId')">
                                            <i class="bi bi-check me-1"></i>Mark as Read
                                        </button>
                                    }
                                    @if (isLeave)
                                    {
                                        <a href="@Url.Action("LeaveIndex", "Admin")" class="btn btn-sm btn-outline-warning" onclick="event.stopPropagation();">
                                            <i class="bi bi-arrow-right me-1"></i>View Leave Applications
                                        </a>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation(); deleteNotification('@notification.NotificationId')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-bell-slash" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No notifications yet</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="unread" role="tabpanel" aria-labelledby="unread-tab">
            @if (notifications.Any(n => n.Status == "unread" && n.Type != "Announcement"))
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications.Where(n => n.Status == "unread" && n.Type != "Announcement"))
                    {
                        var isLeave = notification.Description.ToLower().Contains("leave application");
                        var isSystem = notification.Type == "Announcement" || 
                                       notification.Description.ToLower().Contains("system") || 
                                       notification.Description.ToLower().Contains("update");
                        var iconClass = isLeave ? "bi-calendar-x" : (isSystem ? "bi-info-circle-fill" : "bi-bell-fill");
                        var iconType = isLeave ? "warning" : (isSystem ? "primary" : "success");
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item unread">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon @iconType">
                                        <i class="bi @iconClass"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@timeAgo</small>
                                    </div>
                                    <span class="badge bg-danger">Unread</span>
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-2">@notification.Description</p>
                            </div>
                            <div class="notification-footer">
                                <div class="d-flex gap-2 flex-wrap">
                                    <button class="btn btn-sm btn-outline-primary" onclick="markAsRead('@notification.NotificationId')">
                                        <i class="bi bi-check me-1"></i>Mark as Read
                                    </button>
                                    @if (isLeave)
                                    {
                                        <a href="@Url.Action("LeaveIndex", "Admin")" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-arrow-right me-1"></i>View Leave Applications
                                        </a>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteNotification('@notification.NotificationId')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-check-circle" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">All caught up! No unread notifications</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="announcements" role="tabpanel" aria-labelledby="announcements-tab">
            @if (notifications.Any(n => n.Type == "Announcement"))
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications.Where(n => n.Type == "Announcement"))
                    {
                        var isUnread = notification.Status == "unread";
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item notification-record type-system @(isUnread ? "unread" : "read")" 
                             data-type="announcement" 
                             data-status="@(isUnread ? "unread" : "read")"
                             data-notification-id="@notification.NotificationId"
                             style="cursor: pointer;"
                             onclick="showNotificationDetails('@notification.NotificationId')">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon danger flex-shrink-0">
                                        <i class="bi bi-megaphone-fill"></i>
                                    </div>
                                    <div class="flex-grow-1 notification-content">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <h6 class="mb-1">System Announcement</h6>
                                                <small class="text-muted">
                                                    <i class="bi bi-clock me-1"></i>@timeAgo
                                                </small>
                                            </div>
                                            @if (isUnread)
                                            {
                                                <span class="badge bg-danger flex-shrink-0">Unread</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-2 notification-description">@notification.Description</p>
                            </div>
                            <div class="notification-footer">
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (isUnread)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation(); markAsRead('@notification.NotificationId')">
                                            <i class="bi bi-check me-1"></i>Mark as Read
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation(); deleteNotification('@notification.NotificationId')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-megaphone-slash" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No system announcements</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="leave" role="tabpanel" aria-labelledby="leave-tab">
            @if (notifications.Any(n => n.Type == "Leave Application" || n.Type == "Student Leave Application"))
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications.Where(n => n.Type == "Leave Application" || n.Type == "Student Leave Application"))
                    {
                        var isUnread = notification.Status == "unread";
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item type-leave @(isUnread ? "unread" : "read")">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon warning">
                                        <i class="bi bi-calendar-x"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@timeAgo</small>
                                    </div>
                                    @if (isUnread)
                                    {
                                        <span class="badge bg-danger">Unread</span>
                                    }
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-2">@notification.Description</p>
                            </div>
                            <div class="notification-footer">
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (isUnread)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" onclick="markAsRead('@notification.NotificationId')">
                                            <i class="bi bi-check me-1"></i>Mark as Read
                                        </button>
                                    }
                                    <a href="@Url.Action("LeaveIndex", "Admin")" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-arrow-right me-1"></i>View All Leave Applications
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteNotification('@notification.NotificationId')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-check" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No leave application notifications</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Notification Details Modal -->
<div class="modal fade" id="notificationDetailModal" tabindex="-1" aria-labelledby="notificationDetailModalLabel">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="notificationDetailModalLabel">
                    <i class="bi bi-bell-fill me-2"></i><span id="modalNotificationType">Notification</span> Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="notificationDetailBody">
                <!-- Content will be loaded dynamically -->
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime date)
    {
        var timeSpan = DateTime.Now - date;

        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} minute{((int)timeSpan.TotalMinutes == 1 ? "" : "s")} ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} hour{((int)timeSpan.TotalHours == 1 ? "" : "s")} ago";
        if (timeSpan.TotalDays < 30)
            return $"{(int)timeSpan.TotalDays} day{((int)timeSpan.TotalDays == 1 ? "" : "s")} ago";
        if (timeSpan.TotalDays < 365)
            return $"{(int)(timeSpan.TotalDays / 30)} month{((int)(timeSpan.TotalDays / 30) == 1 ? "" : "s")} ago";

        return date.ToString("MMM dd, yyyy");
    }

    string GetNotificationTitle(string description)
    {
        if (description.ToLower().Contains("leave application"))
            return "New Leave Application";
        if (description.ToLower().Contains("system"))
            return "System Notification";
        if (description.ToLower().Contains("update"))
            return "System Update";
        if (description.ToLower().Contains("attendance"))
            return "Attendance Alert";

        return "Notification";
    }
}

@section Scripts {
<script>
    function markAsRead(notificationId) {
        $.ajax({
            url: '@Url.Action("MarkAsRead", "Admin")',
            type: 'POST',
            data: {
                notificationId: notificationId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    // Update the notification card UI
                    const notificationCard = $('[data-notification-id="' + notificationId + '"]');
                    notificationCard.removeClass('unread').addClass('read');
                    notificationCard.attr('data-status', 'read');
                    notificationCard.find('.badge.bg-danger').remove();
                    notificationCard.find('.btn-outline-primary:contains("Mark as Read")').remove();
                    
                    // Update the unread count badge in layout
                    updateNotificationBadge();
                    
                    // Update tab counts
                    updateTabCounts();
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function() {
                alert('An error occurred while marking notification as read.');
            }
        });
    }

    function markAllAsRead() {
        if (confirm('Mark all notifications as read?')) {
            $.ajax({
                url: '@Url.Action("MarkAllAsRead", "Admin")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        // Update all unread notification cards
                        $('.notification-record.unread').each(function() {
                            $(this).removeClass('unread').addClass('read');
                            $(this).attr('data-status', 'read');
                            $(this).find('.badge.bg-danger').remove();
                            $(this).find('.btn-outline-primary:contains("Mark as Read")').remove();
                        });
                        
                        // Update the unread count badge in layout
                        updateNotificationBadge();
                        
                        // Update tab counts
                        updateTabCounts();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while marking all notifications as read.');
                }
            });
        }
    }

    function deleteNotification(notificationId) {
        if (confirm('Are you sure you want to delete this notification?')) {
            $.ajax({
                url: '@Url.Action("DeleteNotification", "Admin")',
                type: 'POST',
                data: {
                    notificationId: notificationId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while deleting the notification.');
                }
            });
        }
    }

    // Helper function to update notification badge in layout
    function updateNotificationBadge() {
        $.ajax({
            url: '@Url.Action("GetUnreadNotificationCount", "Admin")',
            type: 'GET',
            success: function(response) {
                if (response.success && response.count !== undefined) {
                    // Update top bar badge
                    if (response.count > 0) {
                        $('#notificationBadge').text(response.count).show();
                    } else {
                        $('#notificationBadge').text('0').hide();
                    }
                    
                    // Update sidebar badge
                    if (response.count > 0) {
                        $('#sidebarNotificationBadge').text(response.count).show();
                    } else {
                        $('#sidebarNotificationBadge').text('0').hide();
                    }
                }
            }
        });
    }

    // Helper function to update tab counts
    function updateTabCounts() {
        const unreadCount = $('.notification-record[data-status="unread"]').length;
        const readCount = $('.notification-record[data-status="read"]').length;
        const totalCount = unreadCount + readCount;
        
        $('#all-tab').html('<i class="bi bi-list-ul me-2"></i>All <span class="badge bg-primary ms-2">' + totalCount + '</span>');
        $('#unread-tab').html('<i class="bi bi-envelope me-2"></i>Unread <span class="badge bg-danger ms-2">' + unreadCount + '</span>');
        $('#read-tab').html('<i class="bi bi-envelope-open me-2"></i>Read <span class="badge bg-success ms-2">' + readCount + '</span>');
    }

    function deleteAllRead() {
        if (confirm('Delete all read notifications? This cannot be undone.')) {
            $.ajax({
                url: '@Url.Action("DeleteAllRead", "Admin")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while deleting read notifications.');
                }
            });
        }
    }

    function filterByType(type) {
        // Tab switching is handled by Bootstrap
    }

    function filterNotifications() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const notifications = document.querySelectorAll('.notification-record');

        notifications.forEach(notification => {
            const title = notification.querySelector('.notification-content h6').textContent.toLowerCase();
            const description = notification.querySelector('.notification-description').textContent.toLowerCase();

            if (title.includes(searchTerm) || description.includes(searchTerm)) {
                notification.style.display = '';
            } else {
                notification.style.display = 'none';
            }
        });
    }

    function showNotificationDetails(notificationId) {
        // Show modal with loading state
        const modal = new bootstrap.Modal(document.getElementById('notificationDetailModal'));
        modal.show();

        // Mark notification as read
        $.ajax({
            url: '@Url.Action("MarkAsRead", "Admin")',
            type: 'POST',
            data: {
                notificationId: notificationId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    // Update the notification card to show as read
                    const notificationCard = $('[data-notification-id="' + notificationId + '"]');
                    notificationCard.removeClass('unread').addClass('read');
                    notificationCard.attr('data-status', 'read');
                    notificationCard.find('.badge.bg-danger').remove();
                    // Remove the "Mark as Read" button
                    notificationCard.find('.btn-outline-primary:contains("Mark as Read")').remove();
                    
                    // Update the unread count badge in layout
                    updateNotificationBadge();
                    
                    // Update tab counts
                    updateTabCounts();
                }
            }
        });

        // Fetch notification details
        $.ajax({
            url: '@Url.Action("GetNotificationDetails", "Admin")',
            type: 'GET',
            data: { notificationId: notificationId },
            success: function(response) {
                if (response.success) {
                    $('#modalNotificationType').text(response.notification.type || 'Notification');
                    $('#notificationDetailBody').html(buildNotificationDetailHTML(response));
                } else {
                    $('#notificationDetailBody').html('<div class="alert alert-danger">Error loading notification details: ' + response.message + '</div>');
                }
            },
            error: function() {
                $('#notificationDetailBody').html('<div class="alert alert-danger">An error occurred while loading notification details.</div>');
            }
        });
    }

    function buildNotificationDetailHTML(response) {
        const notification = response.notification;
        const details = response.details;
        let html = '';

        console.log('Building notification HTML for type:', notification.type);
        console.log('Details object:', details);

        if (!details) {
            // Only show basic info if no details available
            console.warn('No details available for notification');
            html += '<div class="mb-3">';
            html += '<div class="d-flex justify-content-between align-items-start mb-2">';
            html += '<span class="badge bg-primary">' + notification.type + '</span>';
            html += '<small class="text-muted"><i class="bi bi-clock me-1"></i>' + notification.createdDate + '</small>';
            html += '</div>';
            html += '<p class="text-muted mb-0">' + notification.description + '</p>';
            html += '</div>';
            return html;
        }

        // Build details based on notification type
        switch (notification.type) {
            case 'Class Assignment':
                html += buildClassAssignmentDetails(details);
                break;
            case 'Student Enrollment':
            case 'Student Unenrollment':
                html += buildStudentEnrollmentDetails(details);
                break;
            case 'Leave Application':
            case 'Student Leave Application':
            case 'Leave Approved':
            case 'Leave Rejected':
                html += buildLeaveDetails(details);
                break;
            case 'Student Registration':
                console.log('Building Student Registration details');
                html += buildStudentRegistrationDetails(details);
                break;
            case 'Teacher Registration':
            case 'Parent Registration':
                html += buildUserRegistrationDetails(details);
                break;
            case 'Attendance Marked':
            case 'Low Attendance Alert':
            case 'Low Attendance Warning':
                html += buildAttendanceDetails(details);
                break;
            case 'Class Capacity Alert':
                html += buildClassCapacityDetails(details);
                break;
            case 'Announcement':
                html += buildAnnouncementDetails(details, notification);
                break;
            default:
                html += '<p class="text-muted">No additional details available.</p>';
        }

        return html;
    }

    function buildClassAssignmentDetails(details) {
        let html = '<h6 class="mb-3"><i class="bi bi-book me-2"></i>Class Details</h6>';
        html += '<div class="row g-3">';
        html += '<div class="col-md-6"><strong>Class Name:</strong><br/>' + details.className + '</div>';
        html += '<div class="col-md-6"><strong>Class Code:</strong><br/>' + details.classCode + '</div>';
        html += '<div class="col-md-6"><strong>Teacher:</strong><br/>' + (details.teacher || 'N/A') + '</div>';
        html += '<div class="col-md-6"><strong>Venue:</strong><br/>' + (details.venue || 'N/A') + '</div>';
        html += '<div class="col-md-6"><strong>Day:</strong><br/>' + (details.day || 'N/A') + '</div>';
        html += '<div class="col-md-6"><strong>Time:</strong><br/>' + (details.time || 'N/A') + '</div>';
        html += '<div class="col-md-6"><strong>Capacity:</strong><br/>' + details.capacity + '</div>';
        if (details.description) {
            html += '<div class="col-12"><strong>Description:</strong><br/>' + details.description + '</div>';
        }
        html += '</div>';
        return html;
    }

    function buildStudentEnrollmentDetails(details) {
        // Determine teacher title
        let teacherTitle = 'Teacher';
        if (details.teacherGender) {
            teacherTitle = details.teacherGender.toLowerCase() === 'male' ? 'Mr.' : 
                          details.teacherGender.toLowerCase() === 'female' ? 'Ms.' : 'Teacher';
        }
        
        let html = '<div class="enrollment-letter-style">';
        
        // Greeting
        html += '<div class="greeting-section">';
        html += '<h5 class="text-primary mb-3">Dear ' + teacherTitle + ' ' + (details.teacherName || '') + ',</h5>';
        html += '<p class="lead">Below student(s) have just enrolled into your <strong>' + details.className + '</strong> class.</p>';
        html += '</div>';

        // Student list
        if (details.students && details.students.length > 0) {
            html += '<div class="students-list-section my-4">';
            html += '<div class="list-group list-group-flush">';
            details.students.forEach((student, index) => {
                html += '<div class="list-group-item d-flex align-items-center px-0 py-3 border-bottom">';
                html += '<div class="student-number me-3">';
                html += '<span class="badge bg-primary rounded-circle" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; font-size: 1rem;">' + (index + 1) + '</span>';
                html += '</div>';
                html += '<div class="student-info flex-grow-1">';
                html += '<h6 class="mb-1 text-dark">' + student.studentName + '</h6>';
                html += '<small class="text-muted"><i class="bi bi-person-badge me-1"></i>Student ID: <strong>' + student.studentId + '</strong></small>';
                html += '<small class="text-muted ms-3"><i class="bi bi-envelope me-1"></i>' + student.email + '</small>';
                html += '</div>';
                html += '<div class="enrollment-date text-end">';
                html += '<small class="text-muted"><i class="bi bi-calendar-check me-1"></i>' + student.enrolledDate + '</small>';
                html += '</div>';
                html += '</div>';
            });
            html += '</div>';
            html += '</div>';
        }

        // Class Details
        html += '<div class="class-details-section mt-4">';
        html += '<h6 class="mb-3 text-secondary"><i class="bi bi-info-circle me-2"></i>Class Details</h6>';
        html += '<div class="details-card p-3 bg-light rounded">';
        html += '<div class="row g-3">';
        
        if (details.className) {
            html += '<div class="col-md-6">';
            html += '<div class="detail-item">';
            html += '<i class="bi bi-mortarboard text-primary me-2"></i>';
            html += '<strong>Class Name:</strong> <span class="ms-2">' + details.className + '</span>';
            html += '</div>';
            html += '</div>';
        }
        
        if (details.subject) {
            html += '<div class="col-md-6">';
            html += '<div class="detail-item">';
            html += '<i class="bi bi-book text-primary me-2"></i>';
            html += '<strong>Subject:</strong> <span class="ms-2">' + details.subject + '</span>';
            html += '</div>';
            html += '</div>';
        }
        
        if (details.day) {
            html += '<div class="col-md-6">';
            html += '<div class="detail-item">';
            html += '<i class="bi bi-calendar3 text-success me-2"></i>';
            html += '<strong>Day:</strong> <span class="ms-2">' + details.day + '</span>';
            html += '</div>';
            html += '</div>';
        }
        
        if (details.startTime && details.endTime) {
            html += '<div class="col-md-6">';
            html += '<div class="detail-item">';
            html += '<i class="bi bi-clock text-info me-2"></i>';
            html += '<strong>Time:</strong> <span class="ms-2">' + details.startTime + ' - ' + details.endTime + '</span>';
            html += '</div>';
            html += '</div>';
        }
        
        if (details.room) {
            html += '<div class="col-md-6">';
            html += '<div class="detail-item">';
            html += '<i class="bi bi-geo-alt text-danger me-2"></i>';
            html += '<strong>Venue:</strong> <span class="ms-2">' + details.room + '</span>';
            html += '</div>';
            html += '</div>';
        }
        
        html += '<div class="col-md-6">';
        html += '<div class="detail-item">';
        html += '<i class="bi bi-people text-warning me-2"></i>';
        html += '<strong>Total Enrolled:</strong> <span class="ms-2">' + details.totalEnrolled + ' / ' + details.capacity + '</span>';
        html += '</div>';
        html += '</div>';
        
        html += '</div>'; // row
        html += '</div>'; // details-card
        html += '</div>'; // class-details-section
        
        html += '</div>'; // enrollment-letter-style
        
        return html;
    }

