                (parseFloat(details.utilizationRate) >= 100 ? 'danger' : 'warning') + ' fs-6">' + 
                details.utilizationRate + '</span></div>';
        html += '</div>';
        return html;
    }

    function buildAnnouncementDetails(details, notification) {
        let html = '<div class="announcement-details">';
        html += '<div class="d-flex align-items-center mb-3">';
        html += '<div class="notification-icon danger me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">';
        html += '<i class="bi bi-megaphone-fill" style="font-size: 1.5rem;"></i>';
