@{
    ViewBag.Title = "Notifications";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@{
    var notifications = ViewBag.Notifications as List<WebMobileAssignment.Models.Notification> ?? new List<WebMobileAssignment.Models.Notification>();
    var totalNotifications = ViewBag.TotalNotifications ?? 0;
    var unreadCount = ViewBag.UnreadCount ?? 0;
    var readCount = ViewBag.ReadCount ?? 0;
    var leaveCount = ViewBag.LeaveCount ?? 0;
}

<form method="post" id="notificationForm">
    @Html.AntiForgeryToken()
</form>

<div class="row g-3 mb-4">
    <!-- Notification Stats -->
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #0d6efd;">
            <div class="stat-label">Total Notifications</div>
            <div class="stat-value">@totalNotifications</div>
            <div class="stat-change">
                <i class="bi bi-bell-fill"></i>
                <span>All time</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #dc3545;">
            <div class="stat-label">Unread</div>
            <div class="stat-value">@unreadCount</div>
            <div class="stat-change">
                <i class="bi bi-envelope-fill"></i>
                <span>Needs attention</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #ffc107;">
            <div class="stat-label">Leave Applications</div>
            <div class="stat-value">@leaveCount</div>
            <div class="stat-change">
                <i class="bi bi-calendar-x"></i>
                <span>Pending reviews</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-left-color: #198754;">
            <div class="stat-label">Completed</div>
            <div class="stat-value">@readCount</div>
            <div class="stat-change positive">
                <i class="bi bi-check-circle-fill"></i>
                <span>Read & acknowledged</span>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-card">
    <div class="card-header-custom">
        <div>
            <h3 class="card-title">
                <i class="bi bi-bell-fill"></i>
                All Notifications
            </h3>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            @if (unreadCount > 0)
            {
                <button class="btn btn-sm btn-outline-primary" onclick="markAllAsRead()">
                    <i class="bi bi-check-all me-2"></i>Mark All as Read
                </button>
            }
            <button class="btn btn-sm btn-outline-danger" onclick="deleteAllRead()">
                <i class="bi bi-trash me-2"></i>Clear Read
            </button>
            <div class="input-group input-group-sm" style="max-width: 250px;">
                <input type="text" class="form-control" id="searchInput" placeholder="Search notifications..." onkeyup="filterNotifications()">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <ul class="nav nav-tabs" role="tablist" style="border-bottom: 1px solid var(--border-color); padding: 0 1rem;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab" aria-controls="all" aria-selected="true" onclick="filterByType('all')">
                <i class="bi bi-bell me-1"></i>All
                <span class="badge bg-secondary ms-2">@totalNotifications</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="unread-tab" data-bs-toggle="tab" data-bs-target="#unread" type="button" role="tab" aria-controls="unread" aria-selected="false" onclick="filterByType('unread')">
                <i class="bi bi-envelope-fill me-1"></i>Unread
                <span class="badge bg-danger ms-2">@unreadCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="leave-tab" data-bs-toggle="tab" data-bs-target="#leave" type="button" role="tab" aria-controls="leave" aria-selected="false" onclick="filterByType('leave')">
                <i class="bi bi-calendar-x me-1"></i>Leave Applications
                <span class="badge bg-warning text-dark ms-2">@leaveCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="system-tab" data-bs-toggle="tab" data-bs-target="#system" type="button" role="tab" aria-controls="system" aria-selected="false" onclick="filterByType('system')">
                <i class="bi bi-info-circle me-1"></i>System
            </button>
        </li>
    </ul>

    <!-- Notifications List -->
    <div class="tab-content">
        <div class="tab-pane fade show active" id="all" role="tabpanel" aria-labelledby="all-tab">
            @if (notifications.Any())
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications)
                    {
                        var isUnread = notification.Status == "unread";
                        var isLeave = notification.Description.ToLower().Contains("leave application");
                        var isSystem = notification.Description.ToLower().Contains("system") || 
                                       notification.Description.ToLower().Contains("update");

                        var iconClass = isLeave ? "bi-calendar-x" : (isSystem ? "bi-info-circle-fill" : "bi-bell-fill");
                        var iconType = isLeave ? "warning" : (isSystem ? "primary" : "success");
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item notification-record @(isUnread ? "unread" : "read") @(isLeave ? "type-leave" : (isSystem ? "type-system" : "type-general"))" data-type="@(isLeave ? "leave" : (isSystem ? "system" : "general"))" data-status="@(isUnread ? "unread" : "read")">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon @iconType flex-shrink-0">
                                        <i class="bi @iconClass"></i>
                                    </div>
                                    <div class="flex-grow-1 notification-content">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                                <small class="text-muted">
                                                    <i class="bi bi-clock me-1"></i>@timeAgo
                                                </small>
                                            </div>
                                            @if (isUnread)
                                            {
                                                <span class="badge bg-danger flex-shrink-0">Unread</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-2 notification-description">@notification.Description</p>
                            </div>
                            <div class="notification-footer">
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (isUnread)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" onclick="markAsRead('@notification.NotificationId')">
                                            <i class="bi bi-check me-1"></i>Mark as Read
                                        </button>
                                    }
                                    @if (isLeave)
                                    {
                                        <a href="@Url.Action("LeaveIndex", "Admin")" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-arrow-right me-1"></i>View Leave Applications
                                        </a>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteNotification('@notification.NotificationId')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-bell-slash" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No notifications yet</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="unread" role="tabpanel" aria-labelledby="unread-tab">
            @if (notifications.Any(n => n.Status == "unread"))
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications.Where(n => n.Status == "unread"))
                    {
                        var isLeave = notification.Description.ToLower().Contains("leave application");
                        var isSystem = notification.Description.ToLower().Contains("system") || 
                                       notification.Description.ToLower().Contains("update");
                        var iconClass = isLeave ? "bi-calendar-x" : (isSystem ? "bi-info-circle-fill" : "bi-bell-fill");
                        var iconType = isLeave ? "warning" : (isSystem ? "primary" : "success");
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item unread">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon @iconType">
                                        <i class="bi @iconClass"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@timeAgo</small>
                                    </div>
                                    <span class="badge bg-danger">Unread</span>
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-2">@notification.Description</p>
                            </div>
                            <div class="notification-footer">
                                <div class="d-flex gap-2 flex-wrap">
                                    <button class="btn btn-sm btn-outline-primary" onclick="markAsRead('@notification.NotificationId')">
                                        <i class="bi bi-check me-1"></i>Mark as Read
                                    </button>
                                    @if (isLeave)
                                    {
                                        <a href="@Url.Action("LeaveIndex", "Admin")" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-arrow-right me-1"></i>View Leave Applications
                                        </a>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteNotification('@notification.NotificationId')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-check-circle" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">All caught up! No unread notifications</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="leave" role="tabpanel" aria-labelledby="leave-tab">
            @if (notifications.Any(n => n.Description.ToLower().Contains("leave application")))
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications.Where(n => n.Description.ToLower().Contains("leave application")))
                    {
                        var isUnread = notification.Status == "unread";
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item type-leave @(isUnread ? "unread" : "read")">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon warning">
                                        <i class="bi bi-calendar-x"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@timeAgo</small>
                                    </div>
                                    @if (isUnread)
                                    {
                                        <span class="badge bg-danger">Unread</span>
                                    }
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-2">@notification.Description</p>
                            </div>
                            <div class="notification-footer">
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (isUnread)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" onclick="markAsRead('@notification.NotificationId')">
                                            <i class="bi bi-check me-1"></i>Mark as Read
                                        </button>
                                    }
                                    <a href="@Url.Action("LeaveIndex", "Admin")" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-arrow-right me-1"></i>View All Leave Applications
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteNotification('@notification.NotificationId')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-check" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No leave application notifications</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="system" role="tabpanel" aria-labelledby="system-tab">
            @if (notifications.Any(n => n.Description.ToLower().Contains("system") || n.Description.ToLower().Contains("update")))
            {
                <div class="notifications-container">
                    @foreach (var notification in notifications.Where(n => n.Description.ToLower().Contains("system") || n.Description.ToLower().Contains("update")))
                    {
                        var isUnread = notification.Status == "unread";
                        var timeAgo = GetTimeAgo(notification.CreatedDate);

                        <div class="notification-item type-system @(isUnread ? "unread" : "read")">
                            <div class="notification-header">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div class="notification-icon primary">
                                        <i class="bi bi-info-circle-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@GetNotificationTitle(notification.Description)</h6>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@timeAgo</small>
                                    </div>
                                    @if (isUnread)
                                    {
                                        <span class="badge bg-danger">Unread</span>
                                    }
                                </div>
                            </div>
                            <div class="notification-body">
                                <p class="mb-2">@notification.Description</p>
                            </div>
                            <div class="notification-footer">
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (isUnread)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" onclick="markAsRead('@notification.NotificationId')">
                                            <i class="bi bi-check me-1"></i>Mark as Read
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteNotification('@notification.NotificationId')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-gear" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No system notifications</p>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime date)
    {
        var timeSpan = DateTime.Now - date;

        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} minute{((int)timeSpan.TotalMinutes == 1 ? "" : "s")} ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} hour{((int)timeSpan.TotalHours == 1 ? "" : "s")} ago";
        if (timeSpan.TotalDays < 30)
            return $"{(int)timeSpan.TotalDays} day{((int)timeSpan.TotalDays == 1 ? "" : "s")} ago";
        if (timeSpan.TotalDays < 365)
            return $"{(int)(timeSpan.TotalDays / 30)} month{((int)(timeSpan.TotalDays / 30) == 1 ? "" : "s")} ago";

        return date.ToString("MMM dd, yyyy");
    }

    string GetNotificationTitle(string description)
    {
        if (description.ToLower().Contains("leave application"))
            return "New Leave Application";
        if (description.ToLower().Contains("system"))
            return "System Notification";
        if (description.ToLower().Contains("update"))
            return "System Update";
        if (description.ToLower().Contains("attendance"))
            return "Attendance Alert";

        return "Notification";
    }
}

@section Scripts {
<script>
    function markAsRead(notificationId) {
        $.ajax({
            url: '@Url.Action("MarkAsRead", "Admin")',
            type: 'POST',
            data: {
                notificationId: notificationId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function() {
                alert('An error occurred while marking notification as read.');
            }
        });
    }

    function markAllAsRead() {
        if (confirm('Mark all notifications as read?')) {
            $.ajax({
                url: '@Url.Action("MarkAllAsRead", "Admin")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while marking all notifications as read.');
                }
            });
        }
    }

    function deleteNotification(notificationId) {
        if (confirm('Are you sure you want to delete this notification?')) {
            $.ajax({
                url: '@Url.Action("DeleteNotification", "Admin")',
                type: 'POST',
                data: {
                    notificationId: notificationId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while deleting the notification.');
                }
            });
        }
    }

    function deleteAllRead() {
        if (confirm('Delete all read notifications? This cannot be undone.')) {
            $.ajax({
                url: '@Url.Action("DeleteAllRead", "Admin")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while deleting read notifications.');
                }
            });
        }
    }

    function filterByType(type) {
        // Tab switching is handled by Bootstrap
    }

    function filterNotifications() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const notifications = document.querySelectorAll('.notification-record');

        notifications.forEach(notification => {
            const title = notification.querySelector('.notification-content h6').textContent.toLowerCase();
            const description = notification.querySelector('.notification-description').textContent.toLowerCase();

            if (title.includes(searchTerm) || description.includes(searchTerm)) {
                notification.style.display = '';
            } else {
                notification.style.display = 'none';
            }
        });
    }
</script>
}
