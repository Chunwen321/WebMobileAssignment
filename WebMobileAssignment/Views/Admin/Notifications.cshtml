        }
        html += '<div class="col-md-6"><strong>Current Enrollment:</strong><br/><span class="text-warning fw-bold">' + details.currentEnrollment + '</span></div>';
        html += '<div class="col-md-6"><strong>Max Capacity:</strong><br/>' + details.maxCapacity + '</div>';
