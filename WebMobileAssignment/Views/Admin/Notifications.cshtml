    function buildStudentRegistrationDetails(details) {
        let html = '<h6 class="mb-3"><i class="bi bi-person-plus me-2"></i>New Student Registration</h6>';
        html += '<div class="card border-0 bg-light">';
        html += '<div class="card-body">';
        html += '<div class="text-center mb-4">';
        html += '<div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">';
        html += '<i class="bi bi-person-fill fs-1"></i></div>';
        html += '<h5 class="mt-3 mb-1">' + details.fullName + '</h5>';
        html += '<span class="badge bg-success">Student</span>';
        html += '</div>';
        html += '<div class="row g-3">';
        html += '<div class="col-md-6"><i class="bi bi-hash text-primary me-2"></i><strong>User ID:</strong><br/><span class="ms-4">' + details.userId + '</span></div>';
        html += '<div class="col-md-6"><i class="bi bi-envelope text-primary me-2"></i><strong>Email:</strong><br/><span class="ms-4">' + details.email + '</span></div>';
        html += '<div class="col-md-6"><i class="bi bi-telephone text-primary me-2"></i><strong>Phone:</strong><br/><span class="ms-4">' + (details.phoneNumber || 'N/A') + '</span></div>';
        html += '<div class="col-md-6"><i class="bi bi-check-circle me-2"></i><strong>Status:</strong><br/><span class="ms-4"><span class="badge bg-' + 
                (details.status === 'active' ? 'success' : 'secondary') + ' fs-6">' + details.status.toUpperCase() + '</span></span></div>';
        
        if (details.enrolledClassesCount !== undefined && details.enrolledClassesCount > 0) {
            html += '<div class="col-12 mt-3">';
            html += '<div class="alert alert-info mb-0">';
            html += '<i class="bi bi-book-fill me-2"></i><strong>Enrolled Classes: ' + details.enrolledClassesCount + '</strong>';
            if (details.enrolledClasses && details.enrolledClasses.length > 0) {
                html += '<div class="mt-3 d-flex flex-wrap gap-2">';
                details.enrolledClasses.forEach(cls => {
                    var tooltipContent = '<div class="text-start">';
                    tooltipContent += '<strong>Class ID:</strong> ' + cls.classId + '<br/>';
                    tooltipContent += '<strong>Teacher:</strong> ' + cls.teacher + '<br/>';
                    tooltipContent += '<strong>Subject:</strong> ' + cls.subject + '<br/>';
                    tooltipContent += '<strong>Room:</strong> ' + cls.venue + '<br/>';
                    tooltipContent += '<strong>Schedule:</strong> ' + cls.day + ' ' + cls.time + '<br/>';
                    tooltipContent += '<strong>Capacity:</strong> ' + cls.capacity;
