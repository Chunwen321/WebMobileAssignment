        html += '<small class="text-muted"><i class="bi bi-person-circle me-1"></i>' + details.sentBy + '</small>';
        html += '</div>';
        html += '</div>';
        html += '<div class="card border-0 bg-light">';
        html += '<div class="card-body">';
        html += '<p class="mb-0" style="white-space: pre-wrap; line-height: 1.6;">' + details.message + '</p>';
        html += '</div>';
        html += '</div>';
        html += '<div class="mt-3">';
        html += '<small class="text-muted"><i class="bi bi-calendar-event me-1"></i>Sent on: ' + details.createdDate + '</small>';
        html += '</div>';
