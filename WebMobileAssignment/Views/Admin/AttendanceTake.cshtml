@{
    ViewBag.Title = "Take Attendance";
    ViewBag.ActiveMenu = "AttendanceManagement";
    ViewBag.ActiveSubmenu = "Take";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    var sessions = ViewBag.Sessions as List<WebMobileAssignment.Models.AttendanceSession> ?? new List<WebMobileAssignment.Models.AttendanceSession>();
    var classes = ViewBag.Classes as List<WebMobileAssignment.Models.Class> ?? new List<WebMobileAssignment.Models.Class>();
    var selectedDate = ViewBag.SelectedDate as DateTime? ?? DateTime.Today;
    var selectedDay = ViewBag.SelectedDay?.ToString() ?? DateTime.Now.DayOfWeek.ToString();
}

<!-- Header Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1">
                    <i class="bi bi-qr-code-scan text-danger me-2"></i>
                    Take Attendance
                </h5>
                <p class="text-muted small mb-0">Select a date to view classes scheduled for that day</p>
            </div>
        </div>
    </div>
</div>

<!-- Date Selector -->
<div class="row mb-4">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h6 class="card-title mb-0">
                    <i class="bi bi-calendar3 me-2"></i>Select Date
                </h6>
            </div>
            <div class="p-3">
                <form method="get" asp-controller="Admin" asp-action="AttendanceTake" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="selectedDate" class="form-label fw-semibold">
                            <i class="bi bi-calendar-event me-1"></i>Choose Date
                        </label>
                        <input type="date" 
                               class="form-control" 
                               id="selectedDate" 
                               name="selectedDate" 
                               value="@selectedDate.ToString("yyyy-MM-dd")"
                               max="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")"
                               required />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-2"></i>Load Classes
                        </button>
                        <a asp-action="AttendanceTake" class="btn btn-outline-secondary ms-2">
                            <i class="bi bi-arrow-clockwise me-2"></i>Today
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Classes for Selected Date -->
<div class="row">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h6 class="card-title mb-0">
                    <i class="bi bi-calendar-check me-2"></i>Classes for @selectedDay
                </h6>
            </div>
            <div class="p-3">
                @if (classes != null && classes.Count > 0)
                {
                    var filteredClasses = classes.Where(c => 
                        !string.IsNullOrEmpty(c.Day) && 
                        c.Day.Equals(selectedDay, StringComparison.OrdinalIgnoreCase) &&
                        c.StartTime.HasValue && 
                        c.EndTime.HasValue
                    ).ToList();

                    if (filteredClasses.Any())
                    {
                        <div class="row g-3">
                            @foreach (var cls in filteredClasses)
                            {
                                // Check if there's a valid session for this class on the selected date
                                // A session is valid ONLY if it was created on the exact selected date
                                var session = sessions.FirstOrDefault(s => 
                                    s.ClassId == cls.ClassId && 
                                    s.CreatedDate.Date == selectedDate.Date
                                );
                                var hasSession = session != null;
                                
                                // Check if class is currently active (only if selected date is today)
                                var isToday = selectedDate.Date == DateTime.Today;
                                var currentTime = DateTime.Now.TimeOfDay;
                                var isActive = isToday && currentTime >= cls.StartTime.Value && currentTime <= cls.EndTime.Value;
                                var isPast = isToday && currentTime > cls.EndTime.Value;
                                var isUpcoming = isToday && currentTime < cls.StartTime.Value;
                                var isFutureDate = selectedDate.Date > DateTime.Today;

                                <div class="col-lg-4 col-md-6">
                                    <div class="class-card-vertical @(hasSession ? "has-pin" : "") @(isActive ? "active-now" : "")">
                                        <div class="class-header">
                                            <h6 class="class-name">@cls.ClassName</h6>
                                            <span class="class-badge">@cls.ClassId</span>
                                        </div>

                                        <div class="class-info">
                                            <div class="info-row">
                                                <i class="bi bi-clock"></i>
                                                <span>@cls.StartTime.Value.ToString(@"hh\:mm") - @cls.EndTime.Value.ToString(@"hh\:mm")</span>
                                            </div>
                                            <div class="info-row">
                                                <i class="bi bi-geo-alt"></i>
                                                <span>@(cls.RoomNumber ?? "No venue")</span>
                                            </div>
                                            <div class="info-row">
                                                <i class="bi bi-people"></i>
                                                <span>@cls.Enrollments.Count students</span>
                                            </div>
                                        </div>

                                        <div class="class-status">
                                            @if (isFutureDate)
                                            {
                                                <span class="badge bg-info">
                                                    <i class="bi bi-calendar-event"></i> Future Date
                                                </span>
                                            }
                                            else if (isActive)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-circle-fill blink"></i> Active Now
                                                </span>
                                            }
                                            else if (isPast)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-check-circle"></i> Ended
                                                </span>
                                            }
                                            else if (isUpcoming)
                                            {
                                                <span class="badge bg-info">
                                                    <i class="bi bi-clock"></i> Upcoming
                                                </span>
                                            }
                                            else if (selectedDate.Date < DateTime.Today)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-calendar-x"></i> Past Date
                                                </span>
                                            }
                                        </div>

                                        @if (hasSession)
                                        {
                                            <div class="pin-indicator">
                                                <i class="bi bi-shield-check text-success"></i>
                                                <span>PIN Generated</span>
                                            </div>
                                        }

                                        <a href="@Url.Action("AttendanceClassDetail", "Admin", new { id = cls.ClassId, selectedDate = selectedDate.ToString("yyyy-MM-dd") })" 
                                           class="btn btn-primary btn-sm w-100 mt-2">
                                            @if (hasSession)
                                            {
                                                <i class="bi bi-eye"></i> <text>View PIN & QR</text>
                                            }
                                            else
                                            {
                                                <i class="bi bi-key"></i> <text>View Details</text>
                                            }
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
                            <p class="mt-3 mb-2"><strong>No classes scheduled for @selectedDay</strong></p>
                            <p class="small">Try selecting a different date or check the class schedule.</p>
                            <a href="/Admin/ScheduleIndex" class="btn btn-outline-primary btn-sm mt-2">
                                <i class="bi bi-calendar-week"></i> View Full Schedule
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                        <p class="mt-3">No classes found. Please add classes first.</p>
                        <a href="/Admin/ClassCreate" class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-plus-circle"></i> Add Class
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
