@model WebMobileAssignment.Models.Parent
@{
    ViewBag.Title = "Edit Parent";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Parent</h5>
            <a asp-action="ParentIndex" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>@TempData["ErrorMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="dashboard-card bg-white p-4 rounded shadow-sm">
            <form asp-action="ParentEdit" method="post">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error!</strong> Please correct the following errors:
                        <ul class="mb-0 mt-2">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                <input type="hidden" name="parentId" value="@Model.ParentId" />

                <!-- Header with ID display -->
                <div class="alert alert-light border d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-info-circle-fill text-info me-2"></i>
                    <div>
                        Editing details for Parent ID: <strong>@Model.ParentId</strong>
                    </div>
                </div>

                <!-- Profile Picture Section -->
                <h6 class="text-danger mb-3 border-bottom pb-2">
                    <i class="bi bi-person-badge-fill me-2"></i>Profile Picture
                </h6>
                <div class="row mb-4">
                    <div class="col-md-4 text-center">
                        <div class="profile-picture-container">
                            @if (!string.IsNullOrEmpty(Model.User.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                            {
                                <img id="profilePicturePreview" 
                                     src="@Model.User.ProfilePicture" 
                                     alt="Profile Picture" 
                                     class="img-thumbnail rounded-circle mb-3" 
                                     style="width: 200px; height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 200px; height: 200px;">
                                    <i class="bi bi-person-circle text-secondary" style="font-size: 10rem;"></i>
                                </div>
                            }
                            
                            <div class="d-grid gap-2">
                                <label for="profilePictureFile" class="btn btn-danger">
                                    <i class="bi bi-upload"></i> Choose Photo
                                </label>
                                <input type="file" 
                                       id="profilePictureFile" 
                                       accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" 
                                       style="display: none;">
                                
                                @if (!string.IsNullOrEmpty(Model.User.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                                {
                                    <button type="button" id="deleteProfilePictureBtn" class="btn btn-outline-danger">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                }
                            </div>
                            
                            <div id="uploadProgress" class="mt-3" style="display: none;">
                                <div class="progress">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                         role="progressbar" 
                                         style="width: 100%">Uploading...</div>
                                </div>
                            </div>
                            
                            <div id="uploadMessage" class="mt-3"></div>
                            
                            <small class="text-muted d-block mt-3">
                                <i class="bi bi-info-circle"></i> Max size: 5 MB<br>
                                Formats: JPG, PNG, GIF, WEBP
                            </small>
                        </div>
                    </div>
                    
                    <div class="col-md-8">
                        <div class="alert alert-info border-0" style="background-color: #d1ecf1;">
                            <h6 class="alert-heading">
                                <i class="bi bi-lightbulb-fill me-2 text-info"></i>Profile Picture Guidelines
                            </h6>
                            <ul class="mb-0">
                                <li>Upload a clear photo of the parent/guardian</li>
                                <li>Image will be automatically uploaded to cloud storage (AWS S3)</li>
                                <li>Square images work best (will be displayed as circle)</li>
                                <li>Supported formats: JPG, PNG, GIF, WEBP</li>
                                <li>Maximum file size: 5 MB</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <h6 class="text-danger mb-3 border-bottom pb-2">
                    <i class="bi bi-person-badge me-2"></i>Basic Information
                </h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="fullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="fullName" name="fullName" class="form-control" value="@Model.User.FullName" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" id="email" name="email" class="form-control" value="@Model.User.Email" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="phoneNumber" class="form-label">Phone Number</label>
                        <input type="tel" id="phoneNumber" name="phoneNumber" class="form-control" value="@Model.User.PhoneNumber" placeholder="e.g. +60123456789" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="status" class="form-label">Account Status <span class="text-danger">*</span></label>
                        <select id="status" name="status" class="form-select" required>
                            <option value="active" selected="@(Model.User.Status == "active")">Active</option>
                            <option value="inactive" selected="@(Model.User.Status == "inactive")">Inactive</option>
                            <option value="suspend" selected="@(Model.User.Status == "suspend")">Suspended</option>
                        </select>
                    </div>
                </div>

                <h6 class="text-muted mb-3 mt-4"><i class="bi bi-person-lines-fill"></i> Personal Details</h6>
                <div class="row">
                    <!-- Date of Birth -->
                    <div class="col-md-6 mb-3">
                        <label for="dateOfBirth" class="form-label">Date of Birth</label>
                        <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-control" value="@(Model.User.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- Gender -->
                    <div class="col-md-6 mb-3">
                        <label for="gender" class="form-label">Gender</label>
                        <select id="gender" name="gender" class="form-select">
                            <option value="">Select Gender</option>
                            <option value="Male" selected="@(Model.User.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(Model.User.Gender == "Female")">Female</option>
                            <option value="Other" selected="@(Model.User.Gender == "Other")">Other</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <!-- Address -->
                    <div class="col-12 mb-3">
                        <label for="address" class="form-label">Address</label>
                        <textarea id="address" name="address" class="form-control" rows="3" placeholder="Enter full address">@Model.Address</textarea>
                        <small class="text-muted">Street address, city, state, postal code</small>
                    </div>
                </div>

                @if (Model.Students != null && Model.Students.Any())
                {
                    <div class="mt-3">
                        <h6 class="text-muted mb-3"><i class="bi bi-people-fill"></i> Linked Students</h6>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            This parent has <strong>@Model.Students.Count()</strong> linked student(s):
                            <ul class="mb-0 mt-2">
                                @foreach (var student in Model.Students)
                                {
                                    <li>
                                        @student.User.FullName (@student.StudentId)
                                        <a asp-action="StudentDetails" asp-route-id="@student.StudentId" class="ms-2 text-primary" title="View Student">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <div class="row mt-4">
                    <div class="col-12 text-end">
                        <a asp-action="ParentIndex" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-check-circle"></i> Update Parent
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ==================== PROFILE PICTURE UPLOAD ====================
        (function() {
            const fileInput = document.getElementById('profilePictureFile');
            const preview = document.getElementById('profilePicturePreview');
            const uploadProgress = document.getElementById('uploadProgress');
            const uploadMessage = document.getElementById('uploadMessage');
            const deleteBtn = document.getElementById('deleteProfilePictureBtn');
            const userId = '@Model.User.UserId';

            // File selection handler
            if (fileInput) {
                fileInput.addEventListener('change', async function(e) {
                    const file = e.target.files[0];
                    if (!file) return;

                    // Validate file type
                    const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                    if (!validTypes.includes(file.type)) {
                        showMessage('error', 'Invalid file type. Please upload JPG, PNG, GIF, or WEBP image.');
                        fileInput.value = '';
                        return;
                    }

                    // Validate file size (5 MB)
                    if (file.size > 5 * 1024 * 1024) {
                        showMessage('error', 'File size must not exceed 5 MB.');
                        fileInput.value = '';
                        return;
                    }

                    // Show preview immediately
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        preview.src = e.target.result;
                    };
                    reader.readAsDataURL(file);

                    // Upload to server
                    await uploadFile(file);
                });
            }

            async function uploadFile(file) {
                const formData = new FormData();
                formData.append('file', file);
                formData.append('userId', userId);

                try {
                    // Show progress
                    uploadProgress.style.display = 'block';
                    uploadMessage.innerHTML = '';

                    const response = await fetch('@Url.Action("UploadProfilePicture", "Admin")', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        showMessage('success', result.message);
                        // Replace icon with image
                        preview.outerHTML = `<img id="profilePicturePreview" 
                                                  src="${result.url}" 
                                                  alt="Profile Picture" 
                                                  class="img-thumbnail rounded-circle mb-3" 
                                                  style="width: 200px; height: 200px; object-fit: cover;">`;
                        
                        // Reload page after 1 second to reflect changes
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        showMessage('error', result.message);
                        // Revert preview - check if it's image or icon
                        const originalSrc = '@Model.User.ProfilePicture';
                        if (originalSrc && !originalSrc.startsWith('/images/')) {
                            if (preview.tagName === 'DIV') {
                                preview.outerHTML = `<img id="profilePicturePreview" 
                                                          src="${originalSrc}" 
                                                          alt="Profile Picture" 
                                                          class="img-thumbnail rounded-circle mb-3" 
                                                          style="width: 200px; height: 200px; object-fit: cover;">`;
                            } else {
                                preview.src = originalSrc;
                            }
                        }
                    }
                } catch (error) {
                    showMessage('error', 'Upload failed: ' + error.message);
                } finally {
                    uploadProgress.style.display = 'none';
                    fileInput.value = '';
                }
            }

            // Delete profile picture
            if (deleteBtn) {
                deleteBtn.addEventListener('click', deleteProfilePicture);
            }

            async function deleteProfilePicture() {
                if (!confirm('Are you sure you want to remove the profile picture?')) {
                    return;
                }

                try {
                    uploadProgress.style.display = 'block';
                    uploadMessage.innerHTML = '';

                    const response = await fetch('@Url.Action("DeleteProfilePicture", "Admin")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ userId: userId })
                    });

                    const result = await response.json();

                    if (result.success) {
                        showMessage('success', result.message);
                        // Replace image with icon
                        preview.outerHTML = `<div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 200px; height: 200px;">
                                               <i class="bi bi-person-circle text-secondary" style="font-size: 10rem;"></i>
                                             </div>`;
                        
                        // Reload page after 1 second
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        showMessage('error', result.message);
                    }
                } catch (error) {
                    showMessage('error', 'Delete failed: ' + error.message);
                } finally {
                    uploadProgress.style.display = 'none';
                }
            }

            window.deleteProfilePicture = deleteProfilePicture;

            function showMessage(type, message) {
                const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
                const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
                
                uploadMessage.innerHTML = `
                    <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                        <i class="bi ${icon} me-2"></i>${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
            }
        })();
    </script>
}
