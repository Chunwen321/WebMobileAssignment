@model WebMobileAssignment.Models.Parent
@{
    ViewBag.Title = "Edit Parent";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Parent</h5>
            <a asp-action="ParentIndex" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>@TempData["ErrorMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="dashboard-card bg-white p-4 rounded shadow-sm">
            <form asp-action="ParentEdit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error!</strong> Please correct the following errors:
                        <ul class="mb-0 mt-2">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                <input type="hidden" name="parentId" value="@Model.ParentId" />

                <!-- Header with ID display -->
                <div class="alert alert-light border d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-info-circle-fill text-info me-2"></i>
                    <div>
                        Editing details for Parent ID: <strong>@Model.ParentId</strong>
                    </div>
                </div>

                <!-- Profile Picture Section -->
                <h6 class="text-danger mb-3 border-bottom pb-2">
                    <i class="bi bi-person-badge-fill me-2"></i>Profile Picture
                </h6>
                <div class="row mb-4">
                    <div class="col-md-4 text-center">
                        <div class="profile-picture-container">
                            @if (!string.IsNullOrEmpty(Model.User.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                            {
                                <img id="profilePicturePreview" 
                                     src="@Model.User.ProfilePicture" 
                                     alt="Profile Picture" 
                                     class="img-thumbnail rounded-circle mb-3" 
                                     style="width: 200px; height: 200px; object-fit: cover;"
                                     crossorigin="anonymous">
                            }
                            else
                            {
                                <div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 200px; height: 200px;">
                                    <i class="bi bi-person-circle text-secondary" style="font-size: 10rem;"></i>
                                </div>
                            }
                            
                            <div class="d-grid gap-2">
                                <label for="profilePictureFile" class="btn btn-danger">
                                    <i class="bi bi-upload"></i> Choose Photo
                                </label>
                                <input type="file" 
                                       id="profilePictureFile"
                                       name="profilePicture"
                                       accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" 
                                       style="display: none;">
                                
                                <button type="button" id="btnWebcam" class="btn btn-outline-primary">
                                    <i class="bi bi-camera-fill"></i> Take Photo
                                </button>
                                
                                <button type="button" id="btnEditPhoto" class="btn btn-outline-success" style="display: none;">
                                    <i class="bi bi-crop"></i> Edit Photo
                                </button>
                                
                                @if (string.IsNullOrEmpty(Model.User.ProfilePicture) || Model.User.ProfilePicture.StartsWith("/images/"))
                                {
                                    <button type="button" id="clearProfilePictureBtn" class="btn btn-outline-secondary" style="display: none;">
                                        <i class="bi bi-x"></i> Clear
                                    </button>
                                }
                                
                                @if (!string.IsNullOrEmpty(Model.User.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                                {
                                    <button type="button" id="deleteProfilePictureBtn" class="btn btn-outline-danger">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                }
                            </div>
                            
                            <div id="uploadProgress" class="mt-3" style="display: none;">
                                <div class="progress">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                         role="progressbar" 
                                         style="width: 100%">Uploading...</div>
                                </div>
                            </div>
                            
                            <div id="uploadMessage" class="mt-3"></div>
                            
                            <small class="text-muted d-block mt-3">
                                <i class="bi bi-info-circle"></i> Max size: 5 MB<br>
                                Formats: JPG, PNG, GIF, WEBP
                            </small>
                        </div>
                    </div>
                    
                    <div class="col-md-8">
                        <div class="alert alert-info border-0">
                            <h6 class="alert-heading">
                                <i class="bi bi-lightbulb-fill me-2"></i>Profile Picture Guidelines
                            </h6>
                            <ul class="mb-0">
                                <li>Upload a clear photo of the parent/guardian</li>
                                <li>Use your webcam to take a photo directly</li>
                                <li>Click "Edit Photo" to crop, rotate, and adjust your image</li>
                                <li>Supported formats: JPG, PNG, GIF, WEBP</li>
                                <li>Maximum file size: 5 MB</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <h6 class="text-danger mb-3 border-bottom pb-2">
                    <i class="bi bi-person-badge me-2"></i>Basic Information
                </h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="fullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="fullName" name="fullName" class="form-control" value="@Model.User.FullName" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" id="email" name="email" class="form-control" value="@Model.User.Email" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="phoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                        <input type="tel" id="phoneNumber" name="phoneNumber" class="form-control" value="@Model.User.PhoneNumber" placeholder="e.g. +60123456789" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="status" class="form-label">Account Status <span class="text-danger">*</span></label>
                        <select id="status" name="status" class="form-select" required>
                            <option value="active" selected="@(Model.User.Status == "active")">Active</option>
                            <option value="inactive" selected="@(Model.User.Status == "inactive")">Inactive</option>
                            <option value="suspend" selected="@(Model.User.Status == "suspend")">Suspended</option>
                        </select>
                    </div>
                </div>

                <h6 class="text-muted mb-3 mt-4"><i class="bi bi-person-lines-fill"></i> Personal Details</h6>
                <div class="row">
                    <!-- Date of Birth -->
                    <div class="col-md-6 mb-3">
                        <label for="dateOfBirth" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                        <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-control" value="@(Model.User.DateOfBirth?.ToString("yyyy-MM-dd"))" required />
                    </div>

                    <!-- Gender -->
                    <div class="col-md-6 mb-3">
                        <label for="gender" class="form-label">Gender <span class="text-danger">*</span></label>
                        <select id="gender" name="gender" class="form-select" required>
                            <option value="">Select Gender</option>
                            <option value="Male" selected="@(Model.User.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(Model.User.Gender == "Female")">Female</option>
                            <option value="Other" selected="@(Model.User.Gender == "Other")">Other</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <!-- Address -->
                    <div class="col-12 mb-3">
                        <label for="address" class="form-label">Address <span class="text-danger">*</span></label>
                        <textarea id="address" name="address" class="form-control" rows="3" placeholder="Enter full address" required>@Model.Address</textarea>
                        <small class="text-muted">Street address, city, state, postal code</small>
                    </div>
                </div>

                @if (Model.Students != null && Model.Students.Any())
                {
                    <div class="mt-3">
                        <h6 class="text-muted mb-3"><i class="bi bi-people-fill"></i> Linked Students</h6>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            This parent has <strong>@Model.Students.Count()</strong> linked student(s):
                            <ul class="mb-0 mt-2">
                                @foreach (var student in Model.Students)
                                {
                                    <li>
                                        @student.User.FullName (@student.StudentId)
                                        <a asp-action="StudentDetails" asp-route-id="@student.StudentId" class="ms-2 text-primary" title="View Student">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <div class="row mt-4">
                    <div class="col-12 text-end">
                        <a asp-action="ParentIndex" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-check-circle"></i> Update Parent
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Cropper.js CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />

    <!-- Inject Modals -->
    <div id="imageCropperModals"></div>
    <script>
        // Wait for ImageCropper to be loaded
        function initializeImageCropper() {
            if (typeof ImageCropper !== 'undefined') {
                document.getElementById('imageCropperModals').innerHTML = ImageCropper.getModalHTML();
                
                // ==================== INITIALIZE IMAGE CROPPER ====================
                ImageCropper.init({
                    targetId: 'parent',
                    previewElementId: 'profilePicturePreview',
                    fileInputId: 'profilePictureFile',
                    clearButtonId: 'clearProfilePictureBtn',
                    editButtonId: 'btnEditPhoto',
                    previewWidth: 200,
                    previewHeight: 200
                });

                // Show Edit button if existing profile picture exists
                @if (!string.IsNullOrEmpty(Model.User.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                {
                    <text>
                    var btnEditPhoto = document.getElementById('btnEditPhoto');
                    var clearBtn = document.getElementById('clearProfilePictureBtn');
                    if (btnEditPhoto) btnEditPhoto.style.display = 'block';
                    if (clearBtn) clearBtn.style.display = 'block';
                    </text>
                }

                // ==================== WEBCAM FUNCTIONALITY ====================
                (function() {
                    if (typeof WebcamCapture !== 'undefined') {
                        WebcamCapture.init('profilePicturePreview', 'profilePictureFile', function(file) {
                            console.log('Photo captured from webcam:', file.name);
                            var btnEditPhoto = document.getElementById('btnEditPhoto');
                            var clearBtn = document.getElementById('clearProfilePictureBtn');
                            if (btnEditPhoto) btnEditPhoto.style.display = 'block';
                            if (clearBtn) clearBtn.style.display = 'block';
                        });

                        const webcamBtn = document.getElementById('btnWebcam');
                        if (webcamBtn) {
                            webcamBtn.addEventListener('click', function(e) {
                                e.preventDefault();
                                e.stopPropagation();
                                WebcamCapture.openModal();
                            });
                        }
                    }
                })();

                // ==================== DELETE PROFILE PICTURE FROM S3 ====================
                (function() {
                    const deleteBtn = document.getElementById('deleteProfilePictureBtn');
                    if (deleteBtn) {
                        deleteBtn.addEventListener('click', async function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            if (!confirm('Are you sure you want to permanently remove the profile picture from cloud storage?')) {
                                return;
                            }

                    try {
                        const response = await fetch('@Url.Action("DeleteProfilePicture", "Admin")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ userId: '@Model.User.UserId' })
                        });

                        const result = await response.json();

                        if (result.success) {
                            alert('Profile picture removed successfully from cloud storage!');
                            window.location.reload();
                        } else {
                            alert('Error: ' + result.message);
                        }
                    } catch (error) {
                        alert('Delete failed: ' + error.message);
                    }
                });
            }
        })();
            } else {
                // If ImageCropper not loaded yet, try again after a delay
                setTimeout(initializeImageCropper, 100);
            }
        }
        
        // Call initialization when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeImageCropper);
        } else {
            initializeImageCropper();
        }
    </script>
}
