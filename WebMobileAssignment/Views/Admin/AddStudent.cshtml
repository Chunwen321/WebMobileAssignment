@{
    ViewBag.Title = "Add New Student";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-person-plus-fill"></i> Add New Student</h5>
            <a asp-action="StudentIndex" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="dashboard-card bg-white p-4 rounded shadow-sm">
            <form asp-action="StudentCreate" method="post" id="addStudentForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error!</strong> Please correct the following errors:
                        <ul class="mb-0 mt-2">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Student Personal Information -->
                <h6 class="text-danger mb-3 border-bottom pb-2">
                    <i class="bi bi-person-fill me-2"></i>Student Personal Information
                </h6>

                <!-- Profile Picture Section -->
                <div class="row mb-4">
                    <div class="col-md-4 text-center">
                        <div class="profile-picture-container">
                            <div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 200px; height: 200px;">
                                <i class="bi bi-person-circle text-secondary" style="font-size: 10rem;"></i>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <label for="profilePicture" class="btn btn-danger">
                                    <i class="bi bi-upload"></i> Choose Photo
                                </label>
                                <input type="file" 
                                       id="profilePicture" 
                                       name="profilePicture"
                                       accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" 
                                       style="display: none;"
                                       onchange="previewProfilePicture(event)">
                                
                                <button type="button" id="clearProfilePictureBtn" class="btn btn-outline-danger" style="display: none;" onclick="clearProfilePicture()">
                                    <i class="bi bi-x"></i> Remove
                                </button>
                            </div>
                            
                            <small class="text-muted d-block mt-3">
                                <i class="bi bi-info-circle"></i> Max size: 5 MB<br>
                                Formats: JPG, PNG, GIF, WEBP
                            </small>
                        </div>
                    </div>
                    
                    <div class="col-md-8">
                        <div class="alert alert-info border-0" style="background-color: #d1ecf1;">
                            <h6 class="alert-heading">
                                <i class="bi bi-lightbulb-fill me-2 text-info"></i>Profile Picture Guidelines
                            </h6>
                            <ul class="mb-0">
                                <li>Upload a clear photo of the student</li>
                                <li>Image will be automatically uploaded to cloud storage (AWS S3)</li>
                                <li>Square images work best (will be displayed as circle)</li>
                                <li>Supported formats: JPG, PNG, GIF, WEBP</li>
                                <li>Maximum file size: 5 MB</li>
                                <li>If not uploaded, a default icon will be used</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Full Name -->
                    <div class="col-md-6 mb-3">
                        <label for="fullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="fullName" name="fullName" class="form-control" placeholder="e.g. Alex Smith" value="@ViewBag.FullName" required />
                    </div>

                    <!-- Email -->
                    <div class="col-md-6 mb-3">
                        <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="e.g. alex.smith@student.com" value="@ViewBag.Email" required />
                    </div>
                </div>

                <div class="row">
                    <!-- Date of Birth -->
                    <div class="col-md-6 mb-3">
                        <label for="dateOfBirth" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                        <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-control" value="@ViewBag.DateOfBirth" required />
                    </div>

                    <!-- Phone Number -->
                    <div class="col-md-6 mb-3">
                        <label for="phoneNumber" class="form-label">Phone Number</label>
                        <input type="tel" id="phoneNumber" name="phoneNumber" class="form-control" placeholder="e.g. 012-345-6789" value="@ViewBag.PhoneNumber" />
                    </div>
                </div>

                <div class="row">
                    <!-- Gender -->
                    <div class="col-md-6 mb-3">
                        <label for="gender" class="form-label">Gender <span class="text-danger">*</span></label>
                        <select id="gender" name="gender" class="form-select" required>
                            <option value="">-- Select Gender --</option>
                            <option value="Male" selected="@(ViewBag.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(ViewBag.Gender == "Female")">Female</option>
                        </select>
                    </div>

                    <!-- Status -->
                    <div class="col-md-6 mb-3">
                        <label for="status" class="form-label">Account Status <span class="text-danger">*</span></label>
                        <select id="status" name="status" class="form-select" required>
                            <option value="active" selected="@(ViewBag.Status == "active" || ViewBag.Status == null)">Active</option>
                            <option value="inactive" selected="@(ViewBag.Status == "inactive")">Inactive</option>
                            <option value="suspend" selected="@(ViewBag.Status == "suspend")">Suspend</option>
                            <option value="withdraw" selected="@(ViewBag.Status == "withdraw")">Withdraw</option>
                        </select>
                    </div>
                </div>

                <!-- User Account Settings -->
                <h6 class="text-danger mb-3 mt-4 border-bottom pb-2">
                    <i class="bi bi-gear-fill me-2"></i>Account Settings
                </h6>
                <div class="row">
                    <!-- Default Password Info -->
                    <div class="col-md-12 mb-3">
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-lock-fill me-2"></i>
                            <strong>Automatic Password:</strong> A secure temporary password will be generated and sent to the student's email address.
                        </div>
                    </div>
                </div>

                <!-- Parent Information -->
                <h6 class="text-danger mb-3 mt-4 border-bottom pb-2">
                    <i class="bi bi-people-fill me-2"></i>Parent/Guardian Information
                </h6>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Parent Options:</strong> You can either select an existing parent from the dropdown below, search for a parent by email, or create a new parent by filling in all the fields.
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Select Existing Parent</label>
                        <select id="parentSelect" name="parentId" class="form-select">
                            <option value="">-- Create New Parent or Search --</option>
                            @if (ViewBag.Parents != null)
                            {
                                @foreach (var parent in ViewBag.Parents)
                                {
                                    <option value="@parent.ParentId" 
                                            data-fullname="@parent.User.FullName"
                                            data-email="@parent.User.Email" 
                                            data-phone="@(parent.User.PhoneNumber ?? "")"
                                            data-address="@(parent.Address ?? "")"
                                            data-dob="@(parent.User.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")"
                                            data-gender="@(parent.User.Gender ?? "")"
                                            selected="@(ViewBag.ParentId == parent.ParentId)">
                                        @parent.User.FullName (@parent.User.Email)
                                    </option>
                                }
                            }
                        </select>
                        <small class="text-muted">
                            <i class="bi bi-arrow-right me-1"></i>Select a parent to use their existing account
                        </small>
                    </div>

                    <div class="col-md-6">
                        <label for="parentSearchEmail" class="form-label">Or Search Parent by Email</label>
                        <div class="input-group">
                            <input type="email" id="parentSearchEmail" class="form-control" placeholder="parent@example.com" />
                            <button type="button" id="btnSearchParent" class="btn btn-outline-primary">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                        <small id="searchResult" class="form-text text-muted"></small>
                    </div>
                </div>

                <div id="parentFields">
                    <div class="alert alert-warning mb-3" id="newParentIndicator" style="display: none;">
                        <i class="bi bi-plus-circle me-2"></i>
                        <strong>Creating New Parent:</strong> Fill in all the details below. A temporary password will be automatically generated and sent to the parent's email.
                    </div>
                    
                    <div class="alert alert-success mb-3" id="existingParentIndicator" style="display: none;">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong>Using Existing Parent:</strong> The selected parent's information is shown below (read-only).
                    </div>

                    <!-- Parent Profile Picture Section -->
                    <h6 class="text-muted mb-3 mt-3 border-bottom pb-2">
                        <i class="bi bi-person-badge-fill me-2"></i>Parent Profile Picture (Optional)
                    </h6>
                    <div class="row mb-4">
                        <div class="col-md-4 text-center">
                            <div class="profile-picture-container">
                                <div id="parentProfilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 150px; height: 150px;">
                                    <i class="bi bi-person-circle text-secondary" style="font-size: 7.5rem;"></i>
                                </div>
                                
                                <div class="d-grid gap-2">
                                    <label for="parentProfilePicture" class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-upload"></i> Choose Parent Photo
                                    </label>
                                    <input type="file" 
                                           id="parentProfilePicture" 
                                           name="parentProfilePicture"
                                           accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" 
                                           style="display: none;"
                                           onchange="previewParentProfilePicture(event)">
                                    
                                    <button type="button" id="clearParentProfilePictureBtn" class="btn btn-outline-secondary btn-sm" style="display: none;" onclick="clearParentProfilePicture()">
                                        <i class="bi bi-x"></i> Remove
                                    </button>
                                </div>
                                
                                <small class="text-muted d-block mt-2">
                                    <i class="bi bi-info-circle"></i> Max 5 MB
                                </small>
                            </div>
                        </div>
                        
                        <div class="col-md-8">
                            <div class="alert alert-warning border-0" style="background-color: #fff3cd;">
                                <h6 class="alert-heading">
                                    <i class="bi bi-lightbulb-fill me-2 text-warning"></i>Parent Profile Picture (Optional)
                                </h6>
                                <ul class="mb-0 small">
                                    <li>Upload a photo for the parent/guardian account</li>
                                    <li>This is <strong>optional</strong> - if not uploaded, default icon will be used</li>
                                    <li>Square images work best (displayed as circle)</li>
                                    <li>Max size: 5 MB | Formats: JPG, PNG, GIF, WEBP</li>
                                    <li>Only applies when creating a <strong>new parent</strong> account</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Basic Information -->
                    <h6 class="text-muted mb-2 mt-3"><i class="bi bi-person-badge"></i> Parent Basic Information</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="parentFullName" class="form-label">
                                Parent Full Name
                                <span class="text-danger" id="parentNameRequired" style="display: none;">*</span>
                            </label>
                            <input type="text" id="parentFullName" name="newParentFullName" class="form-control" placeholder="e.g. Robert Doe" />
                            <small class="text-muted">Full legal name as per IC/Passport</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="parentEmail" class="form-label">
                                Parent Email
                                <span class="text-danger" id="parentEmailRequired" style="display: none;">*</span>
                            </label>
                            <input type="email" id="parentEmail" name="newParentEmail" class="form-control" placeholder="parent@example.com" />
                            <small class="text-muted">Used for login and notifications</small>
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <h6 class="text-muted mb-2 mt-3"><i class="bi bi-telephone"></i> Contact Information</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="parentPhone" class="form-label">Parent Phone Number</label>
                            <input type="tel" id="parentPhone" name="newParentPhone" class="form-control" placeholder="e.g. +60123456789" />
                            <small class="text-muted">For emergency contact and SMS notifications</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="parentAddress" class="form-label">Residential Address</label>
                            <textarea id="parentAddress" name="newParentAddress" class="form-control" rows="2" placeholder="Street address, city, state, postal code"></textarea>
                            <small class="text-muted">Current residential address</small>
                        </div>
                    </div>

                    <!-- Personal Details -->
                    <h6 class="text-muted mb-2 mt-3"><i class="bi bi-person-lines-fill"></i> Personal Details</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="parentDateOfBirth" class="form-label">Parent Date of Birth</label>
                            <input type="date" id="parentDateOfBirth" name="newParentDateOfBirth" class="form-control" />
                            <small class="text-muted">Optional - for age verification if needed</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="parentGender" class="form-label">Parent Gender</label>
                            <select id="parentGender" name="newParentGender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <small class="text-muted">Optional - for record purposes</small>
                        </div>
                    </div>

                    <!-- Password Information -->
                    <div class="row">
                        <div class="col-12 mb-3">
                            <div class="alert alert-info mb-0">
                                <i class="bi bi-lock-fill me-2"></i>
                                <strong>Login Credentials:</strong> A secure temporary password will be automatically generated and sent to the parent's email address. The parent will be prompted to change it upon first login.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Academic Details -->
                <h6 class="text-danger mb-3 mt-4 border-bottom pb-2">
                    <i class="bi bi-book-fill me-2"></i>Academic Details
                </h6>
                <div class="row">
                    <!-- Classes (Multiple Selection) -->
                    <div class="col-md-6 mb-3">
                        <label for="classIds" class="form-label">Assigned Classes (Multiple Selection)</label>
                        <select id="classIds" name="classIds" class="form-select" multiple size="8">
                            @if (ViewBag.Classes != null)
                            {
                                @foreach (var cls in ViewBag.Classes)
                                {
                                    var isSelected = ViewBag.ClassIds != null && ((List<string>)ViewBag.ClassIds).Contains(cls.ClassId);
                                    var availableSlots = cls.MaxCapacity - cls.CurrentCapacity;
                                    var isFull = availableSlots <= 0;
                                    var capacityText = isFull ? "FULL" : $"{availableSlots}/{cls.MaxCapacity} available";
                                    var capacityColor = isFull ? "text-danger" : (availableSlots <= 5 ? "text-warning" : "text-success");
                                    
                                    <option value="@cls.ClassId" 
                                            selected="@isSelected"
                                            disabled="@isFull"
                                            data-capacity="@availableSlots"
                                            data-max="@cls.MaxCapacity"
                                            data-current="@cls.CurrentCapacity">
                                        @cls.ClassName (@cls.ClassId) - @capacityText
                                    </option>
                                }
                            }
                        </select>
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>Hold Ctrl (Cmd on Mac) to select multiple classes. 
                            <span class="text-success">Green</span> = available, 
                            <span class="text-warning">Yellow</span> = limited, 
                            <span class="text-danger">Red</span> = full
                        </small>
                    </div>
                    
                    <!-- Selected Classes Display & Enrollment Date -->
                    <div class="col-md-6 mb-3">
                        <label for="enrollmentDate" class="form-label">Enrollment Date</label>
                        <input type="date" id="enrollmentDate" name="enrollmentDate" class="form-control mb-3" value="@(ViewBag.EnrollmentDate ?? DateTime.Now.ToString("yyyy-MM-dd"))" />
                        
                        <label class="form-label d-block">Selected Classes:</label>
                        <div id="selectedClassesList" class="border rounded p-2 bg-light" style="min-height: 150px; max-height: 200px; overflow-y: auto;">
                            <small class="text-muted">No classes selected</small>
                        </div>
                        <small class="text-muted mt-2 d-block">
                            <strong id="selectedCount">0</strong> class(es) selected
                        </small>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="row mt-4 pt-3 border-top">
                    <div class="col-12 d-flex justify-content-between align-items-center">
                        <small class="text-muted"><span class="text-danger">*</span> Required fields</small>
                        <div>
                            <button type="reset" class="btn btn-light me-2">
                                <i class="bi bi-arrow-clockwise"></i> Reset
                            </button>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-save"></i> Save Student
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function() {
            const btnSearch = document.getElementById('btnSearchParent');
            const emailInput = document.getElementById('parentSearchEmail');
            const searchResult = document.getElementById('searchResult');
            const parentFields = document.getElementById('parentFields');
            const parentSelect = document.getElementById('parentSelect');
            const classSelect = document.getElementById('classIds');
            const selectedClassesList = document.getElementById('selectedClassesList');
            const selectedCount = document.getElementById('selectedCount');
            const newParentIndicator = document.getElementById('newParentIndicator');
            const existingParentIndicator = document.getElementById('existingParentIndicator');

            // Parent input fields - matching database columns
            const parentFullName = document.getElementById('parentFullName');
            const parentEmail = document.getElementById('parentEmail');
            const parentPhone = document.getElementById('parentPhone');
            const parentAddress = document.getElementById('parentAddress');
            const parentDateOfBirth = document.getElementById('parentDateOfBirth');
            const parentGender = document.getElementById('parentGender');

            // Required field indicators
            const parentNameRequired = document.getElementById('parentNameRequired');
            const parentEmailRequired = document.getElementById('parentEmailRequired');

            // Show parent form by default (user can edit or fill)
            parentFields.style.display = 'block';

            // Class selection handler
            if (classSelect) {
                classSelect.addEventListener('change', function() {
                    updateSelectedClassesList();
                });
                
                // Initial update
                updateSelectedClassesList();
                
                // Add visual styling to options based on capacity
                updateClassOptionsStyles();
            }

            function updateClassOptionsStyles() {
                const options = classSelect.querySelectorAll('option');
                options.forEach(option => {
                    const availableSlots = parseInt(option.getAttribute('data-capacity')) || 0;
                    const isFull = availableSlots <= 0;
                    
                    if (isFull) {
                        option.style.color = '#dc3545'; // Red for full
                        option.style.fontWeight = 'bold';
                    } else if (availableSlots <= 5) {
                        option.style.color = '#ffc107'; // Yellow for limited
                    } else {
                        option.style.color = '#198754'; // Green for available
                    }
                });
            }

            function updateSelectedClassesList() {
                const selectedOptions = Array.from(classSelect.selectedOptions);
                
                if (selectedOptions.length === 0) {
                    selectedClassesList.innerHTML = '<small class="text-muted">No classes selected</small>';
                    selectedCount.textContent = '0';
                } else {
                    const html = selectedOptions.map((option) => {
                        const availableSlots = option.getAttribute('data-capacity');
                        const maxCapacity = option.getAttribute('data-max');
                        const currentCapacity = option.getAttribute('data-current');
                        const classText = option.text;
                        
                        return `<div class="mb-2 p-2 bg-white border rounded">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <i class="bi bi-book me-1 text-danger"></i>
                                            <strong>${classText.split(' - ')[0]}</strong>
                                        </div>
                                        <span class="badge bg-info">${currentCapacity}/${maxCapacity}</span>
                                    </div>
                                    <small class="text-muted d-block mt-1">
                                        <i class="bi bi-people me-1"></i>${availableSlots} slot(s) available
                                    </small>
                                </div>`;
                    }).join('');
                    selectedClassesList.innerHTML = html;
                    selectedCount.textContent = selectedOptions.length;
                }
            }

            // Function to set parent fields (editable or readonly) - now includes all fields
            function setParentFields(data, isExisting) {
                parentFullName.value = data.fullName || '';
                parentEmail.value = data.email || '';
                parentPhone.value = data.phone || '';
                parentAddress.value = data.address || '';
                parentDateOfBirth.value = data.dob || '';
                parentGender.value = data.gender || '';

                if (isExisting) {
                    // Existing parent - make fields readonly
                    parentFullName.setAttribute('readonly', 'readonly');
                    parentEmail.setAttribute('readonly', 'readonly');
                    parentPhone.setAttribute('readonly', 'readonly');
                    parentAddress.setAttribute('readonly', 'readonly');
                    parentDateOfBirth.setAttribute('readonly', 'readonly');
                    parentGender.setAttribute('disabled', 'disabled');

                    parentFullName.classList.add('bg-light');
                    parentEmail.classList.add('bg-light');
                    parentPhone.classList.add('bg-light');
                    parentAddress.classList.add('bg-light');
                    parentDateOfBirth.classList.add('bg-light');
                    parentGender.classList.add('bg-light');

                    newParentIndicator.style.display = 'none';
                    existingParentIndicator.style.display = 'block';
                    parentNameRequired.style.display = 'none';
                    parentEmailRequired.style.display = 'none';
                } else {
                    // New parent - make fields editable
                    parentFullName.removeAttribute('readonly');
                    parentEmail.removeAttribute('readonly');
                    parentPhone.removeAttribute('readonly');
                    parentAddress.removeAttribute('readonly');
                    parentDateOfBirth.removeAttribute('readonly');
                    parentGender.removeAttribute('disabled');

                    parentFullName.classList.remove('bg-light');
                    parentEmail.classList.remove('bg-light');
                    parentPhone.classList.remove('bg-light');
                    parentAddress.classList.remove('bg-light');
                    parentDateOfBirth.classList.remove('bg-light');
                    parentGender.classList.remove('bg-light');

                    newParentIndicator.style.display = 'block';
                    existingParentIndicator.style.display = 'none';
                    
                    // Show required indicators if creating new parent with data
                    if (data.fullName || data.email) {
                        parentNameRequired.style.display = 'inline';
                        parentEmailRequired.style.display = 'inline';
                    }
                }
            }

            // Function to clear parent fields
            function clearParentFields() {
                parentFullName.value = '';
                parentEmail.value = '';
                parentPhone.value = '';
                parentAddress.value = '';
                parentDateOfBirth.value = '';
                parentGender.value = '';

                parentFullName.removeAttribute('readonly');
                parentEmail.removeAttribute('readonly');
                parentPhone.removeAttribute('readonly');
                parentAddress.removeAttribute('readonly');
                parentDateOfBirth.removeAttribute('readonly');
                parentGender.removeAttribute('disabled');

                parentFullName.classList.remove('bg-light');
                parentEmail.classList.remove('bg-light');
                parentPhone.classList.remove('bg-light');
                parentAddress.classList.remove('bg-light');
                parentDateOfBirth.classList.remove('bg-light');
                parentGender.classList.remove('bg-light');

                newParentIndicator.style.display = 'none';
                existingParentIndicator.style.display = 'none';
                parentNameRequired.style.display = 'none';
                parentEmailRequired.style.display = 'none';
                searchResult.innerHTML = '';
            }

            // Parent dropdown change handler
            parentSelect.addEventListener('change', async function() {
                const selectedOption = parentSelect.options[parentSelect.selectedIndex];
                const parentId = parentSelect.value;

                if (!parentId) {
                    // No selection - clear and allow new parent creation
                    clearParentFields();
                    emailInput.value = '';
                    return;
                }

                // Get data from option data attributes (faster than AJAX)
                const fullName = selectedOption.getAttribute('data-fullname');
                const email = selectedOption.getAttribute('data-email');
                const phone = selectedOption.getAttribute('data-phone');
                const address = selectedOption.getAttribute('data-address');
                const dob = selectedOption.getAttribute('data-dob');
                const gender = selectedOption.getAttribute('data-gender');

                if (fullName && email) {
                    // Use data attributes
                    setParentFields({ fullName, email, phone, address, dob, gender }, true);
                    searchResult.innerHTML = '<i class="bi bi-check-circle text-success me-1"></i>Existing parent selected';
                } else {
                    // Fallback to AJAX if data attributes not available
                    try {
                        const resp = await fetch('/Admin/GetParentById?id=' + encodeURIComponent(parentId));
                        if (!resp.ok) throw new Error('Network error');
                        const data = await resp.json();
                        
                        if (data && data.success) {
                            setParentFields(data, true);
                            searchResult.innerHTML = '<i class="bi bi-check-circle text-success me-1"></i>Existing parent selected';
                        }
                    } catch (err) {
                        console.error(err);
                        searchResult.innerHTML = '<i class="bi bi-exclamation-circle text-danger me-1"></i>Error loading parent details';
                    }
                }

                // Clear search input
                emailInput.value = '';
            });

            // Parent search functionality
            btnSearch.addEventListener('click', async function() {
                const email = emailInput.value.trim();

                if (!email) {
                    searchResult.innerHTML = '<i class="bi bi-exclamation-triangle text-warning me-1"></i>Please enter an email to search';
                    return;
                }

                searchResult.innerHTML = '<i class="bi bi-hourglass-split text-muted me-1"></i>Searching...';
                
                try {
                    const resp = await fetch('/Admin/FindParentByEmail?email=' + encodeURIComponent(email));
                    if (!resp.ok) throw new Error('Network error');
                    const data = await resp.json();

                    if (data && data.success && data.parentId) {
                        // Parent found - select in dropdown if exists, or add if not
                        let optionExists = false;
                        for (let i = 0; i < parentSelect.options.length; i++) {
                            if (parentSelect.options[i].value === data.parentId) {
                                parentSelect.selectedIndex = i;
                                optionExists = true;
                                break;
                            }
                        }

                        if (!optionExists) {
                            // Add to dropdown with all data attributes
                            const option = document.createElement('option');
                            option.value = data.parentId;
                            option.textContent = `${data.fullName} (${data.email})`;
                            option.setAttribute('data-fullname', data.fullName);
                            option.setAttribute('data-email', data.email);
                            option.setAttribute('data-phone', data.phone || '');
                            option.setAttribute('data-address', data.address || '');
                            option.setAttribute('data-dob', data.dob || '');
                            option.setAttribute('data-gender', data.gender || '');
                            option.selected = true;
                            parentSelect.appendChild(option);
                        }

                        // Fill and lock fields
                        setParentFields(data, true);
                        searchResult.innerHTML = '<i class="bi bi-check-circle text-success me-1"></i>Parent found and selected!';
                    } else {
                        // Not found - prepare for new parent creation
                        parentSelect.value = '';
                        setParentFields({ fullName: '', email: email, phone: '', address: '', dob: '', gender: '' }, false);
                        searchResult.innerHTML = '<i class="bi bi-info-circle text-info me-1"></i>Parent not found. You can create a new parent account by filling in the details below.';
                    }
                } catch (err) {
                    console.error(err);
                    searchResult.innerHTML = '<i class="bi bi-exclamation-circle text-danger me-1"></i>Error searching parent';
                }
            });

            // Allow pressing Enter in search field
            emailInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    btnSearch.click();
                }
            });

            // Detect manual changes to parent fields to show new parent indicator
            [parentFullName, parentEmail, parentPhone, parentAddress].forEach(field => {
                field.addEventListener('input', function() {
                    if (!field.hasAttribute('readonly')) {
                        const hasData = parentFullName.value || parentEmail.value || parentPhone.value || parentAddress.value;
                        if (hasData && parentSelect.value === '') {
                            newParentIndicator.style.display = 'block';
                            existingParentIndicator.style.display = 'none';
                            parentNameRequired.style.display = 'inline';
                            parentEmailRequired.style.display = 'inline';
                        }
                    }
                });
            });

            // Clear parent selection when manually editing email field
            parentEmail.addEventListener('focus', function() {
                if (!parentEmail.hasAttribute('readonly') && parentSelect.value !== '') {
                    if (confirm('Do you want to clear the selected parent and create a new one instead?')) {
                        parentSelect.value = '';
                        clearParentFields();
                    }
                }
            });
        })();

        // Profile Picture Preview Functions
        function previewProfilePicture(event) {
            const file = event.target.files[0];
            const preview = document.getElementById('profilePicturePreview');
            const clearBtn = document.getElementById('clearProfilePictureBtn');
            
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must not exceed 5MB');
                    event.target.value = '';
                    return;
                }
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    // Replace icon div with image
                    preview.outerHTML = `<img id="profilePicturePreview" 
                                             src="${e.target.result}" 
                                             alt="Profile Picture" 
                                             class="img-thumbnail rounded-circle mb-3" 
                                             style="width: 200px; height: 200px; object-fit: cover;">`;
                    clearBtn.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }

        function clearProfilePicture() {
            const fileInput = document.getElementById('profilePicture');
            const preview = document.getElementById('profilePicturePreview');
            const clearBtn = document.getElementById('clearProfilePictureBtn');
            
            fileInput.value = '';
            // Replace image with icon
            preview.outerHTML = `<div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 200px; height: 200px;">
                                   <i class="bi bi-person-circle text-secondary" style="font-size: 10rem;"></i>
                                 </div>`;
            clearBtn.style.display = 'none';
        }

        // Parent Profile Picture Preview Functions
        function previewParentProfilePicture(event) {
            const file = event.target.files[0];
            const preview = document.getElementById('parentProfilePicturePreview');
            const clearBtn = document.getElementById('clearParentProfilePictureBtn');
            
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must not exceed 5MB');
                    event.target.value = '';
                    return;
                }
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    // Replace icon div with image
                    preview.outerHTML = `<img id="parentProfilePicturePreview" 
                                             src="${e.target.result}" 
                                             alt="Parent Profile Picture" 
                                             class="img-thumbnail rounded-circle mb-3" 
                                             style="width: 150px; height: 150px; object-fit: cover;">`;
                    clearBtn.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }

        function clearParentProfilePicture() {
            const fileInput = document.getElementById('parentProfilePicture');
            const preview = document.getElementById('parentProfilePicturePreview');
            const clearBtn = document.getElementById('clearParentProfilePictureBtn');
            
            fileInput.value = '';
            // Replace image with icon
            preview.outerHTML = `<div id="parentProfilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 150px; height: 150px;">
                                   <i class="bi bi-person-circle text-secondary" style="font-size: 7.5rem;"></i>
                                 </div>`;
            clearBtn.style.display = 'none';
        }
    </script>
}