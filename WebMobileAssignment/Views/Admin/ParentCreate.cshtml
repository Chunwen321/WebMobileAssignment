@{
    ViewBag.Title = "Add New Parent";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-person-plus-fill"></i> Add New Parent</h5>
            <a asp-action="ParentIndex" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="dashboard-card bg-white p-4 rounded shadow-sm">
            <form asp-action="ParentCreate" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error!</strong> Please correct the following errors:
                        <ul class="mb-0 mt-2">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Profile Picture Section -->
                <h6 class="text-danger mb-3 border-bottom pb-2">
                    <i class="bi bi-person-badge-fill me-2"></i>Profile Picture
                </h6>
                <div class="row mb-4">
                    <div class="col-md-4 text-center">
                        <div class="profile-picture-container">
                            <div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 200px; height: 200px;">
                                <i class="bi bi-person-circle text-secondary" style="font-size: 10rem;"></i>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <label for="profilePicture" class="btn btn-danger">
                                    <i class="bi bi-upload"></i> Choose Photo
                                </label>
                                <input type="file" 
                                       id="profilePicture" 
                                       name="profilePicture"
                                       accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" 
                                       style="display: none;"
                                       onchange="previewProfilePicture(event)">
                                
                                <button type="button" id="clearProfilePictureBtn" class="btn btn-outline-danger" style="display: none;" onclick="clearProfilePicture()">
                                    <i class="bi bi-x"></i> Remove
                                </button>
                            </div>
                            
                            <small class="text-muted d-block mt-3">
                                <i class="bi bi-info-circle"></i> Max size: 5 MB<br>
                                Formats: JPG, PNG, GIF, WEBP
                            </small>
                        </div>
                    </div>
                    
                    <div class="col-md-8">
                        <div class="alert alert-info border-0" style="background-color: #d1ecf1;">
                            <h6 class="alert-heading">
                                <i class="bi bi-lightbulb-fill me-2 text-info"></i>Profile Picture Guidelines
                            </h6>
                            <ul class="mb-0">
                                <li>Upload a clear photo of the parent/guardian</li>
                                <li>Image will be automatically uploaded to cloud storage (AWS S3)</li>
                                <li>Square images work best (will be displayed as circle)</li>
                                <li>Supported formats: JPG, PNG, GIF, WEBP</li>
                                <li>Maximum file size: 5 MB</li>
                                <li>If not uploaded, a default icon will be used</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Basic Information -->
                <h6 class="text-danger mb-3 border-bottom pb-2">
                    <i class="bi bi-person-badge me-2"></i>Basic Information
                </h6>
                <div class="row">
                    <!-- Full Name -->
                    <div class="col-md-6 mb-3">
                        <label for="fullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="fullName" name="fullName" class="form-control" placeholder="e.g. Mary Johnson" value="@ViewBag.FullName" required />
                    </div>

                    <!-- Email -->
                    <div class="col-md-6 mb-3">
                        <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="e.g. mary.johnson@parent.com" value="@ViewBag.Email" required />
                    </div>
                </div>

                <div class="row">
                    <!-- Phone Number -->
                    <div class="col-md-6 mb-3">
                        <label for="phoneNumber" class="form-label">Phone Number</label>
                        <input type="tel" id="phoneNumber" name="phoneNumber" class="form-control" placeholder="e.g. +60123456789" value="@ViewBag.PhoneNumber" />
                        <small class="text-muted">Used for notifications and emergency contact</small>
                    </div>

                    <!-- Default Password Info -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Login Password</label>
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-lock-fill me-2"></i>
                            <strong>Automatic Password:</strong> A secure temporary password will be generated and sent via email<br />
                            <small class="text-muted">Parent will receive login credentials via email</small>
                        </div>
                    </div>
                </div>

                <!-- Personal Details -->
                <h6 class="text-danger mb-3 mt-4 border-bottom pb-2">
                    <i class="bi bi-person-lines-fill me-2"></i>Personal Details
                </h6>
                <div class="row">
                    <!-- Date of Birth -->
                    <div class="col-md-6 mb-3">
                        <label for="dateOfBirth" class="form-label">Date of Birth</label>
                        <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-control" value="@ViewBag.DateOfBirth" />
                    </div>

                    <!-- Gender -->
                    <div class="col-md-6 mb-3">
                        <label for="gender" class="form-label">Gender</label>
                        <select id="gender" name="gender" class="form-select">
                            <option value="">Select Gender</option>
                            <option value="Male" selected="@(ViewBag.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(ViewBag.Gender == "Female")">Female</option>
                            <option value="Other" selected="@(ViewBag.Gender == "Other")">Other</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <!-- Address -->
                    <div class="col-12 mb-3">
                        <label for="address" class="form-label">Address</label>
                        <textarea id="address" name="address" class="form-control" rows="3" placeholder="Enter full address">@ViewBag.Address</textarea>
                        <small class="text-muted">Street address, city, state, postal code</small>
                    </div>
                </div>

                <div class="alert alert-info mt-3" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Note:</strong> After creating the parent account, you can link students to this parent from the student management page.
                </div>

                <div class="row mt-4">
                    <div class="col-12 text-end">
                        <button type="reset" class="btn btn-light me-2">Reset</button>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-save"></i> Save Parent
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Profile Picture Preview Functions
        function previewProfilePicture(event) {
            const file = event.target.files[0];
            const preview = document.getElementById('profilePicturePreview');
            const clearBtn = document.getElementById('clearProfilePictureBtn');
            
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must not exceed 5MB');
                    event.target.value = '';
                    return;
                }
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    // Replace icon div with image
                    preview.outerHTML = `<img id="profilePicturePreview" 
                                             src="${e.target.result}" 
                                             alt="Profile Picture" 
                                             class="img-thumbnail rounded-circle mb-3" 
                                             style="width: 200px; height: 200px; object-fit: cover;">`;
                    clearBtn.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }

        function clearProfilePicture() {
            const fileInput = document.getElementById('profilePicture');
            const preview = document.getElementById('profilePicturePreview');
            const clearBtn = document.getElementById('clearProfilePictureBtn');
            
            fileInput.value = '';
            // Replace image with icon
            preview.outerHTML = `<div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 200px; height: 200px;">
                                   <i class="bi bi-person-circle text-secondary" style="font-size: 10rem;"></i>
                                 </div>`;
            clearBtn.style.display = 'none';
        }
    </script>
}
