@model WebMobileAssignment.Models.Teacher
@{
    ViewBag.Title = "Edit Teacher";
    ViewBag.ActiveMenu = "TeacherManagement";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Teacher</h5>
            <a asp-action="TeacherIndex" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>@TempData["ErrorMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="dashboard-card bg-white p-4 rounded shadow-sm">
            <form asp-action="TeacherEdit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error!</strong> Please correct the following errors:
                        <ul class="mb-0 mt-2">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                <input type="hidden" name="teacherId" value="@Model.TeacherId" />

                <!-- Header with ID display -->
                <div class="alert alert-light border d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-info-circle-fill text-info me-2"></i>
                    <div>
                        Editing details for Teacher ID: <strong>@Model.TeacherId</strong>
                    </div>
                </div>

                <!-- Profile Picture Section -->
                <h6 class="text-danger mb-3 border-bottom pb-2">
                    <i class="bi bi-person-badge-fill me-2"></i>Profile Picture
                </h6>
                <div class="row mb-4">
                    <div class="col-md-4 text-center">
                        <div class="profile-picture-container">
                            @if (!string.IsNullOrEmpty(Model.User.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                            {
                                <img id="profilePicturePreview" 
                                     src="@Model.User.ProfilePicture" 
                                     alt="Profile Picture" 
                                     class="img-thumbnail rounded-circle mb-3" 
                                     style="width: 200px; height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div id="profilePicturePreview" class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 bg-light" style="width: 200px; height: 200px;">
                                    <i class="bi bi-person-circle text-secondary" style="font-size: 10rem;"></i>
                                </div>
                            }
                            
                            <div class="d-grid gap-2">
                                <label for="profilePictureFile" class="btn btn-danger">
                                    <i class="bi bi-upload"></i> Choose Photo
                                </label>
                                <input type="file" 
                                       id="profilePictureFile"
                                       name="profilePicture"
                                       accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" 
                                       style="display: none;">
                                
                                <button type="button" id="btnWebcam" class="btn btn-outline-primary">
                                    <i class="bi bi-camera-fill"></i> Take Photo
                                </button>
                                
                                @if (!string.IsNullOrEmpty(Model.User.ProfilePicture) && !Model.User.ProfilePicture.StartsWith("/images/"))
                                {
                                    <button type="button" id="deleteProfilePictureBtn" class="btn btn-outline-danger">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                }
                            </div>
                            
                            <div id="uploadProgress" class="mt-3" style="display: none;">
                                <div class="progress">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                         role="progressbar" 
                                         style="width: 100%">Uploading...</div>
                                </div>
                            </div>
                            
                            <div id="uploadMessage" class="mt-3"></div>
                            
                            <small class="text-muted d-block mt-3">
                                <i class="bi bi-info-circle"></i> Max size: 5 MB<br>
                                Formats: JPG, PNG, GIF, WEBP
                            </small>
                        </div>
                    </div>
                    
                    <div class="col-md-8">
                        <div class="alert alert-info border-0" style="background-color: #d1ecf1;">
                            <h6 class="alert-heading">
                                <i class="bi bi-lightbulb-fill me-2 text-info"></i>Profile Picture Guidelines
                            </h6>
                            <ul class="mb-0">
                                <li>Upload a clear photo of the teacher</li>
                                <li><strong>NEW:</strong> Use your webcam to take a photo directly</li>
                                <li>Image will be automatically uploaded to cloud storage (AWS S3)</li>
                                <li>Square images work best (will be displayed as circle)</li>
                                <li>Supported formats: JPG, PNG, GIF, WEBP</li>
                                <li>Maximum file size: 5 MB</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Personal Information Section -->
                <h6 class="text-danger mb-3 border-bottom pb-2">
                    <i class="bi bi-person-circle me-2"></i>Personal Information
                </h6>
                <div class="row">
                    <!-- Full Name -->
                    <div class="col-md-6 mb-3">
                        <label for="fullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="fullName" name="fullName" class="form-control" value="@Model.User.FullName" required />
                    </div>

                    <!-- Email -->
                    <div class="col-md-6 mb-3">
                        <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" id="email" name="email" class="form-control" value="@Model.User.Email" required />
                    </div>
                </div>

                <div class="row">
                    <!-- Phone Number -->
                    <div class="col-md-6 mb-3">
                        <label for="phoneNumber" class="form-label">Phone Number</label>
                        <input type="tel" id="phoneNumber" name="phoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="e.g. +60123456789" />
                    </div>

                    <!-- Date of Birth -->
                    <div class="col-md-6 mb-3">
                        <label for="dateOfBirth" class="form-label">Date of Birth</label>
                        <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-control" value="@Model.User.DateOfBirth?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="row">
                    <!-- Gender -->
                    <div class="col-md-6 mb-3">
                        <label for="gender" class="form-label">Gender</label>
                        <select id="gender" name="gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="Male" selected="@(Model.User.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(Model.User.Gender == "Female")">Female</option>
                            <option value="Other" selected="@(Model.User.Gender == "Other")">Other</option>
                        </select>
                    </div>

                    <!-- Status -->
                    <div class="col-md-6 mb-3">
                        <label for="status" class="form-label">Status <span class="text-danger">*</span></label>
                        <select id="status" name="status" class="form-select" required>
                            <option value="active" selected="@(Model.User.Status == "active")">Active</option>
                            <option value="inactive" selected="@(Model.User.Status == "inactive")">Inactive</option>
                            <option value="suspend" selected="@(Model.User.Status == "suspend")">Suspended</option>
                        </select>
                    </div>
                </div>

                <!-- Professional Details Section -->
                <h6 class="text-danger mb-3 mt-4 border-bottom pb-2">
                    <i class="bi bi-briefcase me-2"></i>Professional Details
                </h6>
                <div class="row">
                    <!-- Subject Taught -->
                    <div class="col-md-6 mb-3">
                        <label for="subjectTeach" class="form-label">Primary Subject Taught</label>
                        <input type="text" id="subjectTeach" name="subjectTeach" class="form-control" value="@Model.SubjectTeach" placeholder="e.g. Mathematics, Science, English" />
                    </div>

                    <!-- Hire Date -->
                    <div class="col-md-6 mb-3">
                        <label for="hireDate" class="form-label">Hire Date <span class="text-danger">*</span></label>
                        <input type="date" id="hireDate" name="hireDate" class="form-control" value="@Model.HireDate?.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>

                <div class="row">
                    <!-- Title -->
                    <div class="col-md-6 mb-3">
                        <label for="title" class="form-label">Title/Position</label>
                        <input type="text" id="title" name="title" class="form-control" value="@Model.Title" placeholder="e.g. Senior Teacher, HOD, Principal" />
                    </div>

                    <!-- Education -->
                    <div class="col-md-6 mb-3">
                        <label for="education" class="form-label">Highest Education</label>
                        <input type="text" id="education" name="education" class="form-control" value="@Model.Education" placeholder="e.g. PhD in Mathematics, Master in Education" />
                    </div>
                </div>

                <div class="row">
                    <!-- Skills -->
                    <div class="col-md-12 mb-3">
                        <label for="skill" class="form-label">Skills & Certifications</label>
                        <input type="text" id="skill" name="skill" class="form-control" value="@Model.Skill" placeholder="e.g. TESL Certified, Technology Integration Specialist" />
                    </div>
                </div>

                <div class="row">
                    <!-- Bio -->
                    <div class="col-md-12 mb-3">
                        <label for="bio" class="form-label">Biography/Professional Summary</label>
                        <textarea id="bio" name="bio" class="form-control" rows="4" placeholder="Brief professional background, teaching philosophy, or achievements...">@Model.Bio</textarea>
                        <small class="text-muted">Optional professional summary (max 1000 characters)</small>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12 text-end">
                        <a asp-action="TeacherIndex" class="btn btn-light me-2">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-check-circle"></i> Update Teacher
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Webcam Capture Script -->
    <script src="~/js/webcam-capture.js"></script>

    <script>
        // ==================== WEBCAM FUNCTIONALITY ====================
        (function() {
            // Initialize webcam capture
            WebcamCapture.init('profilePicturePreview', 'profilePictureFile', function(file) {
                console.log('Photo captured from webcam:', file.name);
                // Photo is now in the file input, will be uploaded when form is submitted
            });

            // Webcam button click handler
            const webcamBtn = document.getElementById('btnWebcam');
            if (webcamBtn) {
                webcamBtn.addEventListener('click', function() {
                    WebcamCapture.openModal();
                });
            }
        })();

        // ==================== PROFILE PICTURE PREVIEW (No immediate upload) ====================
        (function() {
            const fileInput = document.getElementById('profilePictureFile');
            const preview = document.getElementById('profilePicturePreview');
            const userId = '@Model.User.UserId';

            // File selection handler - ONLY PREVIEW, don't upload
            if (fileInput) {
                fileInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (!file) return;

                    console.log('File selected:', file.name, file.type, file.size);

                    // Validate file type
                    const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                    if (!validTypes.includes(file.type)) {
                        alert('Invalid file type. Please upload JPG, PNG, GIF, or WEBP image.');
                        fileInput.value = '';
                        return;
                    }

                    // Validate file size (5 MB)
                    if (file.size > 5 * 1024 * 1024) {
                        alert('File size must not exceed 5 MB.');
                        fileInput.value = '';
                        return;
                    }

                    // Show preview only - don't upload yet
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const currentPreview = document.getElementById('profilePicturePreview');
                        if (currentPreview) {
                            currentPreview.outerHTML = `<img id="profilePicturePreview" 
                                                      src="${e.target.result}" 
                                                      alt="Profile Picture" 
                                                      class="img-thumbnail rounded-circle mb-3" 
                                                      style="width: 200px; height: 200px; object-fit: cover;">`;
                        }
                    };
                    reader.readAsDataURL(file);
                });
            }

            // Delete profile picture
            const deleteBtn = document.getElementById('deleteProfilePictureBtn');
            if (deleteBtn) {
                deleteBtn.addEventListener('click', deleteProfilePicture);
            }

            async function deleteProfilePicture() {
                if (!confirm('Are you sure you want to remove the profile picture?')) {
                    return;
                }

                try {
                    const response = await fetch('@Url.Action("DeleteProfilePicture", "Admin")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ userId: userId })
                    });

                    const result = await response.json();

                    if (result.success) {
                        alert('Profile picture removed successfully!');
                        window.location.reload();
                    } else {
                        alert('Error: ' + result.message);
                    }
                } catch (error) {
                    alert('Delete failed: ' + error.message);
                }
            }

            window.deleteProfilePicture = deleteProfilePicture;
        })();
    </script>
}
