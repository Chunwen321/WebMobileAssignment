@model IEnumerable<WebMobileAssignment.Models.Class>
@{
    ViewBag.Title = "Class Management";
    ViewBag.ActiveMenu = "ClassManagement";
    ViewBag.ActiveSubmenu = "Classes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>@TempData["SuccessMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Header Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-2">
                    <i class="bi bi-book-fill text-danger me-2"></i>
                    Class Management
                </h2>
                <p class="text-muted">Manage all classes, schedules, and assignments</p>
            </div>
            <div>
                <a asp-action="ClassCreate" class="btn btn-danger">
                    <i class="bi bi-plus-circle me-2"></i>Create New Class
                </a>
                <a asp-action="ScheduleIndex" class="btn btn-outline-danger">
                    <i class="bi bi-calendar-week me-2"></i>View Schedule
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Stats -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left-color: #0d6efd;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <div class="stat-label">Total Classes</div>
                    <div class="stat-value text-primary">@Model.Count()</div>
                </div>
                <div class="card-icon blue">
                    <i class="bi bi-book"></i>
                </div>
            </div>
            <div class="stat-change">
                <i class="bi bi-graph-up me-1"></i>
                <span>Active courses</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left-color: #198754;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <div class="stat-label">Total Enrollments</div>
                    <div class="stat-value text-success">@Model.Sum(c => c.CurrentCapacity)</div>
                </div>
                <div class="card-icon green">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="stat-change">
                <i class="bi bi-people me-1"></i>
                <span>Enrolled students</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left-color: #ffc107;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <div class="stat-label">Total Capacity</div>
                    <div class="stat-value text-warning">@Model.Sum(c => c.MaxCapacity)</div>
                </div>
                <div class="card-icon yellow">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
            </div>
            <div class="stat-change">
                <i class="bi bi-diagram-3 me-1"></i>
                <span>Maximum seats</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left-color: #dc3545;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <div class="stat-label">Occupancy Rate</div>
                    <div class="stat-value text-danger">
                        @{
                            var totalCapacity = Model.Sum(c => c.MaxCapacity);
                            var totalEnrolled = Model.Sum(c => c.CurrentCapacity);
                            var occupancyRate = totalCapacity > 0 ? (decimal)totalEnrolled / totalCapacity * 100 : 0;
                        }
                        @occupancyRate.ToString("F1")%
                    </div>
                </div>
                <div class="card-icon red">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
            </div>
            <div class="stat-change">
                <i class="bi bi-arrow-up me-1"></i>
                <span>Overall utilization</span>
            </div>
        </div>
    </div>
</div>

<!-- Filter and Search -->
<div class="row mb-4">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h5 class="card-title">
                    <i class="bi bi-funnel"></i>
                    Filter & Sort Classes
                </h5>
            </div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" id="searchInput" placeholder="Search by name, ID, or room...">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Sort By</label>
                    <select class="form-select" id="sortBy">
                        <option value="name-asc">Class Name (A-Z)</option>
                        <option value="name-desc">Class Name (Z-A)</option>
                        <option value="id-asc">Class ID (Asc)</option>
                        <option value="id-desc">Class ID (Desc)</option>
                        <option value="room-asc">Room Number (Asc)</option>
                        <option value="room-desc">Room Number (Desc)</option>
                        <option value="capacity-asc">Enrollment (Low-High)</option>
                        <option value="capacity-desc">Enrollment (High-Low)</option>
                        <option value="occupancy-asc">Occupancy (Low-High)</option>
                        <option value="occupancy-desc">Occupancy (High-Low)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Teacher</label>
                    <select class="form-select" id="teacherFilter">
                        <option value="">All Teachers</option>
                        <option value="assigned">Assigned</option>
                        <option value="unassigned">Unassigned</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Day</label>
                    <select class="form-select" id="dayFilter">
                        <option value="">All Days</option>
                        <option value="monday">Monday</option>
                        <option value="tuesday">Tuesday</option>
                        <option value="wednesday">Wednesday</option>
                        <option value="thursday">Thursday</option>
                        <option value="friday">Friday</option>
                        <option value="saturday">Saturday</option>
                        <option value="sunday">Sunday</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select class="form-select" id="statusFilter">
                        <option value="">All Status</option>
                        <option value="available">Available</option>
                        <option value="almost-full">Almost Full</option>
                        <option value="full">Full</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label">&nbsp;</label>
                    <button class="btn btn-secondary w-100" onclick="clearFilters()" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Classes Grid -->
<div class="row">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-custom">
                <h5 class="card-title">
                    <i class="bi bi-list-ul"></i>
                    All Classes
                </h5>
            </div>

            <div class="row g-3 p-3">
                @if (Model != null && Model.Any())
                {
                    @foreach (var cls in Model)
                    {
                        var fillPercentage = cls.MaxCapacity > 0 ? (decimal)cls.CurrentCapacity / cls.MaxCapacity * 100 : 0;
                        var statusClass = fillPercentage >= 100 ? "danger" : fillPercentage >= 90 ? "warning" : "success";
                        var statusText = fillPercentage >= 100 ? "Full" : fillPercentage >= 90 ? "Almost Full" : "Available";

                        <div class="col-lg-4 col-md-6 class-card"
                             data-name="@cls.ClassName.ToLower()"
                             data-id="@cls.ClassId.ToLower()"
                             data-room="@(cls.RoomNumber?.ToLower() ?? "")"
                             data-capacity="@cls.CurrentCapacity"
                             data-occupancy="@fillPercentage"
                             data-teacher="@(cls.Teacher != null ? "assigned" : "unassigned")"
                             data-day="@(cls.Day?.ToLower() ?? "")"
                             data-status="@(fillPercentage >= 100 ? "full" : fillPercentage >= 90 ? "almost-full" : "available")">

                            <div class="dashboard-card h-100">
                                <div class="class-header" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="mb-0 text-white">@cls.ClassName</h5>
                                            <small class="text-white-50">@cls.ClassId</small>
                                        </div>
                                        <span class="badge bg-@statusClass">@statusText</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="class-details">
                                        <div class="detail-row">
                                            <span class="label">
                                                <i class="bi bi-person me-1"></i>Teacher:
                                            </span>
                                            <span class="value">
                                                @if (cls.Teacher != null)
                                                {
                                                    @cls.Teacher.User.FullName
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unassigned</span>
                                                }
                                            </span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">
                                                <i class="bi bi-calendar me-1"></i>Schedule:
                                            </span>
                                            <span class="value">
                                                @if (!string.IsNullOrEmpty(cls.Day))
                                                {
                                                    <span>@cls.Day</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">
                                                <i class="bi bi-clock me-1"></i>Time:
                                            </span>
                                            <span class="value">
                                                @if (cls.StartTime.HasValue && cls.EndTime.HasValue)
                                                {
                                                    var start = cls.StartTime.Value.ToString("hh\\:mm");
                                                    var end = cls.EndTime.Value.ToString("hh\\:mm");
                                                    @($"{start} - {end}")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="label">
                                                <i class="bi bi-geo-alt me-1"></i>Room:
                                            </span>
                                            <span class="value">@(cls.RoomNumber ?? "Not assigned")</span>
                                        </div>
                                    </div>

                                    <!-- Capacity Bar -->
                                    <div class="mt-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <small class="text-muted">Capacity</small>
                                            <small class="fw-bold">@cls.CurrentCapacity / @cls.MaxCapacity</small>
                                        </div>
                                        <div class="progress" style="height: 10px;">
                                            <div class="progress-bar bg-@statusClass" 
                                                 role="progressbar" 
                                                 style="width: @fillPercentage%"
                                                 aria-valuenow="@cls.CurrentCapacity" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="@cls.MaxCapacity">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Actions -->
                                    <div class="mt-3 d-flex gap-2">
                                        <a asp-action="ClassDetails" asp-route-id="@cls.ClassId" class="btn btn-sm btn-outline-primary flex-fill">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a asp-action="ClassEdit" asp-route-id="@cls.ClassId" class="btn btn-sm btn-outline-warning flex-fill">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="ClassDelete" asp-route-id="@cls.ClassId" class="btn btn-sm btn-outline-danger flex-fill">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                            <p class="mt-3">No classes found</p>
                            <a asp-action="ClassCreate" class="btn btn-danger">
                                <i class="bi bi-plus-circle me-2"></i>Create Your First Class
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Filter and Sort functionality
        const searchInput = document.getElementById('searchInput');
        const sortBy = document.getElementById('sortBy');
        const teacherFilter = document.getElementById('teacherFilter');
        const dayFilter = document.getElementById('dayFilter');
        const statusFilter = document.getElementById('statusFilter');

        function sortClasses() {
            const sortValue = sortBy.value;
            const [field, order] = sortValue.split('-');

            const container = document.querySelector('.row.g-3.p-3');
            const cards = Array.from(document.querySelectorAll('.class-card'));

            const sortFunc = (a, b) => {
                let aVal, bVal;

                if (field === 'capacity' || field === 'occupancy') {
                    aVal = parseFloat(a.getAttribute(`data-${field}`));
                    bVal = parseFloat(b.getAttribute(`data-${field}`));
                } else {
                    aVal = a.getAttribute(`data-${field}`);
                    bVal = b.getAttribute(`data-${field}`);
                }

                if (order === 'asc') {
                    return aVal > bVal ? 1 : aVal < bVal ? -1 : 0;
                } else {
                    return aVal < bVal ? 1 : aVal > bVal ? -1 : 0;
                }
            };

            cards.sort(sortFunc).forEach(card => container.appendChild(card));
        }

        function filterClasses() {
            const searchTerm = searchInput.value.toLowerCase();
            const selectedTeacher = teacherFilter.value;
            const selectedDay = dayFilter.value.toLowerCase();
            const selectedStatus = statusFilter.value;

            document.querySelectorAll('.class-card').forEach(card => {
                const name = card.getAttribute('data-name');
                const id = card.getAttribute('data-id');
                const room = card.getAttribute('data-room');
                const teacher = card.getAttribute('data-teacher');
                const day = card.getAttribute('data-day');
                const status = card.getAttribute('data-status');

                let show = true;

                // Search filter
                if (searchTerm && !(name.includes(searchTerm) || id.includes(searchTerm) || room.includes(searchTerm))) {
                    show = false;
                }

                // Teacher filter
                if (selectedTeacher && teacher !== selectedTeacher) {
                    show = false;
                }

                // Day filter
                if (selectedDay && day !== selectedDay) {
                    show = false;
                }

                // Status filter
                if (selectedStatus && status !== selectedStatus) {
                    show = false;
                }

                card.style.display = show ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', filterClasses);
        sortBy.addEventListener('change', sortClasses);
        teacherFilter.addEventListener('change', filterClasses);
        dayFilter.addEventListener('change', filterClasses);
        statusFilter.addEventListener('change', filterClasses);

        function clearFilters() {
            searchInput.value = '';
            sortBy.value = 'name-asc';
            teacherFilter.value = '';
            dayFilter.value = '';
            statusFilter.value = '';
            sortClasses();
            filterClasses();
        }
    </script>
}
