@using System.IO
@using System.Text.Json
@model WebMobileAssignment.Models.LeaveApplication
@{
    ViewBag.Title = "Leave Application Details";
    ViewBag.ActiveMenu = "LeaveManagement";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    var student = ViewBag.Student as WebMobileAssignment.Models.Student;
    var documentUrls = ViewBag.DocumentUrls as List<string> ?? new List<string>();
    
    var statusBadge = Model.Status switch
    {
        "Approved" => "success",
        "Rejected" => "danger",
        "Pending" => "warning",
        _ => "secondary"
    };
    
    var statusIcon = Model.Status switch
    {
        "Approved" => "check-circle-fill",
        "Rejected" => "x-circle-fill",
        "Pending" => "hourglass-split",
        _ => "question-circle-fill"
    };
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>@TempData["SuccessMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>@TempData["ErrorMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Header Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-2">
                    <i class="bi bi-calendar-event text-danger me-2"></i>
                    Leave Application Details
                </h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="LeaveIndex">Leave Management</a></li>
                        <li class="breadcrumb-item active">@Model.LeaveId</li>
                    </ol>
                </nav>
            </div>
            <div>
                <a asp-controller="Admin" asp-action="LeaveIndex" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Column: Leave Details -->
    <div class="col-lg-8">
        <!-- Status Card -->
        <div class="card mb-4 shadow-sm border-@statusBadge">
            <div class="card-header bg-@statusBadge text-white">
                <h5 class="mb-0">
                    <i class="bi bi-@statusIcon me-2"></i>
                    Leave Status: @Model.Status
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small mb-1">Leave ID</label>
                        <div class="fw-bold">@Model.LeaveId</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small mb-1">Application Date</label>
                        <div class="fw-bold">@Model.CreatedDate.ToString("dd MMMM yyyy, hh:mm tt")</div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="text-muted small mb-1">Start Date</label>
                        <div class="fw-bold">
                            <i class="bi bi-calendar-event text-danger me-1"></i>
                            @Model.StartDate.ToString("dd MMM yyyy")
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="text-muted small mb-1">End Date</label>
                        <div class="fw-bold">
                            <i class="bi bi-calendar-event text-danger me-1"></i>
                            @Model.EndDate.ToString("dd MMM yyyy")
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="text-muted small mb-1">Total Days</label>
                        <div>
                            <span class="badge bg-info fs-6">@Model.TotalDays day(s)</span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <label class="text-muted small mb-1">Reason for Leave</label>
                        <div class="p-3 bg-light rounded">
                            @Model.Reason
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Remarks))
                {
                    <div class="row mt-3">
                        <div class="col-12">
                            <label class="text-muted small mb-1">
                                <i class="bi bi-chat-left-text me-1"></i>
                                Admin Remarks
                            </label>
                            <div class="p-3 bg-@(Model.Status == "Approved" ? "success" : "warning") bg-opacity-10 border border-@(Model.Status == "Approved" ? "success" : "warning") rounded">
                                <i class="bi bi-@(Model.Status == "Approved" ? "check-circle" : "info-circle") text-@(Model.Status == "Approved" ? "success" : "warning") me-2"></i>
                                @Model.Remarks
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Supporting Documents -->
        @if (documentUrls.Any())
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-paperclip text-danger me-2"></i>
                        Supporting Documents
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @for (int i = 0; i < documentUrls.Count; i++)
                        {
                            var docUrl = documentUrls[i];
                            var fileName = docUrl.Split('/').Last();
                            var extension = fileName.Contains('.') ? fileName.Substring(fileName.LastIndexOf('.')).ToLower() : "";
                            var isImage = extension == ".jpg" || extension == ".jpeg" || extension == ".png";
                            
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        @if (isImage)
                                        {
                                            <img src="@docUrl" class="img-fluid rounded mb-2" alt="Document @(i+1)" style="max-height: 150px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 4rem;"></i>
                                        }
                                        <div class="mt-2">
                                            <small class="text-muted d-block text-truncate" title="@fileName">
                                                @fileName
                                            </small>
                                            <a href="@docUrl" target="_blank" class="btn btn-sm btn-outline-primary mt-2">
                                                <i class="bi bi-download"></i> View/Download
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                No supporting documents uploaded.
            </div>
        }

        <!-- Action Buttons -->
        @if (Model.Status == "Pending")
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-gear text-danger me-2"></i>
                        Review Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <form asp-controller="Admin" asp-action="ApproveLeave" method="post" onsubmit="return confirm('Are you sure you want to approve this leave application?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="leaveId" value="@Model.LeaveId" />
                                <div class="mb-3">
                                    <label class="form-label">Approval Remarks (Optional)</label>
                                    <textarea name="remarks" class="form-control" rows="2" placeholder="Add any comments..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-check-circle me-1"></i> Approve Leave
                                </button>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <form asp-controller="Admin" asp-action="RejectLeave" method="post" onsubmit="return confirm('Are you sure you want to reject this leave application?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="leaveId" value="@Model.LeaveId" />
                                <div class="mb-3">
                                    <label class="form-label">Rejection Reason (Optional)</label>
                                    <textarea name="remarks" class="form-control" rows="2" placeholder="Explain why..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-warning w-100">
                                    <i class="bi bi-x-circle me-1"></i> Reject Leave
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Student Info -->
    <div class="col-lg-4">
        <!-- Student Information -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="bi bi-person-fill me-2"></i>
                    Student Information
                </h5>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    @if (!string.IsNullOrEmpty(Model.User?.ProfilePicture))
                    {
                        <img src="@Model.User.ProfilePicture" alt="@Model.User.FullName" class="rounded-circle mb-2" style="width: 100px; height: 100px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-danger text-white d-inline-flex align-items-center justify-content-center mb-2" style="width: 100px; height: 100px; font-size: 2.5rem;">
                            @Model.User?.FullName?.Substring(0, 1).ToUpper()
                        </div>
                    }
                    <h5 class="mb-0">@Model.User?.FullName</h5>
                    <p class="text-muted small">@Model.UserId</p>
                </div>

                <hr />

                <div class="mb-2">
                    <small class="text-muted">Email</small>
                    <div><i class="bi bi-envelope me-2"></i>@Model.User?.Email</div>
                </div>

                <div class="mb-2">
                    <small class="text-muted">Phone</small>
                    <div><i class="bi bi-telephone me-2"></i>@(Model.User?.PhoneNumber ?? "N/A")</div>
                </div>

                @if (student != null)
                {
                    <div class="mb-2">
                        <small class="text-muted">Gender</small>
                        <div><i class="bi bi-gender-ambiguous me-2"></i>@(student.Gender ?? "N/A")</div>
                    </div>

                    <div class="mb-2">
                        <small class="text-muted">Date of Birth</small>
                        <div><i class="bi bi-calendar me-2"></i>@(student.DateOfBirth?.ToString("dd MMM yyyy") ?? "N/A")</div>
                    </div>
                }

                <hr />

                <div class="d-grid gap-2">
                    <a asp-controller="Admin" asp-action="StudentDetails" asp-route-id="@student.StudentId" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i> View Student Profile
                    </a>
                </div>
            </div>
        </div>

        <!-- Parent Information -->
        @if (student?.Parent != null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0">
                        <i class="bi bi-people text-danger me-2"></i>
                        Parent/Guardian
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <small class="text-muted">Name</small>
                        <div class="fw-bold">@student.Parent.User?.FullName</div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted">Email</small>
                        <div><i class="bi bi-envelope me-1"></i>@student.Parent.User?.Email</div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted">Phone</small>
                        <div><i class="bi bi-telephone me-1"></i>@(student.Parent.PhoneNumber ?? "N/A")</div>
                    </div>
                </div>
            </div>
        }

        <!-- Quick Actions -->
        <div class="card mt-3 shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0">
                    <i class="bi bi-lightning text-danger me-2"></i>
                    Quick Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Admin" asp-action="LeaveIndex" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <form asp-controller="Admin" asp-action="LeaveDelete" method="post" onsubmit="return confirm('Are you sure you want to delete this leave application? This action cannot be undone.');" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.LeaveId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                            <i class="bi bi-trash"></i> Delete Application
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
