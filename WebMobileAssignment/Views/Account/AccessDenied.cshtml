@{
    ViewBag.Title = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Tuition Attendance System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
     body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
         min-height: 100vh;
      display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

  .access-denied-container {
            max-width: 500px;
            width: 100%;
            padding: 15px;
        }

        .access-denied-card {
      background: white;
            border-radius: 16px;
            padding: 35px 30px;
        text-align: center;
     box-shadow: 0 15px 45px rgba(0, 0, 0, 0.25);
     animation: slideIn 0.4s ease-out;
      }

     @@keyframes slideIn {
          from {
   opacity: 0;
  transform: translateY(-20px);
            }
     to {
                opacity: 1;
             transform: translateY(0);
         }
        }

   .error-icon {
 font-size: 70px;
     color: #dc3545;
            margin-bottom: 20px;
    animation: shake 0.5s ease-in-out;
        }

        @@keyframes shake {
      0%, 100% { transform: translateX(0); }
     25% { transform: translateX(-8px); }
    75% { transform: translateX(8px); }
     }

.error-title {
            font-size: 26px;
            font-weight: 700;
            color: #333;
            margin-bottom: 12px;
    }

        .error-message {
        font-size: 15px;
   color: #666;
  margin-bottom: 25px;
            line-height: 1.5;
        }

    .btn-primary {
     background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border: none;
   padding: 10px 30px;
          font-size: 15px;
          font-weight: 600;
            border-radius: 50px;
      transition: all 0.3s ease;
     text-decoration: none;
     display: inline-block;
         color: white;
        }

      .btn-primary:hover {
            transform: translateY(-2px);
 box-shadow: 0 8px 16px rgba(102, 126, 234, 0.4);
        }

 .btn-secondary {
            background: transparent;
    border: 2px solid #6c757d;
  color: #6c757d;
      padding: 10px 30px;
    font-size: 15px;
 font-weight: 600;
            border-radius: 50px;
            transition: all 0.3s ease;
     text-decoration: none;
     display: inline-block;
            margin-left: 8px;
}

        .btn-secondary:hover {
 background: #6c757d;
          color: white;
 transform: translateY(-2px);
}

   .info-box {
          background: #fff8e6;
            border-left: 3px solid #ffc107;
        padding: 12px 15px;
            margin: 20px 0;
text-align: left;
     border-radius: 6px;
   }

        .info-box strong {
            color: #856404;
    display: block;
          margin-bottom: 8px;
 font-size: 14px;
    }

   .info-box ul {
            margin: 0;
    padding-left: 18px;
       color: #666;
       font-size: 13px;
        }

        .info-box li {
          margin: 5px 0;
        }

        @@media (max-width: 768px) {
        .access-denied-container {
  max-width: 90%;
        }

     .access-denied-card {
      padding: 30px 20px;
      }

            .error-icon {
       font-size: 60px;
            }

      .error-title {
      font-size: 22px;
}

            .error-message {
       font-size: 14px;
       }

      .btn-primary, .btn-secondary {
                display: block;
    margin: 8px 0;
    width: 100%;
    }
   }
    </style>
</head>
<body>
    <div class="access-denied-container">
        <div class="access-denied-card">
         <div class="error-icon">
    <i class="bi bi-shield-lock-fill"></i>
  </div>

   <h1 class="error-title">Access Denied</h1>

      <p class="error-message">
         @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
         {
@ViewBag.ErrorMessage
                }
          else
 {
            <text>You do not have permission to access this page.</text>
        }
   </p>

            <div class="info-box">
      <strong><i class="bi bi-info-circle"></i> Why am I seeing this?</strong>
                <ul>
        <li>You are trying to access a page that requires specific permissions</li>
          <li>Your account type does not have access to this resource</li>
 <li>Your session may have expired or you are not logged in with the correct account</li>
                </ul>
            </div>

         <div class="mt-3">
       <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
 <i class="bi bi-box-arrow-in-right me-2"></i>Go to Login
        </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
     <i class="bi bi-house me-2"></i>Back to Home
     </a>
            </div>

      @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl))
            {
           <p class="text-muted mt-3" style="font-size: 12px;">
   <small>Attempted to access: <code>@ViewBag.ReturnUrl</code></small>
   </p>
      }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
