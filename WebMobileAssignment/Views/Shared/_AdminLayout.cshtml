<!DOCTYPE html>
<html lang="en">
@inject WebMobileAssignment.Services.LocalizationService Localization
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Admin Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Chewy&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-layout">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <i class="bi bi-calendar-check-fill"></i>
                <span>@Localization["AdminPortal"]</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <!-- Dashboard -->
            <a asp-controller="Admin" asp-action="Dashboard"
               class="sidebar-item @(ViewBag.ActiveMenu == "Dashboard" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-house-door-fill"></i>
                    <span>@Localization["Dashboard"]</span>
                </div>
            </a>

            <!-- Student Management -->
            <a asp-controller="Admin" asp-action="StudentIndex"
               class="sidebar-item @(ViewBag.ActiveMenu == "StudentManagement" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>@Localization["StudentManagement"]</span>
                </div>
            </a>

            <!-- Teacher Management -->
            <a asp-controller="Admin" asp-action="TeacherIndex"
               class="sidebar-item @(ViewBag.ActiveMenu == "TeacherManagement" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-person-workspace"></i>
                    <span>@Localization["TeacherManagement"]</span>
                </div>
            </a>

            <!-- Parent Management -->
            <a asp-controller="Admin" asp-action="ParentIndex"
               class="sidebar-item @(ViewBag.ActiveMenu == "ParentManagement" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-people-fill"></i>
                    <span>@Localization["ParentManagement"]</span>
                </div>
            </a>

            <!-- Class Scheduling Management -->
            <div class="sidebar-dropdown">
                <button class="sidebar-item dropdown-toggle @(ViewBag.ActiveMenu == "ClassManagement" ? "active" : "")"
                        type="button" data-bs-toggle="collapse" data-bs-target="#classMenu">
                    <div class="sidebar-item-content">
                        <i class="bi bi-book-fill"></i>
                        <span>@Localization["ClassManagement"]</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse @(ViewBag.ActiveMenu == "ClassManagement" ? "show" : "")" id="classMenu">
                    <a asp-controller="Admin" asp-action="ClassIndex"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "Classes" ? "active" : "")">
                        <i class="bi bi-list-check"></i>
                        <span>@Localization["ManageClasses"]</span>
                    </a>
                    <a asp-controller="Admin" asp-action="SubjectIndex"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "Subjects" ? "active" : "")">
                        <i class="bi bi-journals"></i>
                        <span>@Localization["ManageSubjects"]</span>
                    </a>
                    <a asp-controller="Admin" asp-action="ScheduleIndex"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "Schedule" ? "active" : "")">
                        <i class="bi bi-calendar-week-fill"></i>
                        <span>@Localization["ClassSchedule"]</span>
                    </a>
                </div>
            </div>

            <!-- Attendance Management -->
            <div class="sidebar-dropdown">
                <button class="sidebar-item dropdown-toggle @(ViewBag.ActiveMenu == "AttendanceManagement" ? "active" : "")"
                        type="button" data-bs-toggle="collapse" data-bs-target="#attendanceMenu">
                    <div class="sidebar-item-content">
                        <i class="bi bi-clipboard-check-fill"></i>
                        <span>@Localization["Attendance"]</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse @(ViewBag.ActiveMenu == "AttendanceManagement" ? "show" : "")" id="attendanceMenu">
                    <a asp-controller="Admin" asp-action="AttendanceTake"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "Take" ? "active" : "")">
                        <i class="bi bi-qr-code-scan"></i>
                        <span>@Localization["TakeAttendance"]</span>
                    </a>
                    <a asp-controller="Admin" asp-action="AttendanceRecords"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "Records" ? "active" : "")">
                        <i class="bi bi-journal-text"></i>
                        <span>@Localization["ViewRecords"]</span>
                    </a>
                </div>
            </div>

            <!-- Leave Management -->
            <a asp-controller="Admin" asp-action="LeaveIndex"
               class="sidebar-item @(ViewBag.ActiveMenu == "LeaveManagement" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-calendar-x"></i>
                    <span>@Localization["LeaveManagement"]</span>
                </div>
            </a>

            <!-- Notifications -->
            <a asp-controller="Admin" asp-action="Notifications"
               class="sidebar-item @(ViewBag.ActiveMenu == "Notifications" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-bell-fill"></i>
                    <span>@Localization["Notifications"]</span>
                </div>
            </a>

            <!-- Reports -->
            <a asp-controller="Admin" asp-action="Reports"
               class="sidebar-item @(ViewBag.ActiveMenu == "Reports" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                    <span>@Localization["ReportsAndAnalytics"]</span>
                </div>
            </a>

            <!-- Settings Dropdown -->
            <div class="sidebar-dropdown">
                <button class="sidebar-item dropdown-toggle @(ViewBag.ActiveMenu == "Settings" ? "active" : "")"
                        type="button" data-bs-toggle="collapse" data-bs-target="#settingsMenu">
                    <div class="sidebar-item-content">
                        <i class="bi bi-gear-fill"></i>
                        <span>@Localization["Settings"]</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse @(ViewBag.ActiveMenu == "Settings" ? "show" : "")" id="settingsMenu">
                    <a asp-controller="Admin" asp-action="Settings"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "Settings" ? "active" : "")">
                        <i class="bi bi-sliders"></i>
                        <span>@Localization["Settings"]</span>
                    </a>
                    <a asp-controller="Admin" asp-action="ChangePassword"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "ChangePassword" ? "active" : "")">
                        <i class="bi bi-key-fill"></i>
                        <span>@Localization["ChangePassword"]</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Sidebar Footer -->
        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="user-details">
                    <div class="user-name">Admin</div>
                    <div class="user-role">@Localization["Administrator"]</div>
                </div>
            </div>
            <a href="javascript:void(0);" class="logout-btn" title="@Localization["Logout"]" onclick="if(confirm('@Localization["AreYouSure"]')) window.location='/Account/Login';">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        <!-- Top Bar -->
        <div class="topbar">
            <button class="sidebar-toggle" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>
            <div class="topbar-title">
                <h1>@ViewBag.Title</h1>
            </div>
            <div class="topbar-actions">
                @await Html.PartialAsync("_LanguageSwitcher")
                <button class="topbar-btn" id="darkModeToggle" title="@Localization["ToggleDarkMode"]">
                    <i class="bi bi-moon-fill" id="darkModeIcon"></i>
                </button>
                <a href="@Url.Action("Notifications", "Admin")" class="topbar-btn" title="@Localization["Notifications"]">
                    <i class="bi bi-bell-fill"></i>
                    <span class="badge" id="notificationBadge">0</span>
                </a>
            </div>
        </div>

        <!-- Page Content -->
        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <!-- Mobile Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script>
        // Load notification count on page load
        $(document).ready(function() {
            loadNotificationCount();
            // Refresh notification count every 30 seconds
            setInterval(loadNotificationCount, 30000);
        });

        function loadNotificationCount() {
            $.ajax({
                url: '@Url.Action("GetUnreadNotificationCount", "Admin")',
                type: 'GET',
                success: function(response) {
                    if (response.success && response.count > 0) {
                        $('#notificationBadge').text(response.count).show();
                    } else {
                        $('#notificationBadge').text('0').hide();
                    }
                },
                error: function() {
                    console.log('Failed to load notification count');
                }
            });
        }

        // Auto-translate function
        function autoTranslate(targetLang) {
            if (!confirm('This will auto-generate translations for ' + targetLang + '. Continue?\n\nNote: This may take 1-2 minutes as it translates all keys one by one.')) {
                return;
            }
            
            var abortController = new AbortController();
            var timeoutId = setTimeout(() => abortController.abort(), 300000); // 5 minute timeout
            
            fetch('/Admin/AutoTranslate?targetLang=' + targetLang, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                signal: abortController.signal
            })
            .then(response => {
                console.log('Response status:', response.status);
                if (!response.ok) {
                    throw new Error('HTTP error ' + response.status + ': ' + response.statusText);
                }
                return response.json();
            })
            .then(data => {
                clearTimeout(timeoutId);
                console.log('Translation response:', data);
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Error: ' + (data.message || 'Failed to generate translations'));
                }
            })
            .catch(error => {
                clearTimeout(timeoutId);
                console.error('Auto-translate error details:', error);
                console.error('Error name:', error.name);
                console.error('Error message:', error.message);
                if (error.name === 'AbortError') {
                    alert('Translation request timed out. Please try again.');
                } else {
                    alert('Error: ' + error.message + '\n\nPlease check the browser console (F12) for more details.');
                }
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>