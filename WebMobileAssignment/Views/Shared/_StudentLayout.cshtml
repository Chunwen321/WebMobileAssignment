<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Student Portal</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/student.css" asp-append-version="true" />
    <style>
        /* Soft rounded corners for layout elements */
        .sidebar {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
            overflow: hidden;
        }

        .sidebar-footer, .sidebar-header, .sidebar-nav {
            border-radius: 0;
        }

        .user-avatar {
            border-radius: 8px;
            overflow: hidden;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .logout-btn {
            border-radius: 8px;
        }

        .dashboard-card {
            border-radius: 12px;
        }

        .topbar {
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;
        }
    </style>
</head>
<body class="student-layout">

    <!-- Sidebar -->
    <div class="sidebar">

        <div class="sidebar-header">
            <div class="sidebar-brand">
                <i class="bi bi-calendar-check-fill"></i>
                <span>Student Portal</span>
            </div>
        </div>

        <nav class="sidebar-nav">

            <!-- Dashboard -->
            <a asp-controller="Student" asp-action="StudDashboard"
               class="sidebar-item @(ViewBag.ActiveMenu == "StudDashboard" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Dashboard</span>
                </div>
            </a>

            <!-- Attendance Dropdown -->
            <div class="sidebar-dropdown">
                <button class="sidebar-item dropdown-toggle @(ViewBag.ActiveMenu == "Attendance" ? "active" : "")"
                        type="button" data-bs-toggle="collapse" data-bs-target="#attendanceMenu">
                    <div class="sidebar-item-content">
                        <i class="bi bi-calendar-event-fill"></i>
                        <span>Attendance</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </button>

                <div class="collapse @(ViewBag.ActiveMenu == "StudTakeAttendance" ? "show" : "")" id="attendanceMenu">

                    <!-- Take Attendance -->
                    <a asp-controller="Student" asp-action="StudTakeAttendance"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "Take" ? "active" : "")">
                        <i class="bi bi-clock-history"></i>
                        <span>Take Attendance</span>
                    </a>

                    <!-- View Attendance History -->
                    <a asp-controller="Student" asp-action="StudAttendanceHistory"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "StudAttendanceHistory" ? "active" : "")">
                        <i class="bi bi-bar-chart-fill"></i>
                        <span>View Attendance History</span>
                    </a>

                    <!-- Apply Medical Leave -->
                    <a asp-controller="Student" asp-action="StudApplyMedicalLeave"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "ApplyMedicalLeave" ? "active" : "")">
                        <i class="bi bi-journal-medical"></i>
                        <span>Apply Medical Leave</span>
                    </a>

                </div>
            </div>

            <!-- Classes -->
            <a asp-controller="Student" asp-action="StudClasses"
               class="sidebar-item @(ViewBag.ActiveMenu == "Classes" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-book-fill"></i>
                    <span>Classes</span>
                </div>
            </a>

            <!-- Announcements -->
            <a asp-controller="Student" asp-action="StudAnnouncements"
               class="sidebar-item @(ViewBag.ActiveMenu == "Announcements" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-megaphone-fill"></i>
                    <span>Announcements</span>
                </div>
            </a>

            <!-- Student Profile -->
            <a asp-controller="Student" asp-action="StudProfile"
               class="sidebar-item @(ViewBag.ActiveMenu == "StudProfile" ? "active" : "")">
                <div class="sidebar-item-content">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Student Profile</span>
                </div>
            </a>

            <!-- Settings Dropdown -->
            <div class="sidebar-dropdown">
                <button class="sidebar-item dropdown-toggle @(ViewBag.ActiveMenu == "Settings" ? "active" : "")"
                        type="button" data-bs-toggle="collapse" data-bs-target="#settingsMenu">
                    <div class="sidebar-item-content">
                        <i class="bi bi-gear-fill"></i>
                        <span>Settings</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </button>

                <div class="collapse @(ViewBag.ActiveMenu == "Settings" ? "show" : "")" id="settingsMenu">
                    <!-- Settings -->
                    <a asp-controller="Student" asp-action="StudSettings"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "Settings" ? "active" : "")">
                        <i class="bi bi-sliders"></i>
                        <span>Settings</span>
                    </a>

                    <!-- Change Password -->
                    <a asp-controller="Student" asp-action="StudChangePassword"
                       class="sidebar-subitem @(ViewBag.ActiveSubmenu == "ChangePassword" ? "active" : "")">
                        <i class="bi bi-wrench-adjustable"></i>
                        <span>Change Password</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Sidebar Footer -->
        <div class="sidebar-footer">
            @{
                var displayName = "Student";
                var displayRole = "Student";
                var displayProfilePicture = "/images/default-avatar.png";

                if (ViewBag.Student != null && ViewBag.Student.User != null)
                {
                    displayName = ViewBag.Student.User.FullName ?? "Student";
                    displayRole = ViewBag.Student.User.Email ?? "Student";
                    
                    if (!string.IsNullOrEmpty(ViewBag.Student.User.ProfilePicture) && 
                        !ViewBag.Student.User.ProfilePicture.StartsWith("/images/"))
                    {
                        displayProfilePicture = ViewBag.Student.User.ProfilePicture;
                    }
                }
            }
            <div class="user-info">
                <div class="user-avatar" style="background-image: url('@displayProfilePicture'); background-size: cover; background-position: center; border-radius: 50%; width: 40px; height: 40px; min-width: 40px;">
                    @if (string.IsNullOrEmpty(ViewBag.Student?.User?.ProfilePicture) || ViewBag.Student.User.ProfilePicture.StartsWith("/images/"))
                    {
                        <i class="bi bi-person-fill"></i>
                    }
                </div>
                <div class="user-details">
                    <div class="user-name">@displayName</div>
                    <div class="user-role">@displayRole</div>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Logout" class="logout-btn" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>

    </div>


    <!-- Main Content -->
    <div class="main-content">

        <!-- Top bar -->
        <div class="topbar">
            <button class="sidebar-toggle" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-title">
                <h1>@ViewBag.Title</h1>
            </div>

            <div class="topbar-actions">
                <button class="topbar-btn" id="darkModeToggle" title="Toggle Theme">
                    <i class="bi bi-moon-fill" id="darkModeIcon"></i>
                </button>
                <button class="topbar-btn" title="Notifications">
                    <i class="bi bi-bell-fill"></i>
                    <span class="badge">0</span>
                </button>
            </div>
        </div>

        <!-- Page content -->
        <div class="page-content">
            @RenderBody()
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/student.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>