@{
    ViewBag.Title = "Attendance History";
    Layout = "~/Views/Shared/_ParentLayout.cshtml";
}

@{
    var students = ViewBag.Students as List<WebMobileAssignment.Models.Student> ?? new List<WebMobileAssignment.Models.Student>();
    var allStudents = ViewBag.AllStudents as List<WebMobileAssignment.Models.Student> ?? new List<WebMobileAssignment.Models.Student>();
    var attendances = ViewBag.Attendances as List<WebMobileAssignment.Models.Attendance> ?? new List<WebMobileAssignment.Models.Attendance>();
    var classes = ViewBag.Classes as List<WebMobileAssignment.Models.Class> ?? new List<WebMobileAssignment.Models.Class>();
    var totalPresent = ViewBag.TotalPresent ?? 0;
    var totalAbsent = ViewBag.TotalAbsent ?? 0;
    var totalLate = ViewBag.TotalLate ?? 0;
    var attendanceRate = ViewBag.AttendanceRate ?? 0;
    var selectedStudentId = ViewBag.SelectedStudentId as string;
    var selectedClassId = ViewBag.SelectedClassId as string;
    var selectedMonth = ViewBag.SelectedMonth as string;
    var selectedStatus = ViewBag.SelectedStatus as string;
}

<div class="dashboard-card mb-4">
    <div class="card-header-custom">
 <h3 class="card-title">
      <i class="bi bi-clock-history"></i>
     Attendance History
        </h3>
    </div>

    <!-- Filters -->
    <form id="attendanceFilterForm" method="get" asp-controller="Parent" asp-action="AttendanceHistory">
   <div class="row g-3 mb-4">
        <!-- Child Selector (only show if parent has multiple children) -->
            @if (allStudents.Count > 1)
            {
             <div class="col-md-3">
          <label class="form-label">
      <i class="bi bi-person-fill me-1"></i>Child
           </label>
         <select name="studentId" id="studentId" class="form-select">
      <option value="">All Children</option>
        @foreach (var student in allStudents)
     {
           <option value="@student.StudentId" selected="@(student.StudentId == selectedStudentId)">
          @student.User.FullName
           </option>
    }
    </select>
       </div>
   }
            
   <div class="@(allStudents.Count > 1 ? "col-md-3" : "col-md-4")">
   <label class="form-label" style="color: var(--text-primary);">Class</label>
 <select name="classId" id="classId" class="form-select">
      <option value="">All Classes</option>
      @foreach (var classItem in classes)
   {
      <option value="@classItem.ClassId" selected="@(classItem.ClassId == selectedClassId)">
@classItem.ClassName (@(classItem.Subject?.SubjectName ?? "N/A"))
       </option>
    }
     </select>
       </div>
  <div class="@(allStudents.Count > 1 ? "col-md-3" : "col-md-4")">
       <label class="form-label" style="color: var(--text-primary);">Month</label>
 <input type="month" name="month" id="month" class="form-control" value="@selectedMonth" placeholder="All Months">
       </div>
                <div class="@(allStudents.Count > 1 ? "col-md-2" : "col-md-3")">
<label class="form-label" style="color: var(--text-primary);">Status</label>
   <select name="status" id="status" class="form-select">
<option value="">All Status</option>
           <option value="Present" selected="@(selectedStatus == "Present")">Present</option>
     <option value="Absent" selected="@(selectedStatus == "Absent")">Absent</option>
      <option value="Leave" selected="@(selectedStatus == "Leave")">Leave</option>
       </select>
    </div>
         <div class="@(allStudents.Count > 1 ? "col-md-1" : "col-md-1")">
           <label class="form-label">&nbsp;</label>
 <button type="submit" id="searchBtn" class="btn btn-primary w-100">
   <i class="bi bi-search"></i>
     </button>
          </div>
        </div>
    </form>

  <!-- Summary Cards -->
    <div id="summaryCards" class="row g-3 mb-4">
        <div class="col-md-3">
        <div class="p-3 text-center" style="background: rgba(25, 135, 84, 0.1); border-radius: 8px;">
       <i class="bi bi-check-circle-fill" style="font-size: 2rem; color: #198754;"></i>
    <h4 class="mt-2 mb-0" style="color: #198754;">@totalPresent</h4>
       <small class="text-muted">Total Present</small>
</div>
        </div>
        <div class="col-md-3">
    <div class="p-3 text-center" style="background: rgba(220, 53, 69, 0.1); border-radius: 8px;">
       <i class="bi bi-x-circle-fill" style="font-size: 2rem; color: #dc3545;"></i>
    <h4 class="mt-2 mb-0" style="color: #dc3545;">@totalAbsent</h4>
      <small class="text-muted">Total Absent</small>
       </div>
        </div>
    <div class="col-md-3">
            <div class="p-3 text-center" style="background: rgba(255, 193, 7, 0.1); border-radius: 8px;">
       <i class="bi bi-calendar-x" style="font-size: 2rem; color: #ffc107;"></i>
       <h4 class="mt-2 mb-0" style="color: #ffc107;">@totalLate</h4>
         <small class="text-muted">Total Leave</small>
     </div>
        </div>
        <div class="col-md-3">
   <div class="p-3 text-center" style="background: rgba(13, 110, 253, 0.1); border-radius: 8px;">
    <i class="bi bi-graph-up" style="font-size: 2rem; color: #0d6efd;"></i>
  <h4 class="mt-2 mb-0" style="color: #0d6efd;">@attendanceRate%</h4>
  <small class="text-muted">Attendance Rate</small>
            </div>
        </div>
    </div>

    @if (!students.Any())
    {
   <div id="noStudentsAlert" class="alert alert-info text-center">
          <i class="bi bi-info-circle me-2"></i>
       <strong>No students found.</strong> Please contact the administrator to link your children to your account.
        </div>
    }
    else if (!attendances.Any())
    {
      <div id="noRecordsAlert" class="alert alert-info text-center">
          <i class="bi bi-info-circle me-2"></i>
        <strong>No attendance records found.</strong> 
     @if (!string.IsNullOrEmpty(selectedClassId) || !string.IsNullOrEmpty(selectedMonth) || !string.IsNullOrEmpty(selectedStatus))
            {
 <span>Try adjusting the filters.</span>
  }
        else
   {
<span>Attendance records will appear here once classes are assigned and attendance is taken.</span>
            }
   </div>
    }
    else
    {
 <!-- Attendance Table -->
     <div id="attendanceTableContainer" class="table-responsive">
        <table class="table table-hover align-middle">
     <thead class="table-light">
         <tr>
            <th>Student</th>
          <th>Date</th>
     <th>Day</th>
     <th>Class</th>
           <th>Subject</th>
      <th>Time Taken</th>
   <th>Status</th>
      <th>Marked By</th>
       </tr>
          </thead>
            <tbody id="attendanceTableBody">
            @foreach (var attendance in attendances)
             {
      var statusBadgeColor = attendance.Status == "Present" ? "success" :
      (attendance.Status == "Leave" ? "warning" :
        (attendance.Status == "Absent" ? "danger" : "secondary"));
          
    <tr>
   <td>
  <i class="bi bi-person-circle me-2 text-muted"></i>
              <strong>@attendance.Student.User.FullName</strong>
       </td>
           <td>
    <i class="bi bi-calendar3 me-2 text-muted"></i>
           <strong>@attendance.Date.ToString("yyyy-MM-dd")</strong>
       </td>
     <td>@attendance.Date.ToString("dddd")</td>
    <td>@attendance.Class.ClassName</td>
       <td>@(attendance.Class.Subject?.SubjectName ?? "N/A")</td>
        <td><i class="bi bi-clock me-1"></i>@attendance.TakenOn.ToString("hh:mm tt")</td>
         <td><span class="badge bg-@statusBadgeColor">@attendance.Status</span></td>
        <td>@(attendance.MarkedByTeacher?.User?.FullName ?? "System")</td>
      </tr>
        }
                </tbody>
      </table>
        </div>

        <div id="recordLimitAlert"></div>
    }
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        // Load initial data
        loadAttendanceData();

        // Handle form submission
        $('#attendanceFilterForm').on('submit', function(e) {
            e.preventDefault();
            loadAttendanceData();
        });

        function loadAttendanceData() {
            // Show loading state
            $('#searchBtn').prop('disabled', true);
            $('#searchBtn').html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');

            // Get filter values
            const studentId = $('#studentId').val() || '';
            const classId = $('#classId').val() || '';
            const month = $('#month').val() || '';
            const status = $('#status').val() || '';

            // Make AJAX request
            $.ajax({
                url: '@Url.Action("GetAttendanceHistoryData", "Parent")',
                type: 'GET',
                data: {
                    studentId: studentId,
                    classId: classId,
                    month: month,
                    status: status
                },
                success: function(response) {
                    if (response.success) {
                        updateUI(response.data);
                    } else {
                        showError(response.message || 'Failed to load attendance data');
                    }
                },
                error: function(xhr, status, error) {
                    showError('An error occurred while loading attendance data');
                    console.error('Error:', error);
                },
                complete: function() {
                    // Reset button state
                    $('#searchBtn').prop('disabled', false);
                    $('#searchBtn').html('<i class="bi bi-search"></i>');
                }
            });
        }

        function updateUI(data) {
            // Update summary cards
            updateSummaryCards(data);

            // Update attendance table
            updateAttendanceTable(data);

            // Update alerts
            updateAlerts(data);
        }

        function updateSummaryCards(data) {
            const summaryHtml = `
                <div class="col-md-3">
                    <div class="p-3 text-center" style="background: rgba(25, 135, 84, 0.1); border-radius: 8px;">
                        <i class="bi bi-check-circle-fill" style="font-size: 2rem; color: #198754;"></i>
                        <h4 class="mt-2 mb-0" style="color: #198754;">${data.totalPresent}</h4>
                        <small class="text-muted">Total Present</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 text-center" style="background: rgba(220, 53, 69, 0.1); border-radius: 8px;">
                        <i class="bi bi-x-circle-fill" style="font-size: 2rem; color: #dc3545;"></i>
                        <h4 class="mt-2 mb-0" style="color: #dc3545;">${data.totalAbsent}</h4>
                        <small class="text-muted">Total Absent</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 text-center" style="background: rgba(255, 193, 7, 0.1); border-radius: 8px;">
                        <i class="bi bi-calendar-x" style="font-size: 2rem; color: #ffc107;"></i>
                        <h4 class="mt-2 mb-0" style="color: #ffc107;">${data.totalLate}</h4>
                        <small class="text-muted">Total Leave</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 text-center" style="background: rgba(13, 110, 253, 0.1); border-radius: 8px;">
                        <i class="bi bi-graph-up" style="font-size: 2rem; color: #0d6efd;"></i>
                        <h4 class="mt-2 mb-0" style="color: #0d6efd;">${data.attendanceRate}%</h4>
                        <small class="text-muted">Attendance Rate</small>
                    </div>
                </div>
            `;
            $('#summaryCards').html(summaryHtml);
        }

        function updateAttendanceTable(data) {
            if (!data.hasRecords) {
                return;
            }

            let tableHtml = '';
            data.attendances.forEach(function(attendance) {
                const statusBadgeColor = attendance.status === 'Present' ? 'success' :
                    (attendance.status === 'Leave' ? 'warning' :
                    (attendance.status === 'Absent' ? 'danger' : 'secondary'));

                tableHtml += `
                    <tr>
                        <td>
                            <i class="bi bi-person-circle me-2 text-muted"></i>
                            <strong>${attendance.studentName}</strong>
                        </td>
                        <td>
                            <i class="bi bi-calendar3 me-2 text-muted"></i>
                            <strong>${attendance.date}</strong>
                        </td>
                        <td>${attendance.day}</td>
                        <td>${attendance.className}</td>
                        <td>${attendance.subject}</td>
                        <td><i class="bi bi-clock me-1"></i>${attendance.timeTaken}</td>
                        <td><span class="badge bg-${statusBadgeColor}">${attendance.status}</span></td>
                        <td>${attendance.markedBy}</td>
                    </tr>
                `;
            });

            $('#attendanceTableBody').html(tableHtml);
        }

        function updateAlerts(data) {
            // Hide/show no records alert
            if (!data.hasRecords) {
                const message = data.hasFilters 
                    ? '<strong>No attendance records found.</strong> <span>Try adjusting the filters.</span>'
                    : '<strong>No attendance records found.</strong> <span>Attendance records will appear here once classes are assigned and attendance is taken.</span>';
                
                $('#noRecordsAlert').html(`
                    <i class="bi bi-info-circle me-2"></i>
                    ${message}
                `).show();
                $('#attendanceTableContainer').hide();
            } else {
                $('#noRecordsAlert').hide();
                $('#attendanceTableContainer').show();
            }

            // Show/hide record limit alert
            if (data.recordCount >= 50) {
                $('#recordLimitAlert').html(`
                    <div class="alert alert-info mt-3">
                        <i class="bi bi-info-circle me-2"></i>
                        Showing latest 50 records. Use filters to narrow down results.
                    </div>
                `);
            } else {
                $('#recordLimitAlert').html('');
            }
        }

        function showError(message) {
            $('#attendanceTableContainer').html(`
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    ${message}
                </div>
            `);
        }
    });
</script>
}

