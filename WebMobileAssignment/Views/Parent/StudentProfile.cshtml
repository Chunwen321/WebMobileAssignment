@{
    ViewBag.Title = "Child Profile";
    Layout = "~/Views/Shared/_ParentLayout.cshtml";
}

@{
var student = ViewBag.Student as WebMobileAssignment.Models.Student;
    var parent = ViewBag.Parent as WebMobileAssignment.Models.Parent;
    var allStudents = ViewBag.AllStudents as List<WebMobileAssignment.Models.Student> ?? new List<WebMobileAssignment.Models.Student>();
    var totalAttendance = ViewBag.TotalAttendance ?? 0;
    var presentCount = ViewBag.PresentCount ?? 0;
 var absentCount = ViewBag.AbsentCount ?? 0;
var leaveCount = ViewBag.LeaveCount ?? 0;
var attendanceRate = ViewBag.AttendanceRate ?? 0;
    
    // Get current student index
    var currentIndex = allStudents.FindIndex(s => s.StudentId == student?.StudentId);
    var totalChildren = allStudents.Count;
  var hasPrevious = currentIndex > 0;
  var hasNext = currentIndex < totalChildren - 1;
    var previousStudentId = hasPrevious ? allStudents[currentIndex - 1].StudentId : null;
    var nextStudentId = hasNext ? allStudents[currentIndex + 1].StudentId : null;
}

@if (student == null)
{
    <div class="alert alert-warning">
   <i class="bi bi-exclamation-triangle me-2"></i>
        No student information found. Please contact administrator.
    </div>
    return;
}

<!-- Child Navigation -->
@if (allStudents.Count > 1)
{
    <div class="mb-4">
 <div class="dashboard-card child-navigation-card">
        <div class="child-nav-container" id="childNavContainer">
     <button class="child-nav-btn child-nav-prev @(!hasPrevious ? "disabled" : "")" 
      id="btnPrevious"
      data-student-id="@previousStudentId"
           @(!hasPrevious ? "disabled" : "")
 type="button">
  <i class="bi bi-chevron-left"></i>
   <span>Previous</span>
    </button>
    
      <div class="child-info" id="childInfo">
 <div class="child-icon">
      <i class="bi bi-person-fill"></i>
   </div>
    <div class="child-details">
   <h5 class="child-name" id="childName">@student.User.FullName</h5>
     <p class="child-meta" id="childMeta">Child @(currentIndex + 1) of @totalChildren</p>
       </div>
    </div>
      
    <button class="child-nav-btn child-nav-next @(!hasNext ? "disabled" : "")" 
        id="btnNext"
      data-student-id="@nextStudentId"
    @(!hasNext ? "disabled" : "")
    type="button">
         <span>Next</span>
  <i class="bi bi-chevron-right"></i>
    </button>
         </div>
      </div>
    </div>
}

<div id="profileContent">
    @await Html.PartialAsync("_StudentProfileContent")
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center;">
    <div class="text-center">
        <div class="spinner-border text-warning" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-white mt-2">Loading...</p>
    </div>
</div>

@section Scripts {
<script>
// Student Profile AJAX Navigation
document.addEventListener('DOMContentLoaded', function() {
    const btnPrevious = document.getElementById('btnPrevious');
    const btnNext = document.getElementById('btnNext');
    const loadingOverlay = document.getElementById('loadingOverlay');

    // Initialize pagination on page load
    if (typeof initializeEnrolledClassesPagination === 'function') {
        initializeEnrolledClassesPagination();
    }

    // Handle Previous button
    if (btnPrevious) {
   btnPrevious.addEventListener('click', function(e) {
      e.preventDefault();
            e.stopPropagation();

          if (!this.disabled && !this.classList.contains('disabled')) {
         const studentId = this.getAttribute('data-student-id');
          if (studentId) {
     loadStudentProfile(studentId);
    }
      }
     });
    }

  // Handle Next button
    if (btnNext) {
 btnNext.addEventListener('click', function(e) {
            e.preventDefault();
   e.stopPropagation();
    
if (!this.disabled && !this.classList.contains('disabled')) {
       const studentId = this.getAttribute('data-student-id');
      if (studentId) {
 loadStudentProfile(studentId);
   }
  }
      });
    }

    function loadStudentProfile(studentId) {
 // Show loading overlay
  if (loadingOverlay) {
  loadingOverlay.style.display = 'flex';
        }

     // Disable buttons during loading
    if (btnPrevious) btnPrevious.disabled = true;
  if (btnNext) btnNext.disabled = true;

   fetch(`/Parent/GetStudentProfileContent?studentId=${studentId}`)
      .then(response => response.json())
     .then(data => {
       if (data.success) {
  // Update profile content
          const profileContent = document.getElementById('profileContent');
   if (profileContent) {
       profileContent.innerHTML = data.html;
    
       // Re-initialize pagination after content is loaded
 if (typeof initializeEnrolledClassesPagination === 'function') {
          initializeEnrolledClassesPagination();
             }
   }

    // Update navigation info
  const childName = document.getElementById('childName');
          if (childName) {
   childName.textContent = data.navigation.studentName;
       }

          const childMeta = document.getElementById('childMeta');
if (childMeta) {
    childMeta.textContent = `Child ${data.navigation.currentIndex} of ${data.navigation.totalChildren}`;
   }

    // Update Previous button
           if (btnPrevious) {
   if (data.navigation.hasPrevious) {
        btnPrevious.classList.remove('disabled');
    btnPrevious.disabled = false;
  btnPrevious.setAttribute('data-student-id', data.navigation.previousStudentId);
        } else {
        btnPrevious.classList.add('disabled');
    btnPrevious.disabled = true;
        btnPrevious.setAttribute('data-student-id', '');
   }
       }

  // Update Next button
   if (btnNext) {
  if (data.navigation.hasNext) {
       btnNext.classList.remove('disabled');
     btnNext.disabled = false;
     btnNext.setAttribute('data-student-id', data.navigation.nextStudentId);
   } else {
  btnNext.classList.add('disabled');
         btnNext.disabled = true;
   btnNext.setAttribute('data-student-id', '');
 }
        }

  // Update URL without reloading
     if (history.pushState) {
    const newUrl = `/Parent/StudentProfile?studentId=${studentId}`;
           history.pushState({ studentId: studentId }, '', newUrl);
   }
     } else {
           alert('Error: ' + (data.message || 'Failed to load student profile'));
       }
     })
    .catch(error => {
 console.error('Error:', error);
    alert('An error occurred while loading data. Please try again.');
        })
        .finally(() => {
          // Hide loading overlay
 if (loadingOverlay) {
        loadingOverlay.style.display = 'none';
   }

 // Re-enable buttons
    if (btnPrevious) btnPrevious.disabled = false;
    if (btnNext) btnNext.disabled = false;
      });
 }

    // Handle browser back/forward buttons
    window.addEventListener('popstate', function(event) {
        if (event.state && event.state.studentId) {
          loadStudentProfile(event.state.studentId);
     }
    });
});
</script>
}
