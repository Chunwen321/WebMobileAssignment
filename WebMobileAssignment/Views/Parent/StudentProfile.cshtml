@{
    ViewBag.Title = "Child Profile";
    Layout = "~/Views/Shared/_ParentLayout.cshtml";
}

@{
var student = ViewBag.Student as WebMobileAssignment.Models.Student;
    var parent = ViewBag.Parent as WebMobileAssignment.Models.Parent;
    var allStudents = ViewBag.AllStudents as List<WebMobileAssignment.Models.Student> ?? new List<WebMobileAssignment.Models.Student>();
    var totalAttendance = ViewBag.TotalAttendance ?? 0;
    var presentCount = ViewBag.PresentCount ?? 0;
    var absentCount = ViewBag.AbsentCount ?? 0;
var lateCount = ViewBag.LateCount ?? 0;
    var attendanceRate = ViewBag.AttendanceRate ?? 0;
    
    // Get current student index
    var currentIndex = allStudents.FindIndex(s => s.StudentId == student?.StudentId);
    var totalChildren = allStudents.Count;
    var hasPrevious = currentIndex > 0;
  var hasNext = currentIndex < totalChildren - 1;
    var previousStudentId = hasPrevious ? allStudents[currentIndex - 1].StudentId : null;
    var nextStudentId = hasNext ? allStudents[currentIndex + 1].StudentId : null;
}

@if (student == null)
{
    <div class="alert alert-warning">
   <i class="bi bi-exclamation-triangle me-2"></i>
        No student information found. Please contact administrator.
    </div>
    return;
}

<!-- Child Navigation -->
@if (allStudents.Count > 1)
{
    <div class="mb-4">
   <div class="dashboard-card child-navigation-card">
        <div class="child-nav-container" id="childNavContainer">
     <button class="child-nav-btn child-nav-prev @(!hasPrevious ? "disabled" : "")" 
      id="btnPrevious"
              data-student-id="@previousStudentId"
                @(!hasPrevious ? "disabled" : "")>
  <i class="bi bi-chevron-left"></i>
           <span>Previous</span>
    </button>
    
        <div class="child-info" id="childInfo">
 <div class="child-icon">
      <i class="bi bi-person-fill"></i>
         </div>
    <div class="child-details">
   <h5 class="child-name" id="childName">@student.User.FullName</h5>
     <p class="child-meta" id="childMeta">Child @(currentIndex + 1) of @totalChildren</p>
       </div>
    </div>
      
    <button class="child-nav-btn child-nav-next @(!hasNext ? "disabled" : "")" 
        id="btnNext"
      data-student-id="@nextStudentId"
    @(!hasNext ? "disabled" : "")>
         <span>Next</span>
         <i class="bi bi-chevron-right"></i>
    </button>
            </div>
      </div>
    </div>
}

<div id="profileContent">
    @await Html.PartialAsync("_StudentProfileContent")
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.8); z-index: 9999; justify-content: center; align-items: center;">
    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
     <span class="visually-hidden">Loading...</span>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        console.log('StudentProfile: Script loaded');
console.log('jQuery version:', $.fn.jquery);
        
        // Handle Previous button click
        $('#btnPrevious').click(function(e) {
      e.preventDefault();
       console.log('Previous button clicked');
     if (!$(this).hasClass('disabled')) {
              var studentId = $(this).data('student-id');
      console.log('Previous Student ID:', studentId);
      loadStudentProfile(studentId);
          } else {
     console.log('Previous button is disabled');
      }
        });

        // Handle Next button click
    $('#btnNext').click(function(e) {
            e.preventDefault();
       console.log('Next button clicked');
      if (!$(this).hasClass('disabled')) {
    var studentId = $(this).data('student-id');
 console.log('Next Student ID:', studentId);
                loadStudentProfile(studentId);
            } else {
         console.log('Next button is disabled');
   }
  });

        function loadStudentProfile(studentId) {
   console.log('Loading student profile for ID:', studentId);
            
     // Show loading overlay
  $('#loadingOverlay').css('display', 'flex');

            $.ajax({
      url: '@Url.Action("GetStudentProfileContent", "Parent")',
         type: 'GET',
      data: { studentId: studentId },
    success: function(response) {
        console.log('AJAX Success:', response);
      if (response.success) {
  // Update the profile content
     $('#profileContent').html(response.html);

               // Update navigation info
   $('#childName').text(response.navigation.studentName);
         $('#childMeta').text('Child ' + response.navigation.currentIndex + ' of ' + response.navigation.totalChildren);

    // Update Previous button
          if (response.navigation.hasPrevious) {
           $('#btnPrevious').removeClass('disabled').prop('disabled', false)
   .data('student-id', response.navigation.previousStudentId);
   } else {
         $('#btnPrevious').addClass('disabled').prop('disabled', true)
       .data('student-id', '');
     }

         // Update Next button
               if (response.navigation.hasNext) {
        $('#btnNext').removeClass('disabled').prop('disabled', false)
            .data('student-id', response.navigation.nextStudentId);
             } else {
     $('#btnNext').addClass('disabled').prop('disabled', true)
            .data('student-id', '');
      }

   // Update URL without reloading
         if (history.pushState) {
   var newUrl = '@Url.Action("StudentProfile", "Parent")?studentId=' + studentId;
    history.pushState({ studentId: studentId }, '', newUrl);
              }
            } else {
      console.error('Error in response:', response.message);
            alert('Error: ' + response.message);
     }
  },
          error: function(xhr, status, error) {
 console.error('AJAX Error:', error);
      console.error('Status:', status);
           console.error('Response:', xhr.responseText);
        alert('Failed to load student profile. Please try again.');
     },
          complete: function() {
       // Hide loading overlay
           $('#loadingOverlay').hide();
       }
    });
        }
    });
</script>
}
